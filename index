/* ---- Reset Data BKU: hapus SEMUA transaksi pada tahap aktif sekaligus.
   Fitur ini terpisah dari tombol "Hapus" per baris (yang tetap tersedia
   untuk menghapus satu transaksi saja) — dipakai saat ingin mengosongkan
   ulang seluruh isian tahap berjalan tanpa menghapus satu-per-satu.
   Transaksi pada tahap lain TIDAK ikut terhapus. ---- */
document.getElementById('btn-reset-bku').addEventListener('click', async ()=>{
  const tahap = state.tahapAktif || getDefaultTahap();
  const jenisDana = state.jenisDanaAktif || getDefaultJenisDana();
  if(isTahapTerkunci(tahap)){
    alertFix(`${TAHAP_PERIODE[tahap].label} sedang terkunci. Buka kunci tahap terlebih dahulu untuk mereset data.`);
    return;
  }
  const txTahapIni = state.transactions.filter(t=>bulanDalamTahap(t.tanggal, tahap) && jenisDanaTransaksi(t)===jenisDana);
  if(txTahapIni.length === 0){
    alertFix('Tidak ada transaksi pada bagian jenis dana ini untuk direset.');
    return;
  }
  const label = `${JENIS_DANA[jenisDana].label} — ${TAHAP_PERIODE[tahap].label}`;
  const konfirmasiAwal = confirmFix(`Reset seluruh data Buku Kas Umum pada ${label}?\n\nTindakan ini akan menghapus SEMUA ${txTahapIni.length} transaksi pada bagian jenis dana & periode ini sekaligus dan TIDAK DAPAT DIBATALKAN. Transaksi pada jenis dana lain dan tahap lain TIDAK akan terpengaruh.`);
  if(!konfirmasiAwal) return;
  const ketikan = await showPromptModal(
    `Untuk melanjutkan, ketik RESET (huruf besar) untuk menghapus ${txTahapIni.length} transaksi pada ${label}:`
  );
  if(ketikan !== 'RESET'){
    alertFix('Reset dibatalkan karena teks konfirmasi tidak sesuai.');
    return;
  }
  const npsn = state.userData.npsn;
  try{
    const updates = {};
    txTahapIni.forEach(t=>{ updates[t.id] = null; });
    await db.ref('transaksi_bku/'+npsn).update(updates);
    logAudit('Buku Kas Umum', 'reset', `Reset ${txTahapIni.length} transaksi pada ${label}`);
    alertFix(`Berhasil mereset ${txTahapIni.length} transaksi pada ${label}.`);
  }catch(err){
    alertFix('Gagal mereset data: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
  }
});

