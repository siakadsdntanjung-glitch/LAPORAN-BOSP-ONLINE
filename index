/* =========================================================================
   PERBAIKAN FOKUS UNTUK DIALOG NATIVE (alert/confirm)
   Di Electron, alertFix()/confirmFix() bawaan browser memicu dialog native Windows
   yang levelnya di luar halaman web. Setelah dialog itu ditutup, fokus
   keyboard kadang TIDAK otomatis kembali ke jendela aplikasi, sehingga kolom
   input di halaman terlihat aktif tapi tidak bisa diketik sampai pengguna
   mengklik sesuatu secara manual. alertFix()/confirmFix() di bawah ini
   berperilaku identik dengan alertFix()/confirmFix() bawaan (pesan & nilai
   kembalian sama persis), hanya ditambah pemulihan fokus otomatis setelah
   dialog ditutup — meniru pola yang sudah dipakai di showPromptModal().
   ========================================================================= */
function pulihkanFokusSetelahDialog(){
  window.focus();
  const cobaFokus = ()=>{
    // Kalau ada input/textarea yang sedang aktif (mis. modal lain di
    // belakangnya), fokuskan ulang elemen itu. Kalau tidak ada, cukup
    // pastikan jendela/document yang menerima fokus keyboard.
    const aktif = document.activeElement;
    if(aktif && (aktif.tagName === 'INPUT' || aktif.tagName === 'TEXTAREA')){
      aktif.focus();
    } else if(document.body){
      document.body.focus();
    }
  };
  cobaFokus();
  setTimeout(cobaFokus, 60);
  setTimeout(cobaFokus, 200);
}
function alertFix(pesan){
  const hasil = alert(pesan);
  pulihkanFokusSetelahDialog();
  return hasil;
}
function confirmFix(pesan){
  const hasil = confirm(pesan);
  pulihkanFokusSetelahDialog();
  return hasil;
}

/* =========================================================================
   VERSION GATE
   Mengunci akses jika versi aplikasi di perangkat ini lebih lama dari
   config/minVersion yang tersimpan di Firebase. Untuk "mematikan" versi
   lama yang dipakai sekolah-sekolah, cukup naikkan nilai minVersion di
   Firebase Console — tidak perlu menyentuh file di laptop sekolah.
   ========================================================================= */
const APP_VERSION = "2.2.0"; // naikkan setiap kali merilis versi baru

function compareVersion(a, b){
  const pa = String(a).split('.').map(Number);
  const pb = String(b).split('.').map(Number);
  for(let i=0;i<3;i++){
    const diff = (pa[i]||0) - (pb[i]||0);
    if(diff !== 0) return diff;
  }
  return 0;
}

function runVersionCheck(){
  return db.ref('config').once('value').then(snap=>{
    const cfg = snap.val() || {};
    const minVersion = cfg.minVersion || '0.0.0';
    if(compareVersion(APP_VERSION, minVersion) < 0){
      document.getElementById('view-update-current').textContent = APP_VERSION;
      document.getElementById('view-update-version').textContent = minVersion;

      // Kalau Admin Utama mengisi config/versionGateMessage di Firebase, tampilkan
      // teks itu menggantikan dua paragraf baku ("Versi Aplikasi Sudah Usang...").
      // Berguna untuk memakai layar blocking ini sebagai kanal pengumuman umum
      // (mis. "akun demo selesai") ke sekolah yang masih pakai versi lama —
      // bukan cuma untuk pesan update semata. Kalau field kosong, perilaku lama
      // tetap berjalan seperti biasa.
      const pesanCustom = (cfg.versionGateMessage || '').trim();
      const elCustom = document.getElementById('view-update-pesan-custom');
      const elDefault1 = document.getElementById('view-update-pesan-default');
      const elDefault2 = document.getElementById('view-update-pesan-versi');
      if(pesanCustom){
        elCustom.textContent = pesanCustom;
        elCustom.classList.remove('hidden');
        elDefault1.classList.add('hidden');
        elDefault2.classList.add('hidden');
      } else {
        elCustom.classList.add('hidden');
        elDefault1.classList.remove('hidden');
        elDefault2.classList.remove('hidden');
      }

      showView('view-update-required');
      return false;
    }
    return true;
  }).catch(err=>{
    // Jika gagal cek (mis. offline saat pertama buka), tetap izinkan pakai
    // agar aplikasi tidak terkunci total hanya karena tidak ada koneksi.
    console.warn('Gagal memeriksa versi minimum:', err);
    return true;
  });
}

// Promise yang di-resolve true/false setelah pengecekan selesai.
// onAuthStateChanged menunggu promise ini agar layar login/app tidak
// sempat tampil sebelum status versi dipastikan.
let versionCheckDone = runVersionCheck();

document.getElementById('btn-update-retry').addEventListener('click', ()=>{
  showView('view-loading');
  versionCheckDone = runVersionCheck();
  versionCheckDone.then(ok=>{ if(ok) location.reload(); });
});

/* =========================================================================
   UPDATE BANNER (non-blocking)
   Terpisah dari version gate di atas: ini hanya MEMBERI TAHU jika ada versi
   lebih baru (config/latestVersion), tanpa mengunci akses. Dipakai bersama
   config/downloadUrl untuk tombol unduh. Status "sudah ditutup" disimpan per
   versi di localStorage, supaya tidak muncul lagi sampai ada versi baru lagi.
   ========================================================================= */
function runUpdateBannerCheck(){
  return db.ref('config').once('value').then(snap=>{
    const cfg = snap.val() || {};
    const latestVersion = cfg.latestVersion || APP_VERSION;
    const downloadUrl = cfg.downloadUrl || '';

    if(compareVersion(APP_VERSION, latestVersion) >= 0) return; // sudah versi terbaru

    const dismissedKey = 'sikebos_update_dismissed_' + latestVersion;
    if(localStorage.getItem(dismissedKey) === '1') return; // sudah pernah ditutup untuk versi ini

    document.getElementById('update-banner-current').textContent = APP_VERSION;
    document.getElementById('update-banner-latest').textContent = latestVersion;
    const link = document.getElementById('update-banner-link');
    if(downloadUrl){ link.href = downloadUrl; } else { link.classList.add('hidden'); }

    document.getElementById('update-banner').classList.remove('hidden');

    document.getElementById('update-banner-dismiss').addEventListener('click', ()=>{
      localStorage.setItem(dismissedKey, '1');
      document.getElementById('update-banner').classList.add('hidden');
    }, { once:true });
  }).catch(err=>{
    // Kalau gagal (mis. offline), diamkan saja — ini cuma notifikasi, bukan hal kritis.
    console.warn('Gagal memeriksa versi terbaru:', err);
  });
}
runUpdateBannerCheck();

