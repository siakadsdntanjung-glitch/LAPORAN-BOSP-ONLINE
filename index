document.getElementById('form-register').addEventListener('submit', async (e)=>{
  e.preventDefault();
  hideAuthMsgs();
  const email = document.getElementById('reg-email').value.trim();
  const password = document.getElementById('reg-password').value;

  try{
    // Re-check right before submitting (not just on tab-open) in case someone
    // else claimed the slot in the meantime — the database rules enforce this
    // for real, this check is just to give a clear message instead of a raw error.
    const slotOpen = await isAdminUtamaSlotOpen();

    if(slotOpen){
      justRegistered = true;
      const cred = await auth.createUserWithEmailAndPassword(email, password);
      const uid = cred.user.uid;

      // Tulis ke Database dibungkus try/catch TERPISAH dari pembuatan akun
      // Auth di atas. Kalau salah satu write ini gagal (mis. Database Rules
      // menolak), akun Auth yang baru saja dibuat akan jadi "akun yatim":
      // tercatat di Firebase Authentication tapi tanpa data apapun di
      // Database. cleanupOrphanedAuthUser() menghapusnya lagi supaya email
      // tersebut langsung bisa dipakai ulang untuk mendaftar, tanpa perlu
      // dihapus manual lewat Firebase Console.
      try{
        await db.ref('users/'+uid).set({
          role: 'admin_utama',
          email: email,
          status: 'aktif',
          createdAt: Date.now()
        });
        await db.ref('meta/adminUtamaExists').set(true);
      }catch(dbErr){
        await cleanupOrphanedAuthUser(cred.user);
        justRegistered = false;
        showAuthError('Pendaftaran gagal disimpan, silakan coba lagi. (' + (dbErr.message||dbErr) + ')');
        return;
      }

      state.user = cred.user;
      state.userData = { role:'admin_utama', email, status:'aktif' };
      initAppForRole(state.userData);
      justRegistered = false;
      return;
    }

    // Normal path: register as Admin Sekolah, pending verification.
    const namaSekolah = document.getElementById('reg-nama-sekolah').value.trim();
    const npsn = document.getElementById('reg-npsn').value.trim();

    if(!/^\d{6,10}$/.test(npsn)){
      showAuthError('NPSN harus berupa angka (6–10 digit).');
      return;
    }
    if(!namaSekolah){
      showAuthError('Nama sekolah wajib diisi.');
      return;
    }

    // Pengecekan ini murni untuk pesan yang ramah — keunikan NPSN yang
    // sesungguhnya tetap dijaga oleh Database Rules saat proses tulis di
    // bawah (lihat komentar pada isAdminUtamaSlotOpen). Karena pengguna
    // BELUM login di titik ini, membaca node 'sekolah' bisa saja ditolak
    // oleh Rules (permission denied) — itu bukan berarti NPSN-nya dobel,
    // jadi jangan sampai gagal baca di sini membatalkan seluruh registrasi.
    try{
      const existing = await db.ref('sekolah/'+npsn).get();
      if(existing.exists()){
        showAuthError('NPSN ini sudah terdaftar. Hubungi Admin Utama jika ini adalah kesalahan.');
        return;
      }
    }catch(precheckErr){
      console.warn('Lewati pengecekan NPSN duplikat (gagal baca, kemungkinan izin):', precheckErr);
    }

    justRegistered = true; // pause the auth listener until our writes below are complete

    const cred = await auth.createUserWithEmailAndPassword(email, password);
    const uid = cred.user.uid;

    // Sama seperti jalur admin_utama di atas: writes ke Database dibungkus
    // try/catch sendiri. Kalau gagal (mis. NPSN ternyata sudah dikunci oleh
    // sekolah lain yang baru saja mendaftar duluan — race condition kecil
    // yang disebutkan sebelumnya), akun Auth yang terlanjur dibuat langsung
    // dihapus lagi supaya tidak jadi akun yatim dan emailnya bisa dipakai
    // ulang tanpa perlu dibersihkan manual.
    try{
      await db.ref('users/'+uid).set({
        role: 'admin_sekolah',
        npsn: npsn,
        email: email,
        status: 'pending',
        createdAt: Date.now()
      });

      await db.ref('sekolah/'+npsn).set({
        namaSekolah: namaSekolah,
        npsn: npsn,
        adminUid: uid,
        createdAt: Date.now()
      });
    }catch(dbErr){
      await cleanupOrphanedAuthUser(cred.user);
      justRegistered = false;
      showAuthError('Pendaftaran gagal disimpan, kemungkinan NPSN baru saja didaftarkan pihak lain. Silakan coba lagi. (' + (dbErr.message||dbErr) + ')');
      return;
    }

    // Data is now fully written — show the pending screen directly with the
    // values we already have in hand (no need to re-fetch, no race possible).
    state.user = cred.user;
    state.userData = { role:'admin_sekolah', npsn, email, status:'pending' };
    document.getElementById('pending-npsn').textContent = npsn;
    document.getElementById('pending-nama').textContent = namaSekolah;
    showView('view-pending');

    justRegistered = false;
  }catch(err){
    justRegistered = false;
    showAuthError(translateAuthError(err));
  }
});

/* ---- Menghapus akun Auth yang "yatim": berhasil dibuat di Firebase
   Authentication tapi gagal ditulis ke Realtime Database. Tanpa ini, email
   tersebut akan terus dianggap "sudah terdaftar" oleh Firebase Auth padahal
   tidak ada data sekolah/user sama sekali yang tersimpan untuknya. ---- */
async function cleanupOrphanedAuthUser(user){
  try{
    await user.delete();
  }catch(cleanupErr){
    // Kalau penghapusan otomatis ini sendiri gagal (jarang terjadi, mis.
    // sesi re-auth kedaluwarsa), akun yatimnya tetap ada dan perlu dihapus
    // manual lewat Firebase Console > Authentication > Users, seperti yang
    // sebelumnya dilakukan secara manual.
    console.error('Gagal menghapus akun Auth yatim secara otomatis. Hapus manual di Firebase Console > Authentication:', cleanupErr);
  }
}

function translateAuthError(err){
  const map = {
    'auth/email-already-in-use':'Email sudah terdaftar.',
    'auth/invalid-email':'Format email tidak valid.',
    'auth/weak-password':'Kata sandi minimal 6 karakter.',
    'auth/user-not-found':'Email atau kata sandi salah.',
    'auth/wrong-password':'Email atau kata sandi salah.',
    'auth/invalid-credential':'Email atau kata sandi salah.',
    'auth/too-many-requests':'Terlalu banyak percobaan. Coba lagi nanti.'
  };
  return map[err.code] || ('Terjadi kesalahan: ' + err.message);
}

