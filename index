  function namaSudahAda(){
    return new Set(Array.from(document.querySelectorAll(cfg.rowsSel))
      .map(r=>r.querySelector(cfg.namaSel).value.trim().toLowerCase()).filter(Boolean));
  }
  function render(){
    if(el('panel').classList.contains('hidden')) return;
    const wrap = el('list');
    const semua = getPegawaiList();
    if(!semua.length){
      wrap.innerHTML = `<p class="p-3 text-[11px] text-navy-300">Belum ada Data Pegawai. Isi dulu lewat menu <b>Data Pegawai</b>, atau ketik manual pada baris di bawah.</p>`;
