<style>
  :root{ color-scheme: light; }
  html,body{ font-family:'Inter',system-ui,sans-serif; background:#FAF8F2; }
  .font-serif{ font-family:'Lora',Georgia,serif; }
  .font-mono{ font-family:'JetBrains Mono',ui-monospace,monospace; }

  /* Ledger ruling: faint horizontal rules behind the BKU table, like real ruled paper */
  .ledger-bg{
    background-image: repeating-linear-gradient(to bottom, transparent, transparent 43px, rgba(0,0,0,0.14) 43px, rgba(0,0,0,0.14) 44px);
  }

  /* ---- BKU (Buku Kas Umum) table: solid black grid lines + typography tuned to the
     header (uppercase sans) and body (mono) fonts actually used in this table.
     Scoped to #page-bku only — no other table in the app is affected. ---- */
  #page-bku table.border-collapse{
    border-collapse: collapse;
  }
  #page-bku table.border-collapse th,
  #page-bku table.border-collapse td{
    border: 1px solid #000;
  }
  #page-bku table.border-collapse thead th{
    white-space: nowrap;
    padding: .65rem .85rem;
    letter-spacing: .02em;
    font-family: 'Inter', system-ui, sans-serif;
  }
  #page-bku #tbl-bku td{
    padding: .6rem .85rem;
    line-height: 1.55;
    vertical-align: top;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  #page-bku #tbl-bku td.font-sans{
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.45;
  }
  #page-bku #tbl-bku tr:nth-child(even){
    background: rgba(22,50,79,0.025);
  }
  .seal{
    position:relative;
    display:inline-flex; align-items:center; justify-content:center;
    width:2.75rem; height:2.75rem; border-radius:9999px;
    border:2px solid currentColor;
  }
  .seal::before{
    content:''; position:absolute; inset:3px; border-radius:9999px;
    border:1px dashed currentColor; opacity:.55;
  }
  .brand-logo{ display:block; object-fit:contain; background:#fff; border-radius:6px; }
  ::-webkit-scrollbar{ width:8px; height:8px; }
  ::-webkit-scrollbar-thumb{ background:#CBDBE7; border-radius:8px; }

  .view{ display:none; }
  .view.active{ display:block; }

  /* Simple spinner for the loading gate */
  .spinner{
    width:2.5rem; height:2.5rem; border-radius:9999px;
    border:3px solid #CBDBE7; border-top-color:#16324F;
    animation: spin .8s linear infinite;
  }
  @keyframes spin{ to{ transform:rotate(360deg); } }
  [data-nav].active-nav{ background:rgba(255,255,255,0.08); border-left-color:#C8963E; }

  input:focus, select:focus, textarea:focus, button:focus-visible{
    outline: 2px solid #C8963E; outline-offset: 1px;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:.001ms !important; transition-duration:.001ms !important; }
  }

  /* ---- Print isolation: only #print-root is visible when printing ---- */
  #print-root{ display:none; }
  /* Pemilih jenis dokumen cetak kini berupa dropdown; deretan tombol tab disembunyikan */
  #cetak-tabs .cetak-tab{ display:none; }
  #cetak-tabs:not(:has(#cetak-gabung-wrap:not(.hidden))){ display:none; }
  @media print{
    body *{ visibility:hidden; }
    #print-root, #print-root *{ visibility:visible; }
    #print-root{ display:block !important; position:absolute; inset:0; margin:0; padding:0; }
    .no-print{ display:none !important; }
    /* Judul kolom tabel otomatis diulang di setiap halaman lanjutan; baris tidak
       terpotong di pergantian halaman; baris TOTAL (tfoot) hanya muncul di akhir. */
    #print-root thead{ display:table-header-group; }
    #print-root tfoot{ display:table-row-group; }
    #print-root tr{ page-break-inside:avoid; break-inside:avoid; }
  }
</style>
</head>
<body class="text-ink antialiased">

<!-- ========================= UPDATE BANNER =========================
     Notifikasi non-blocking: muncul jika APP_VERSION < config/latestVersion
     di Firebase. Berbeda dari version gate di bawah — ini hanya memberi
     tahu, tidak mengunci akses. Sekolah yang belum update tetap bisa
     bekerja seperti biasa. ========================= -->
<div id="update-banner" class="hidden relative z-50 bg-gold-500 text-white">
  <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-between gap-3 text-sm">
    <div class="flex items-center gap-2 min-w-0">
      <span class="font-serif font-semibold whitespace-nowrap">Versi baru tersedia</span>
      <span class="hidden sm:inline text-white/85 truncate">
        SIKEBOS <span id="update-banner-latest" class="font-mono"></span> sudah dapat diunduh
        (versi Anda saat ini: <span id="update-banner-current" class="font-mono"></span>).
      </span>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <a id="update-banner-link" href="#" target="_blank" rel="noopener"
         class="px-3 py-1 rounded-md bg-white text-navy text-xs font-semibold hover:bg-navy-50 transition">
        Unduh Sekarang
      </a>
      <button id="update-banner-dismiss" aria-label="Tutup notifikasi"
              class="px-2 py-1 rounded-md text-white/85 hover:bg-white/10 transition text-xs">
        ✕
      </button>
    </div>
  </div>
</div>

<!-- ========================= LOADING GATE =========================
     Aktif secara default agar tidak ada layar (login/pending/app) yang
     sempat tampil sebelum status login & verifikasi dipastikan. ========= -->
<div id="view-loading" class="view active min-h-screen flex items-center justify-center p-4">
  <div class="spinner"></div>
</div>

<!-- ========================= VERSION GATE =========================
     Ditampilkan jika APP_VERSION di bawah minVersion yang tersimpan di
     Firebase (config/minVersion). Menggantikan seluruh layar lain dan
     memblokir akses hingga aplikasi diperbarui.
     Pesan bisa dikustomisasi lewat config/versionGateMessage — kalau field
     itu diisi, teksnya dipakai menggantikan paragraf baku di bawah (mis.
     untuk mengumumkan hal lain, bukan cuma "versi usang"). Kalau kosong,
     paragraf baku tetap tampil seperti biasa. ========================= -->
<div id="view-update-required" class="view min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md text-center bg-white border border-navy-100 rounded-xl shadow-sm p-8">
    <div class="seal text-gold mx-auto mb-4">
      <span class="font-serif text-xl">!</span>
    </div>
    <h2 class="font-serif text-xl font-semibold text-navy mb-2">Versi Aplikasi Sudah Usang</h2>
    <p class="text-sm text-ink/70 mb-1" id="view-update-pesan-default">
      Aplikasi SIKEBOS di perangkat ini (versi <span id="view-update-current" class="font-mono"></span>)
      sudah tidak didukung lagi.
    </p>
    <p class="text-sm text-ink/70 mb-6" id="view-update-pesan-versi">
      Versi minimum yang diizinkan saat ini: <span id="view-update-version" class="font-mono font-semibold text-navy"></span>.
      Silakan unduh dan instal versi terbaru dari admin sekolah/dinas sebelum melanjutkan.
    </p>
    <p class="hidden text-sm text-ink/70 mb-6 whitespace-pre-line" id="view-update-pesan-custom"></p>
    <button id="btn-update-retry" class="w-full py-2.5 rounded-lg bg-navy text-white text-sm font-medium hover:bg-navy-600 transition">
      Sudah Update? Coba Lagi
    </button>
  </div>
</div>

<!-- ========================= AUTH SCREENS ========================= -->
<div id="view-auth" class="view min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <img src="data:image/jpeg;base64," alt="Logo Dana BOSP" class="brand-logo w-16 h-16 mx-auto mb-3">
      <h1 class="font-serif text-2xl font-semibold text-navy">SIKEBOS</h1>
      <p class="text-sm text-navy-400 mt-1">Sistem Keuangan BOSP Lintas Sekolah</p>
    </div>

    <div class="bg-white border border-navy-100 rounded-lg shadow-sm p-6">
      <!-- Tabs -->
      <div class="flex mb-6 border-b border-navy-100 no-print" id="auth-tabs">
        <button data-tab="login" class="auth-tab flex-1 pb-3 text-sm font-semibold border-b-2 border-navy text-navy">Masuk</button>
        <button data-tab="register" class="auth-tab flex-1 pb-3 text-sm font-semibold border-b-2 border-transparent text-navy-300">Daftar Sekolah</button>
      </div>

      <p id="auth-error" class="hidden text-sm text-rust bg-rust-100 rounded px-3 py-2 mb-4"></p>
      <p id="auth-info" class="hidden text-sm text-forest bg-forest-100 rounded px-3 py-2 mb-4"></p>

      <!-- LOGIN -->
      <form id="form-login" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-navy-400 mb-1">Email</label>
          <input required type="email" id="login-email" class="w-full rounded border border-navy-100 px-3 py-2 text-sm" placeholder="nama@sekolah.sch.id">
        </div>
        <div>
          <label class="block text-xs font-semibold text-navy-400 mb-1">Kata Sandi</label>
          <input required type="password" id="login-password" class="w-full rounded border border-navy-100 px-3 py-2 text-sm" placeholder="••••••••">
        </div>
        <button type="submit" class="w-full bg-navy hover:bg-navy-600 text-white text-sm font-semibold rounded py-2.5 transition-colors">Masuk</button>
        <button type="button" id="btn-lupa-password" class="w-full text-center text-xs font-semibold text-navy-400 hover:text-navy underline">Lupa kata sandi?</button>
      </form>

      <!-- REGISTER (Admin Sekolah, atau Admin Utama jika pendaftar pertama) -->
      <form id="form-register" class="space-y-4 hidden">
        <p id="reg-first-admin-banner" class="hidden text-sm text-gold-600 bg-gold-50 rounded px-3 py-2">
          Anda adalah pendaftar pertama sistem ini — akun Anda akan otomatis dijadikan <b>Admin Utama</b> dan langsung aktif.
        </p>
        <div id="reg-school-fields" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-navy-400 mb-1">Nama Sekolah</label>
            <input id="reg-nama-sekolah" class="w-full rounded border border-navy-100 px-3 py-2 text-sm" placeholder="SD Negeri 1 Contoh">
          </div>
          <div>
            <label class="block text-xs font-semibold text-navy-400 mb-1">NPSN</label>
            <input id="reg-npsn" maxlength="8" class="w-full rounded border border-navy-100 px-3 py-2 text-sm font-mono" placeholder="8 digit NPSN">
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-navy-400 mb-1">Email</label>
          <input required type="email" id="reg-email" class="w-full rounded border border-navy-100 px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-navy-400 mb-1">Kata Sandi</label>
          <input required type="password" minlength="6" id="reg-password" class="w-full rounded border border-navy-100 px-3 py-2 text-sm">
        </div>
        <button type="submit" id="btn-submit-register" class="w-full bg-navy hover:bg-navy-600 text-white text-sm font-semibold rounded py-2.5 transition-colors">Daftar</button>
      </form>
    </div>
  </div>
</div>

<!-- ========================= PENDING VERIFICATION ========================= -->
<div id="view-pending" class="view min-h-screen flex items-center justify-center p-4">
  <div class="max-w-md w-full bg-white border border-gold-200 rounded-lg shadow-sm p-8 text-center">
    <div class="seal text-gold mx-auto mb-4"><span class="font-serif text-2xl">⏳</span></div>
    <h2 class="font-serif text-xl font-semibold text-navy mb-2">Akun Anda dalam Antrean Verifikasi</h2>
    <p class="text-sm text-navy-400 leading-relaxed mb-4">
      Silakan hubungi Admin Utama (<span class="font-semibold text-navy">Gordi, No. Telp: 085183859997</span>)
      dengan melampirkan NPSN dan Nama Sekolah Anda untuk mempercepat proses aktivasi.
    </p>
    <div class="text-left bg-paper rounded border border-navy-100 p-4 text-sm mb-6 font-mono">
      <div>NPSN: <span id="pending-npsn" class="font-semibold"></span></div>
      <div>Sekolah: <span id="pending-nama" class="font-semibold"></span></div>
    </div>
    <button id="btn-logout-pending" class="text-sm font-semibold text-navy-400 hover:text-navy underline">Keluar</button>
  </div>
</div>

<!-- ========================= AKSES DIKUNCI (Admin Sekolah) =========================
     Ditampilkan menggantikan seluruh menu/App Shell ketika Admin Utama mengunci akses
     sekolah (mis. akun demo/trial berakhir & belum dibayar). Disimpan pada
     /sekolah/{npsn}/aksesDikunci di Firebase sehingga berlaku real-time di semua
     sesi/perangkat Admin Sekolah bersangkutan. Kepala Sekolah TIDAK terpengaruh oleh
     kunci ini — kunci hanya berlaku untuk role admin_sekolah. ========================= -->
<div id="view-akses-terkunci" class="view min-h-screen flex items-center justify-center p-4">
  <div class="max-w-md w-full bg-white border border-rust/30 rounded-lg shadow-sm p-8 text-center">
    <div class="seal text-rust mx-auto mb-4"><span class="font-serif text-2xl">🔒</span></div>
    <h2 class="font-serif text-xl font-semibold text-navy mb-2">Akses Sekolah Anda Dikunci</h2>
    <p id="akses-terkunci-pesan" class="text-sm text-navy-400 leading-relaxed mb-4 whitespace-pre-line"></p>
    <div class="text-left bg-paper rounded border border-navy-100 p-4 text-sm mb-6 font-mono">
      <div>NPSN: <span id="akses-terkunci-npsn" class="font-semibold"></span></div>
      <div>Sekolah: <span id="akses-terkunci-nama" class="font-semibold"></span></div>
    </div>
    <p class="text-xs text-navy-300 mb-6">
      Hubungi Admin Utama (<span class="font-semibold text-navy">Gordi, No. Telp: 085183859997</span>)
      untuk membuka kembali akses ini.
    </p>
    <button id="btn-logout-akses-terkunci" class="text-sm font-semibold text-navy-400 hover:text-navy underline">Keluar</button>
  </div>
</div>

<!-- ========================= SERVER SEDANG PERBAIKAN =========================
     Ditampilkan menggantikan seluruh App Shell untuk SEMUA pengguna (Admin
     Sekolah & Kepala Sekolah — baik lewat aplikasi desktop maupun website,
     karena keduanya memuat index.html yang sama) ketika Admin Utama mengaktifkan
     Mode Perbaikan Server dari menu "Mode Perbaikan Server". Disimpan di
     config/maintenanceMode (realtime, Firebase) sehingga langsung berlaku di
     semua sesi/perangkat tanpa perlu logout/login ulang. Admin Utama TIDAK
     terkena layar ini, supaya tetap bisa masuk & menonaktifkan Mode Perbaikan
     kembali dari dalam aplikasi. ========================= -->
<div id="view-maintenance" class="view min-h-screen flex items-center justify-center p-4">
  <div class="max-w-md w-full bg-white border border-gold-300 rounded-lg shadow-sm p-8 text-center">
    <div class="seal text-gold mx-auto mb-4"><span class="font-serif text-2xl">🛠️</span></div>
    <h2 class="font-serif text-xl font-semibold text-navy mb-2">Server Sedang Dalam Perbaikan</h2>
    <p id="maintenance-pesan" class="text-sm text-navy-400 leading-relaxed mb-6 whitespace-pre-line">
      SIKEBOS sedang dalam perbaikan/pemeliharaan sementara. Mohon coba kembali beberapa saat lagi.
    </p>
    <button id="btn-logout-maintenance" class="text-sm font-semibold text-navy-400 hover:text-navy underline">Keluar</button>
  </div>
</div>

<!-- ========================= APP SHELL ========================= -->
<div id="view-app" class="view min-h-screen">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="w-64 bg-navy text-white flex-col hidden lg:flex no-print">
      <div class="px-5 py-6 border-b border-white/10">
        <div class="flex items-center gap-3">
          <img src="data:image/jpeg;base64," alt="Logo Dana BOSP" class="brand-logo w-11 h-11 shrink-0">
          <div>
            <div class="font-serif font-semibold leading-tight">SIKEBOS</div>
            <div class="text-[11px] text-navy-200" id="sidebar-role-label">—</div>
          </div>
        </div>
      </div>
      <nav id="sidebar-nav" class="py-4 space-y-1 overflow-y-auto"></nav>
      <div class="p-4 border-t border-white/10 mt-4">
        <a id="sidebar-panduan-link" href="#" target="_blank" rel="noopener"
           class="hidden items-center gap-2 text-xs font-semibold text-white/85 hover:text-white mb-3">
          📘 Buku Panduan
        </a>
        <div class="text-xs text-navy-200 mb-2 truncate" id="sidebar-school-name">—</div>
        <button id="btn-logout" class="text-xs font-semibold text-gold hover:text-gold-200">Keluar</button>
      </div>
    </aside>

    <!-- Mobile top bar -->
    <div class="lg:hidden fixed top-0 inset-x-0 bg-navy text-white z-40 flex items-center justify-between px-4 py-3 no-print">
      <div class="flex items-center gap-2">
        <img src="data:image/jpeg;base64," alt="Logo Dana BOSP" class="brand-logo w-8 h-8 shrink-0">
        <span class="font-serif font-semibold">SIKEBOS</span>
      </div>
      <button id="btn-mobile-menu" class="text-sm font-semibold border border-white/30 rounded px-3 py-1.5">Menu</button>
    </div>
    <div id="mobile-nav" class="hidden lg:hidden fixed inset-0 z-30 bg-navy text-white pt-16 px-4 no-print">
      <nav id="mobile-nav-list" class="space-y-1"></nav>
      <a id="mobile-panduan-link" href="#" target="_blank" rel="noopener"
         class="hidden items-center gap-2 mt-4 text-sm font-semibold text-white/85 hover:text-white">
        📘 Buku Panduan
      </a>
      <button id="btn-logout-mobile" class="mt-6 text-sm font-semibold text-gold">Keluar</button>
    </div>

    <!-- Main content -->
    <main class="flex-1 pt-16 lg:pt-0 min-w-0">
      <header class="bg-white border-b border-navy-100 px-6 py-4 hidden lg:flex items-center justify-between no-print">
        <h1 id="page-title" class="font-serif text-xl font-semibold text-navy">Dashboard</h1>
        <div class="text-sm text-navy-400" id="header-user"></div>
      </header>
      <!-- ========================= NOTIFIKASI AKUN BANNER =========================
           Notifikasi terarah dari Admin Utama ke Admin Sekolah tertentu (mis. info
           akun demo berakhir, perlu pembayaran trial). Disimpan di /notifikasi/{npsn}
           di Firebase dan tampil di sini sampai ditandai sudah dibaca. Hanya
           ditampilkan untuk role admin_sekolah. ========================= -->
      <div id="akun-notif-banner" class="hidden bg-rust text-white no-print">
        <div class="px-4 sm:px-6 py-3 flex items-start justify-between gap-3 text-sm">
          <div class="flex items-start gap-2 min-w-0">
            <span class="font-serif font-semibold whitespace-nowrap">Pemberitahuan</span>
            <span id="akun-notif-banner-text" class="text-white/90 whitespace-pre-line"></span>
          </div>
          <button id="akun-notif-banner-dismiss" aria-label="Tutup notifikasi"
