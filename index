/* ---- Alternatif cetak Kwitansi: gabungkan beberapa transaksi yang memiliki
   No. Bukti sama menjadi satu kwitansi (satu lembar). Kwitansi gabungan HANYA
   memuat uraian umum (mis. "Belanja ATK") dan total uangnya saja — rincian
   barang per baris transaksi (Buku, Balpoint, Kertas HVS, dst.) TIDAK dimuat
   di kwitansi. Transaksi tanpa No. Bukti tetap dicetak terpisah apa adanya
   (tidak ikut digabung dengan transaksi lain). ---- */

// Mencari kata/frasa awal yang sama pada seluruh uraian dalam satu grup, mis.
// "Belanja ATK - Buku" & "Belanja ATK - Spidol" -> "Belanja ATK", untuk dipakai
// sebagai usulan uraian umum kwitansi gabungan.
function deriveUraianUmum(group){
  const uraians = group.map(t=>String(t.uraian||'').trim()).filter(Boolean);
  if(!uraians.length) return '';
  if(uraians.length === 1) return uraians[0];
  let prefix = uraians[0];
  for(let i=1; i<uraians.length && prefix; i++){
    const b = uraians[i];
    let j = 0;
    while(j < prefix.length && j < b.length && prefix[j].toLowerCase() === b[j].toLowerCase()) j++;
    prefix = prefix.slice(0, j);
  }
  prefix = prefix.replace(/[\s\-:,(–]+$/,'').trim();
  return prefix || uraians[0];
}

// Pengganti window.prompt() (tidak didukung Electron) — menampilkan modal
// HTML dan mengembalikan Promise yang resolve dengan teks yang diketik user,
// atau null jika dibatalkan (klik Batal/Esc), sama seperti perilaku prompt().
function showPromptModal(message, defaultValue){
  return new Promise(resolve=>{
    const modal = document.getElementById('prompt-modal');
    const msgEl = document.getElementById('prompt-modal-message');
    const inputEl = document.getElementById('prompt-modal-input');
    const okBtn = document.getElementById('prompt-modal-ok');
    const cancelBtn = document.getElementById('prompt-modal-cancel');

    msgEl.textContent = message;
    inputEl.value = defaultValue || '';
    modal.classList.remove('hidden');

    // Ambil fokus jendela lebih dulu, lalu coba fokuskan kotak input beberapa
    // kali dengan jeda singkat. Ini diperlukan karena bila modal dipanggil
    // tepat setelah dialog native (confirmFix()/alertFix()) ditutup, jendela Electron
    // kadang belum benar-benar mengembalikan fokus keyboard ke halaman pada
    // saat itu juga, sehingga panggilan focus() tunggal bisa gagal "diam-diam"
    // (kotak terlihat tapi ketikan tidak masuk).
    window.focus();
    const cobaFokus = ()=>{ inputEl.focus(); inputEl.select(); };
    cobaFokus();
    setTimeout(cobaFokus, 60);
    setTimeout(cobaFokus, 200);
    // Jaring pengaman tambahan: klik di mana saja pada modal akan
    // memastikan fokus jatuh ke kotak input.
    modal.addEventListener('mousedown', cobaFokus);

    function cleanup(result){
      modal.classList.add('hidden');
      modal.removeEventListener('mousedown', cobaFokus);
      okBtn.removeEventListener('click', onOk);
      cancelBtn.removeEventListener('click', onCancel);
      inputEl.removeEventListener('keydown', onKeydown);
      resolve(result);
    }
    function onOk(){ cleanup(inputEl.value); }
    function onCancel(){ cleanup(null); }
    function onKeydown(e){
      if(e.key === 'Enter'){ e.preventDefault(); onOk(); }
      else if(e.key === 'Escape'){ e.preventDefault(); onCancel(); }
    }
    okBtn.addEventListener('click', onOk);
    cancelBtn.addEventListener('click', onCancel);
    inputEl.addEventListener('keydown', onKeydown);
  });
}

// Menormalkan teks No. Bukti sebelum dipakai sebagai kunci pencocokan/pengelompokan,
// supaya perbedaan kecil yang lumrah terjadi saat mengetik manual — huruf besar/kecil,
// atau spasi ganda di tengah teks — TIDAK dianggap sebagai No. Bukti yang berbeda.
// Spasi di awal/akhir juga dirapikan. Nilai ASLI (t.noBukti) tetap dipakai apa adanya
// untuk ditampilkan di kwitansi — normalisasi ini hanya untuk pencocokan, bukan tampilan.
function normalisasiNoBukti(v){
  return String(v||'').trim().replace(/\s+/g,' ').toLowerCase();
}

async function gabungkanTransaksiByNoBukti(items, mintaUraianUmum){
  const groups = {};
  const order = [];
  items.forEach(t=>{
    const noBuktiKey = normalisasiNoBukti(t.noBukti);
    const key = noBuktiKey ? `bukti:${noBuktiKey}` : `id:${t.id}`;
    if(!groups[key]){ groups[key] = []; order.push(key); }
    groups[key].push(t);
  });
  const hasil = [];
  // Diproses satu per satu (bukan .map) supaya modal "uraian umum" tampil
  // berurutan per grup, tidak semua sekaligus tumpang tindih.
  for(const key of order){
    const group = groups[key];
    if(group.length === 1){ hasil.push(group[0]); continue; }
    const totalJumlah = group.reduce((sum,t)=>sum+(Number(t.jumlah)||0), 0);
    const namaPenerima = [...new Set(group.map(t=>t.penerima).filter(Boolean))];
    const nipPenerima = [...new Set(group.map(t=>t.nipPenerima).filter(Boolean))];
    const tanggalTerbaru = group.reduce((latest,t)=> (!latest || (t.tanggal && t.tanggal > latest)) ? t.tanggal : latest, null);
    const uraianOtomatis = deriveUraianUmum(group);
    const uraianUmum = (typeof mintaUraianUmum === 'function')
      ? await mintaUraianUmum(group[0].noBukti, uraianOtomatis, group)
      : uraianOtomatis;
    hasil.push({
      ...group[0],
      jumlah: totalJumlah,
      tanggal: tanggalTerbaru || group[0].tanggal,
      uraian: uraianUmum,
      penerima: namaPenerima.length <= 1 ? (namaPenerima[0]||group[0].penerima) : namaPenerima.join(', '),
      nipPenerima: nipPenerima.length <= 1 ? (nipPenerima[0]||group[0].nipPenerima) : '',
      _jumlahTransaksiGabungan: group.length
    });
  }
  return hasil;
}

