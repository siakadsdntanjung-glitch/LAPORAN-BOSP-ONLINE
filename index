        <tfoot><tr>
          <td colspan="3" style="border:1px solid #16324F; padding:4px 5px; text-align:right; font-weight:700;">TOTAL</td>
          <td style="border:1px solid #16324F; padding:4px 5px; text-align:right; font-weight:700;">${fmtRupiah(totalPenerimaan)}</td>
          <td style="border:1px solid #16324F; padding:4px 5px; text-align:right; font-weight:700;">${fmtRupiah(totalPengeluaran)}</td>
