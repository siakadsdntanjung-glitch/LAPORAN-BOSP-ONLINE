    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(opnameRows.length?opnameRows:[{Keterangan:'Belum ada data'}]), 'Pemeriksaan Kas');

    const rekonRows = state.rekeningKoran.map(t=>({
      Tanggal: t.tanggal||'', Uraian: t.uraian||'',
      Jenis: t.jenis==='masuk' ? 'Kredit/Masuk' : 'Debit/Keluar', 'Jumlah (Rp)': t.jumlah||0,
      'Saldo Rekening Koran': t._saldoKoran||0, Status: t.cocokBankId? 'Cocok' : 'Belum'
    }));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rekonRows.length?rekonRows:[{Keterangan:'Belum ada data'}]), 'Rekonsiliasi Bank');

    const realisasiPerKegiatanXlsx = hitungRealisasiPerKegiatan();
    const rkasRows = state.rkas.map(r=>{
      const real = realisasiPerKegiatanXlsx[r.kodeKegiatan] || { total:0 };
      const pagu = Number(r.paguAnggaran)||0;
      return {
        'Kode Kegiatan': r.kodeKegiatan||'', 'Nama Kegiatan': r.namaKegiatan||'',
        'Pagu RKAS (Rp)': pagu, 'Realisasi (Rp)': real.total, 'Sisa (Rp)': pagu-real.total,
        '% Serapan': pagu>0 ? Math.round((real.total/pagu)*100) : 0
      };
    });
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rkasRows.length?rkasRows:[{Keterangan:'Belum ada data'}]), 'RKAS vs Realisasi');

    XLSX.writeFile(wb, `backup-sikebos-${npsn}-${todayStr()}.xlsx`);
  }catch(err){
    alertFix('Gagal membuat backup Excel: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
  }
});

