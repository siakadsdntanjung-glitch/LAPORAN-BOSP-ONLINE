/* ---- Terbilang (angka ke kata) untuk nominal Rupiah ---- */
function terbilang(n){
  n = Math.floor(Math.abs(Number(n)||0));
  const satuan = ['','Satu','Dua','Tiga','Empat','Lima','Enam','Tujuh','Delapan','Sembilan','Sepuluh',
    'Sebelas','Dua Belas','Tiga Belas','Empat Belas','Lima Belas','Enam Belas','Tujuh Belas','Delapan Belas','Sembilan Belas'];
  function angkaKeKata(x){
    x = Math.floor(x);
    if(x < 20) return satuan[x];
    if(x < 100) return (satuan[Math.floor(x/10)]+' Puluh'+(x%10? ' '+satuan[x%10]:'')).trim();
    if(x < 200) return ('Seratus'+(x%100? ' '+angkaKeKata(x%100):'')).trim();
    if(x < 1000) return (satuan[Math.floor(x/100)]+' Ratus'+(x%100? ' '+angkaKeKata(x%100):'')).trim();
    if(x < 2000) return ('Seribu'+(x%1000? ' '+angkaKeKata(x%1000):'')).trim();
    if(x < 1000000) return (angkaKeKata(Math.floor(x/1000))+' Ribu'+(x%1000? ' '+angkaKeKata(x%1000):'')).trim();
    if(x < 1000000000) return (angkaKeKata(Math.floor(x/1000000))+' Juta'+(x%1000000? ' '+angkaKeKata(x%1000000):'')).trim();
    if(x < 1000000000000) return (angkaKeKata(Math.floor(x/1000000000))+' Miliar'+(x%1000000000? ' '+angkaKeKata(x%1000000000):'')).trim();
    return (angkaKeKata(Math.floor(x/1000000000000))+' Triliun'+(x%1000000000000? ' '+angkaKeKata(x%1000000000000):'')).trim();
  }
  if(n === 0) return 'Nol Rupiah';
  return (angkaKeKata(n)+' Rupiah').replace(/\s+/g,' ').trim();
}

/* ---- Tanggal dalam kata (format panjang & format BAST dengan nama hari) ---- */
const NAMA_BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const NAMA_HARI = ['Minggu','Senin','Selasa','Rabu','Kamis',"Jum'at",'Sabtu'];
function formatTanggalPanjang(iso){
  if(!iso) return '—';
  const [y,m,d] = iso.split('-').map(Number);
  return `${d} ${NAMA_BULAN[m-1]||''} ${y}`;
}
function tanggalDalamKata(iso){
  if(!iso) return { hari:'—', tanggalKata:'—', bulan:'—', tahunKata:'—' };
  const [y,m,d] = iso.split('-').map(Number);
  const dateObj = new Date(y, m-1, d);
  const angkaKeKataHari = terbilang(d).replace(' Rupiah','');
  const angkaKeKataTahun = terbilang(y).replace(' Rupiah','');
  return {
    hari: NAMA_HARI[dateObj.getDay()],
    tanggalKata: angkaKeKataHari,
    bulan: NAMA_BULAN[m-1]||'',
    tahunKata: angkaKeKataTahun
  };
}

