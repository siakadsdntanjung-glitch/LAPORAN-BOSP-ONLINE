/* =========================================================================
   SK TERSIMPAN: simpan, edit, cetak ulang, hapus
   SK Guru, SK Panitia RKAS & SK Tim BOS disimpan di /sekolah/{npsn}/dokumenSK/{id}.
   Tombol "Simpan SK" menyimpan; tombol Cetak juga menyimpan otomatis. Setelah
   tersimpan, form masuk ke mode edit sehingga simpan/cetak berikutnya
   memperbarui SK yang sama (tidak membuat duplikat). Daftar SK tampil di bawah form tiap tab SK.
   ========================================================================= */
const SK_LABEL = { skguru:'SK Guru', skrkas:'SK Panitia RKAS', sktimbos:'SK Tim BOS' };

function getSkList(){
  const raw = (state.schoolData && state.schoolData.dokumenSK) || {};
  return Object.entries(raw).map(([id, r])=>({ id, ...r }))
    .sort((a,b)=> (b.updatedAt||0) - (a.updatedAt||0));
}

function kumpulkanSK(jenis){
  if(jenis === 'skguru'){
    const header = {
      nomor: document.getElementById('sk-nomor').value.trim(),
      tanggal: document.getElementById('sk-tanggal').value,
      tentang: document.getElementById('sk-tentang').value.trim(),
      tahunAjaran: document.getElementById('sk-tahun-ajaran').value.trim(),
      semester: document.getElementById('sk-semester').value,
      dasar: document.getElementById('sk-dasar').value
    };
    if(!header.nomor || !header.tanggal || !header.tentang) return { error:'Mohon lengkapi minimal Nomor SK, Tanggal Penetapan, dan Tentang.' };
    return { nomor: header.nomor, tanggal: header.tanggal, judul: header.tentang, data: { header, guru: collectSkGuruRows() } };
  }
  const c = KEPUTUSAN_CFG[jenis], p = c.prefix;
  const g = (id)=>document.getElementById(p+'-'+id).value;
  const v = {
    nomor: g('nomor').trim(), tanggal: g('tanggal'), tempat: g('tempat').trim(), tahun: g('tahun').trim(),
    sosialisasi: g('sosialisasi'), komiteNama: g('komite-nama').trim(), komiteNip: g('komite-nip').trim(),
    menimbang: g('menimbang'), mengingat: g('mengingat'), memperhatikan: g('memperhatikan'), diktum: g('diktum')
  };
  if(!v.nomor || !v.tanggal || !v.tahun) return { error:'Mohon lengkapi minimal Nomor SK, Tanggal Penetapan, dan Tahun Pelajaran.' };
  return { nomor: v.nomor, tanggal: v.tanggal, judul: `${SK_LABEL[jenis]} Tahun Pelajaran ${v.tahun}`, data: { v, rows: collectTimRows(p) } };
}

function isiFormSK(jenis, data){
  data = data || {};
  if(jenis === 'skguru'){
    const h = data.header || {};
    document.getElementById('sk-nomor').value = h.nomor || '';
    document.getElementById('sk-tanggal').value = h.tanggal || '';
    document.getElementById('sk-tentang').value = h.tentang || '';
    document.getElementById('sk-tahun-ajaran').value = h.tahunAjaran || '';
    document.getElementById('sk-semester').value = h.semester || 'Ganjil';
    document.getElementById('sk-dasar').value = h.dasar || '';
    document.getElementById('sk-guru-rows').innerHTML = '';
    const guru = data.guru || [];
    if(guru.length) guru.forEach(r=>addSkGuruRow(r)); else addSkGuruRow();
    return;
  }
  const p = KEPUTUSAN_CFG[jenis].prefix, v = data.v || {};
  const set = (id, val)=>{ document.getElementById(p+'-'+id).value = val || ''; };
  set('nomor', v.nomor); set('tanggal', v.tanggal); set('tempat', v.tempat); set('tahun', v.tahun);
  set('sosialisasi', v.sosialisasi); set('komite-nama', v.komiteNama); set('komite-nip', v.komiteNip);
  set('menimbang', v.menimbang); set('mengingat', v.mengingat); set('memperhatikan', v.memperhatikan); set('diktum', v.diktum);
  document.getElementById(p+'-rows').innerHTML = '';
  (data.rows || []).forEach(r=>addTimRow(p, r));
}

function resetFormSK(jenis){
  if(jenis === 'skguru'){
    isiFormSK('skguru', {});
    document.getElementById('sk-tanggal').value = todayStr();
    return;
  }
  const c = KEPUTUSAN_CFG[jenis];
  isiFormSK(jenis, { v:{
    menimbang: c.menimbang.join('\n'), mengingat: c.mengingat.join('\n'),
    memperhatikan: c.memperhatikan.join('\n'), diktum: c.diktum.join('\n')
  }, rows: [] });
  initKeputusanFields(jenis); // isi ulang tempat, tanggal, tahun & susunan standar
}

async function simpanSK(jenis, diam){
  const hasil = kumpulkanSK(jenis);
  if(hasil.error){ if(!diam) alertFix(hasil.error); return false; }
  const npsn = state.userData && state.userData.npsn;
  if(!npsn) return false;
  const email = (state.user && state.user.email) || '-';
  const sedangEdit = state.editSK && state.editSK.jenis === jenis && state.editSK.id;
  const base = db.ref('sekolah/'+npsn+'/dokumenSK');
  const rec = {
    jenis, nomor: hasil.nomor, tanggal: hasil.tanggal, judul: hasil.judul, data: hasil.data,
    updatedAt: Date.now(), updatedBy: email
  };
  try{
    if(sedangEdit){
      await base.child(state.editSK.id).update(rec);
      logAudit('Cetak SK', 'ubah', `Ubah ${SK_LABEL[jenis]} No. ${rec.nomor}`);
    }else{
      const key = base.push().key;
      rec.createdAt = rec.updatedAt; rec.createdBy = email;
      await base.child(key).set(rec);
      state.editSK = { id:key, jenis };
      logAudit('Cetak SK', 'tambah', `Simpan ${SK_LABEL[jenis]} No. ${rec.nomor}`);
    }
    updateSkEditBanner();
    if(!diam) alertFix(`${SK_LABEL[jenis]} berhasil disimpan. SK dapat dilihat, diedit, atau dicetak ulang dari daftar di bawah form.`);
    return true;
  }catch(err){
    alertFix('Gagal menyimpan SK: ' + (err.message || 'Periksa koneksi internet Anda dan coba lagi.'));
    return false;
  }
}

function updateSkEditBanner(){
  const box = document.getElementById('sk-edit-banner');
  const e = state.editSK;
  const tampil = !!(e && state.currentView === 'cetak' && state.cetakDoc === e.jenis);
  box.classList.toggle('hidden', !tampil);
  if(!tampil) return;
  const rec = getSkList().find(x=>x.id === e.id);
  document.getElementById('sk-edit-banner-text').textContent =
    `${SK_LABEL[e.jenis]}${rec && rec.nomor ? ' No. ' + rec.nomor : ''}`;
}

function renderDaftarSK(jenis){
  const box = document.getElementById('sk-list-'+jenis);
