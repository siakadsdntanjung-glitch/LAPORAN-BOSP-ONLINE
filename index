  root.innerHTML = `<div style="padding:24px;">${kopHtml}${bodyHtml}</div>`;
}


/* ---- Kop surat: dipakai bersama oleh Kwitansi / Nota Pesan / BAST ---- */
function buildKopSuratHtml(s){
  const kop = s.kopSurat || {};
  const lines = [kop.baris1, kop.baris2, kop.baris3].filter(Boolean);
  const textBlock = `
    ${lines.map(l=>`<div style="font-size:12px; font-weight:700;">${escapeHtml(l)}</div>`).join('')}
    <div style="font-family:Lora,serif; font-size:15px; font-weight:700; margin-top:${lines.length?'2px':'0'};">${escapeHtml(s.namaSekolah||'')}</div>
    ${s.alamat ? `<div style="font-size:11px;">${escapeHtml(s.alamat)}</div>` : ''}
  `;
  const logoStyle = 'height:56px; width:56px; object-fit:contain; flex-shrink:0;';
  return `
    <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; border-bottom:2px solid #16324F; padding-bottom:10px; margin-bottom:18px;">
      <div style="width:56px;">${kop.logoKiri ? `<img src="${kop.logoKiri}" style="${logoStyle}">` : ''}</div>
      <div style="text-align:center; flex:1;">${textBlock}</div>
      <div style="width:56px; text-align:right;">${kop.logoKanan ? `<img src="${kop.logoKanan}" style="${logoStyle}">` : ''}</div>
    </div>`;
}

