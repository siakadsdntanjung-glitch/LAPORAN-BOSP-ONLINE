async function saveSppdData(){
  const npsn = state.userData.npsn;
  const txId = document.getElementById('sppd-tx-id').value;
  const data = collectSppdForm();
  await db.ref('transaksi_bku/'+npsn+'/'+txId+'/sppd').update(data);
  return data;
}

document.getElementById('form-sppd').addEventListener('submit', async (e)=>{
  e.preventDefault();
  try{
    await saveSppdData();
    showSppdFeedback('Data SPPD tersimpan.', true);
  }catch(err){
    showSppdFeedback('Gagal menyimpan data SPPD: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'), false);
  }
});

async function simpanLaluCetakSppd(builderFn){
  const txId = document.getElementById('sppd-tx-id').value;
  const t = state.transactions.find(x=>x.id===txId);
  if(!t){ alertFix('Transaksi tidak ditemukan.'); return; }
  try{
    const data = await saveSppdData();
    builderFn(t, data);
    window.print();
  }catch(err){
    showSppdFeedback('Gagal menyimpan data SPPD: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'), false);
  }
}

