  state.editSK = null;

  // Berlaku untuk SEMUA role (termasuk Admin Utama, yang panelnya sendiri
  // dirender lewat listener ini) — lihat attachMaintenanceListener().
  attachMaintenanceListener();

  if(userData.role === 'admin_utama'){
    attachAdminUtamaListeners();
    navigateTo('dashboard-utama');
  } else {
    attachSchoolListeners(userData.npsn);
    navigateTo('dashboard-sekolah');
