function renderSppd(){
  // Daftar SPPD ikut Tahap Laporan BOSP & Jenis Dana BOSP yang sedang aktif
  // (sama seperti Buku Kas Umum & panel Cetak), supaya transaksi Perjalanan
  // Dinas dari tahap/jenis dana lain tidak ikut tercampur/tercetak di sini.
  const tahapAktifSppd = state.tahapAktif || getDefaultTahap();
  const jenisDanaSppd = state.jenisDanaAktif || getDefaultJenisDana();
  const list = state.transactions.filter(t=>t.perjalananDinas && bulanDalamTahap(t.tanggal, tahapAktifSppd) && jenisDanaTransaksi(t)===jenisDanaSppd);
  const rows = list.map(t=>{
    const namaPegawai = (t.sppd && t.sppd.namaPegawai) || t.penerima || '';
    return `<tr class="border-b border-navy-50">
      <td class="py-2 px-3 whitespace-nowrap">${formatTanggal(t.tanggal)}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(t.uraian||'')}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(namaPegawai)}</td>
      <td class="py-2 px-3 text-right">${fmtRupiah(t.jumlah)}</td>
      <td class="py-2 px-3">
        <button data-id="${t.id}" class="btn-buka-sppd text-navy font-semibold hover:underline text-xs font-sans">Lengkapi / Cetak SPPD</button>
      </td>
    </tr>`;
  }).join('');
  document.getElementById('tbl-sppd').innerHTML = rows || `<tr><td colspan="5" class="py-8 text-center text-navy-300 font-sans">Belum ada transaksi yang ditandai Perjalanan Dinas pada ${escapeHtml(JENIS_DANA[jenisDanaSppd].label)} — ${escapeHtml(TAHAP_PERIODE[tahapAktifSppd].label)}. Centang "Perjalanan Dinas (tampilkan pada menu SPPD)" pada form Tambah/Ubah Transaksi.</td></tr>`;
  document.querySelectorAll('.btn-buka-sppd').forEach(b=>b.addEventListener('click', ()=>openSppdModal(b.dataset.id)));
}

