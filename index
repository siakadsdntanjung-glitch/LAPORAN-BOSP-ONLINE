function openTransaksiModal(id){
  const modal = document.getElementById('modal-transaksi');
  const form = document.getElementById('form-transaksi');
  form.reset();
  clearLampiranRows();
  document.getElementById('tx-lampiran-wrap').classList.add('hidden');
  document.getElementById('lp-pegawai-panel').classList.add('hidden');
  document.getElementById('tx-id').value = id || '';

  const tahap = state.tahapAktif || getDefaultTahap();
  if(isTahapTerkunci(tahap) && state.userData.role !== 'kepala_sekolah'){
    modal.classList.add('hidden');
    alertFix(`${TAHAP_PERIODE[tahap].label} sedang terkunci. Buka kunci tahap terlebih dahulu.`);
    return;
  }

  const jenisDanaModalEl = document.getElementById('modal-transaksi-jenisdana');
  if(jenisDanaModalEl){
    const jd = state.jenisDanaAktif || getDefaultJenisDana();
    jenisDanaModalEl.textContent = JENIS_DANA[jd].label;
  }

  // Batasi tanggal yang bisa dipilih agar tetap berada pada periode tahap
  // aktif — mencegah transaksi tahap lain tercampur masuk secara tidak sengaja.
  const { min, max } = rentangTanggalTahap(tahap);
  const inputTanggal = document.getElementById('tx-tanggal');
  inputTanggal.min = min;
  inputTanggal.max = max;
  inputTanggal.value = todayStr() >= min && todayStr() <= max ? todayStr() : min;

  if(id){
    const t = state.transactions.find(x=>x.id===id);
    if(t){
      document.getElementById('modal-transaksi-title').textContent = 'Ubah Transaksi';
      document.getElementById('tx-tanggal').value = t.tanggal||'';
      document.getElementById('tx-kode').value = t.kode||'';
      document.getElementById('tx-nobukti').value = t.noBukti||'';
      document.getElementById('tx-kodeprogram').value = t.kodeProgram||'';
      document.getElementById('tx-koderekening').value = t.kodeRekening||'';
      document.getElementById('tx-uraian').value = t.uraian||'';
      document.getElementById('tx-kualitas').value = t.kualitas||'';
      document.getElementById('tx-satuan').value = t.satuan||'';
      document.getElementById('tx-jenis').value = t.jenis||'penerimaan';
      document.getElementById('tx-kelompok-belanja').value = t.kelompokBelanja||'';
      document.getElementById('tx-jumlah').value = t.jumlah||0;
      document.getElementById('tx-penerima').value = t.penerima||'';
      document.getElementById('tx-nip').value = t.nipPenerima||'';
      document.getElementById('tx-jabatan').value = t.jabatan||'';
      document.getElementById('tx-lampiran').checked = !!t.lampiran;
      document.getElementById('tx-lampiran-wrap').classList.toggle('hidden', !t.lampiran);
      document.getElementById('tx-perjalanan-dinas').checked = !!t.perjalananDinas;
      if(Array.isArray(t.lampiranPenerima) && t.lampiranPenerima.length){
        t.lampiranPenerima.forEach(p=>addLampiranRow(p));
      }
    }
  } else {
    document.getElementById('modal-transaksi-title').textContent = 'Tambah Transaksi';
  }
  modal.classList.remove('hidden');
}
function closeTransaksiModal(){
  document.getElementById('modal-transaksi').classList.add('hidden');
}

document.getElementById('form-transaksi').addEventListener('submit', async (e)=>{
  e.preventDefault();
  const npsn = state.userData.npsn;
  const id = document.getElementById('tx-id').value;
  const tahap = state.tahapAktif || getDefaultTahap();

  if(isTahapTerkunci(tahap)){
    alertFix(`${TAHAP_PERIODE[tahap].label} sedang terkunci. Transaksi tidak dapat disimpan.`);
    return;
  }
  const tanggal = document.getElementById('tx-tanggal').value;
  if(!bulanDalamTahap(tanggal, tahap)){
    alertFix(`Tanggal transaksi harus berada pada periode ${TAHAP_PERIODE[tahap].label}. Pindah ke tab tahap yang sesuai bila ingin mencatat transaksi pada periode lain.`);
    return;
  }

  const payload = {
    tanggal,
    kode: document.getElementById('tx-kode').value.trim(),
    noBukti: document.getElementById('tx-nobukti').value.trim(),
    kodeProgram: document.getElementById('tx-kodeprogram').value.trim(),
    kodeRekening: document.getElementById('tx-koderekening').value.trim(),
    uraian: document.getElementById('tx-uraian').value.trim(),
    kualitas: document.getElementById('tx-kualitas').value.trim(),
    satuan: document.getElementById('tx-satuan').value.trim(),
    jenis: document.getElementById('tx-jenis').value,
    kelompokBelanja: document.getElementById('tx-kelompok-belanja').value,
    jumlah: Number(document.getElementById('tx-jumlah').value)||0,
    penerima: document.getElementById('tx-penerima').value.trim(),
    nipPenerima: document.getElementById('tx-nip').value.trim(),
    jabatan: document.getElementById('tx-jabatan').value.trim(),
    lampiran: document.getElementById('tx-lampiran').checked,
    lampiranPenerima: collectLampiranRows(),
    perjalananDinas: document.getElementById('tx-perjalanan-dinas').checked,
    jenisDana: state.jenisDanaAktif || getDefaultJenisDana(),
    updatedAt: Date.now()
  };
  try{
    if(id){
      await db.ref('transaksi_bku/'+npsn+'/'+id).update(payload);
      logAudit('Buku Kas Umum', 'ubah', `Ubah transaksi ${formatTanggal(payload.tanggal)} — ${payload.uraian||''} (${fmtRupiah(payload.jumlah)})`);
    } else {
      payload.createdAt = Date.now();
      await db.ref('transaksi_bku/'+npsn).push(payload);
      logAudit('Buku Kas Umum', 'tambah', `Tambah transaksi ${formatTanggal(payload.tanggal)} — ${payload.uraian||''} (${fmtRupiah(payload.jumlah)})`);
    }
    closeTransaksiModal();
  }catch(err){
    alertFix('Gagal menyimpan transaksi: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
  }
});

