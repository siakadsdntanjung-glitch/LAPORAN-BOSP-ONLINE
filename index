          </div>${manual?'':'<p class="text-[10px] text-navy-400 mt-1">Hanya mengubah judul di aplikasi &amp; Excel Rekon; data RAPBS asli tidak berubah. Kosongkan lalu simpan untuk mengembalikan nama asli.</p>'}</div>`;
        const inp = kop.querySelector('.rekon-kop-input'); inp.focus(); inp.select();
        const selesai = ()=>{ if(document.activeElement && document.activeElement.blur) document.activeElement.blur(); renderPeserta(semuaItems()); };
        kop.querySelector('[data-kop-batal]').addEventListener('click', selesai);
        inp.addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); kop.querySelector('[data-kop-simpan]').click(); } else if(e.key==='Escape'){ selesai(); } });
        kop.querySelector('[data-kop-simpan]').addEventListener('click', async ()=>{
          const baru = inp.value.trim().replace(/\s+/g,' ');
          try{
            if(manual){
              if(!baru){ alertFix('Nama kegiatan tidak boleh kosong.'); return; }
              await db.ref(pRekon()+'/perjadinManual/'+prog.slice(2)).update({nama:baru, diubah:Date.now()});
            } else {
              const ref = db.ref(pRekon()+'/namaKegiatan/'+RekonFill.progKey(prog));
              if(baru) await ref.set(baru); else await ref.remove();
            }
            logAudit('Rekon','ubah','Ubah nama kegiatan perjalanan dinas: '+(baru||'(dikembalikan ke nama RAPBS)'));
            selesai();
          }catch(err){ alertFix('Gagal menyimpan: '+(err.message||err)); }
        });
      });
      card.querySelectorAll('.rekon-ps').forEach(inp=>inp.addEventListener('change', async ()=>{
        const rows=[0,1,2].map(i=>({label:card.querySelector(`[data-f=label][data-i="${i}"]`).value.trim(), jml:Number(card.querySelector(`[data-f=jml][data-i="${i}"]`).value)||0}));
        const tot=rows.reduce((a,r)=>a+r.jml,0), vol=Number(card.dataset.vol);
        const info=card.querySelector('.rekon-ps-info'); info.textContent=`Jumlah orang: ${tot} dari ${vol}`+(tot===vol?' ✓':' — harus sama dengan volume RAPBS'); info.className='rekon-ps-info text-[11px] mt-2 '+(tot===vol?'text-forest':'text-rust');
        try{ await db.ref(pRekon()+'/peserta/'+RekonFill.progKey(card.dataset.prog)).set(rows); }
        catch(err){ alertFix('Gagal menyimpan rincian peserta: '+(err.message||err)); }
      }));
    });
  }

  /* ---- Tab Jenis Dana (Reguler / Kinerja) ---- */
  function tandaiTabJd(){
    document.querySelectorAll('.rekon-jd-tab').forEach(b=>{
      const on = b.dataset.jd===jdRekon;
      b.className = 'rekon-jd-tab px-4 py-2 text-sm font-semibold rounded border '+(on?'bg-navy text-white border-navy':'bg-white text-navy border-navy-200');
    });
  }
  document.querySelectorAll('.rekon-jd-tab').forEach(b=>b.addEventListener('click', ()=>{
    if(b.dataset.jd===jdRekon) return;
    jdRekon = b.dataset.jd; tandaiTabJd(); setPesan('','');
    const a=document.activeElement; if(a && a.blur) a.blur();
    window.renderRekon();
  }));
  tandaiTabJd();

  /* ---- Tambah / hapus perjalanan dinas manual ---- */
  /* Sisa anggaran perjalanan dinas RAPBS = pagu RAPBS - total perjalanan dinas manual (otomatis berkurang saat menambah/mengubah) */
  function renderSisaPd(tambah){
    const box = $('rekon-pd-sisa'); if(!box) return;
    const c = cekAnggaranPd(tambah, tambah ? pdEditId : null), R = n => 'Rp '+fmt(n);
    if(!(c.pagu.j>0)){ box.innerHTML = '<span class="text-xs text-navy-300">Belum ada anggaran perjalanan dinas pada RAPBS.</span>'; return; }
    const sisa = c.pagu.j - c.pakai.j, kls = n => n<0 ? 'text-rust' : 'text-forest';
    const baris = (lab,p,k)=>`<tr><td class="pr-3 text-navy-400">${lab}</td><td class="text-right font-mono pr-3">${R(p)}</td><td class="text-right font-mono pr-3">${R(k)}</td><td class="text-right font-mono font-semibold ${kls(p-k)}">${R(p-k)}</td></tr>`;
    box.innerHTML = `<p class="text-[11px] font-semibold text-navy mb-1">Anggaran Perjalanan Dinas RAPBS${tambah?' (setelah perjalanan dinas yang sedang diisi)':''}</p>
      <div class="overflow-x-auto"><table class="text-xs w-full"><thead><tr class="text-navy-400 text-[11px]"><th class="text-left pr-3 font-normal"></th><th class="text-right pr-3 font-normal">Anggaran RAPBS</th><th class="text-right pr-3 font-normal">Perjalanan dinas manual</th><th class="text-right font-normal">Sisa</th></tr></thead><tbody>
      ${baris('Total',c.pagu.j,c.pakai.j)}${baris('Tahap I',c.pagu.t1,c.pakai.t1)}${baris('Tahap II',c.pagu.t2,c.pakai.t2)}</tbody></table></div>
      <p class="text-[11px] mt-1 ${kls(sisa)}">${sisa<0?'Melebihi anggaran sebesar '+R(-sisa):'Sisa anggaran: '+R(sisa)}</p>`;
  }
  function pdPreview(){
    const vol = Number($('pd-vol').value)||0, h = Number($('pd-harian').value)||0, t = Number($('pd-trans').value)||0, tahap = $('pd-tahap').value;
    const tambah = [];
    [h,t].forEach(x=>{ if(x>0 && vol>0){ const j=vol*x; tambah.push({jumlah:j,t1:tahap==='1'?j:0,t2:tahap==='2'?j:0}); } });
    renderSisaPd(tambah.length ? tambah : undefined);
  }
  let pdEditId = null;
  function pdResetForm(){ pdEditId=null; $('form-pd').reset(); $('btn-pd-simpan').textContent='Simpan'; }
  function renderManualList(){
    const box = $('rekon-pd-list'); if(!box) return;
    const arr = manualPerjadin();
    if(!arr.length){ box.innerHTML = '<p class="text-xs text-navy-300">Belum ada perjalanan dinas tambahan.</p>'; return; }
    box.innerHTML = arr.map(e=>{
      const tot = (Number(e.vol)||0)*((Number(e.harian)||0)+(Number(e.transport)||0));
      return `<div class="flex items-start justify-between gap-3 rounded border border-navy-100 px-3 py-2">
        <div class="text-sm"><span class="font-semibold text-navy">${esc(e.nama)}</span>
          <div class="text-[11px] text-navy-400">${fmt(e.vol)} orang · Harian Rp ${fmt(e.harian)} · Transport Rp ${fmt(e.transport)} · Tahap ${String(e.tahap)==='2'?'II':'I'} · Total Rp ${fmt(tot)}</div></div>
        <div class="flex gap-3 shrink-0"><button type="button" data-pd-edit="${esc(e.id)}" class="text-xs text-navy hover:underline">Edit</button>
        <button type="button" data-pd-hapus="${esc(e.id)}" class="text-xs text-rust hover:underline">Hapus</button></div></div>`;
    }).join('');
    box.querySelectorAll('[data-pd-edit]').forEach(b=>b.addEventListener('click', ()=>{
      const e = arr.find(x=>x.id===b.dataset.pdEdit); if(!e) return;
      pdEditId = e.id;
      $('pd-nama').value = e.nama||''; $('pd-vol').value = e.vol||''; $('pd-harian').value = e.harian||0;
      $('pd-trans').value = e.transport||0; $('pd-tahap').value = String(e.tahap)==='2' ? '2' : '1';
      $('btn-pd-simpan').textContent = 'Simpan Perubahan';
      $('form-pd').classList.remove('hidden'); $('form-pd').scrollIntoView({behavior:'smooth',block:'center'}); $('pd-nama').focus();
    }));
    box.querySelectorAll('[data-pd-hapus]').forEach(b=>b.addEventListener('click', async ()=>{
      const id = b.dataset.pdHapus, e = arr.find(x=>x.id===id); if(!e) return;
      if(!confirmFix(`Hapus perjalanan dinas "${e.nama}"?`)) return;
      try{
        const base = pRekon()+'/';
        await db.ref(base+'perjadinManual/'+id).remove();
        await db.ref(base+'peserta/'+RekonFill.progKey('M_'+id)).remove();
        logAudit('Rekon','hapus','Hapus perjalanan dinas manual: '+e.nama);
      }catch(err){ alertFix('Gagal menghapus: '+(err.message||err)); }
    }));
  }
  $('btn-pd-tambah').addEventListener('click', ()=>{ if(pdEditId) pdResetForm(); $('form-pd').classList.toggle('hidden'); if(!$('form-pd').classList.contains('hidden')) $('pd-nama').focus(); });
  ['pd-vol','pd-harian','pd-trans','pd-tahap'].forEach(id=>{ $(id).addEventListener('input', pdPreview); $(id).addEventListener('change', pdPreview); });
  $('btn-pd-batal').addEventListener('click', ()=>{ pdResetForm(); renderSisaPd(); $('form-pd').classList.add('hidden'); });
  $('form-pd').addEventListener('submit', async (ev)=>{
    ev.preventDefault();
    const nama = $('pd-nama').value.trim(), vol = Number($('pd-vol').value)||0,
          harian = Number($('pd-harian').value)||0, transport = Number($('pd-trans').value)||0, tahap = $('pd-tahap').value;
    if(!nama) return alertFix('Nama kegiatan wajib diisi.');
    if(vol<=0) return alertFix('Jumlah orang harus lebih dari 0.');
    if(harian<=0 && transport<=0) return alertFix('Isi minimal salah satu tarif (Uang Harian atau Uang Transport).');
    const tambah = [];
    [harian,transport].forEach(t=>{ if(t>0){ const j=vol*t; tambah.push({jumlah:j,t1:tahap==='1'?j:0,t2:tahap==='2'?j:0}); } });
    const cek = cekAnggaranPd(tambah, pdEditId);
    if(cek.msg.length){
      if(!confirmFix('PERINGATAN: dana melebihi anggaran RAPBS.\n\n- '+cek.msg.join('\n- ')+'\n\nTetap simpan?')) return;
    }
    try{
      if(pdEditId){
        await db.ref(pRekon()+'/perjadinManual/'+pdEditId).update({nama, vol, harian, transport, tahap, diubah:Date.now()});
        logAudit('Rekon','ubah',`Ubah perjalanan dinas manual: ${nama} — ${vol} orang, total Rp ${fmt(vol*(harian+transport))}`);
      } else {
        await db.ref(pRekon()+'/perjadinManual').push({nama, vol, harian, transport, tahap, dibuat:Date.now()});
        logAudit('Rekon','tambah',`Tambah perjalanan dinas manual: ${nama} — ${vol} orang, total Rp ${fmt(vol*(harian+transport))}`);
      }
      pdResetForm(); renderSisaPd(); $('form-pd').classList.add('hidden');
    }catch(err){ alertFix('Gagal menyimpan: '+(err.message||err)); }
  });

  /* ---- Impor PDF RAPBS ---- */
  async function bacaPdf(file){
    if(!window.pdfjsLib) throw new Error('Pustaka pembaca PDF belum termuat. Periksa koneksi internet lalu muat ulang halaman.');
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    const doc = await pdfjsLib.getDocument({data:new Uint8Array(await file.arrayBuffer())}).promise;
    const pages = [];
    for(let p=1;p<=doc.numPages;p++){
      const tc = await (await doc.getPage(p)).getTextContent();
      pages.push(tc.items.map(i=>({str:i.str,x:i.transform[4],y:i.transform[5]})));
    }
    return RapbsParse.parseRapbs(pages);
  }
  $('btn-rekon-impor').addEventListener('click', ()=>$('rekon-file').click());
  $('rekon-file').addEventListener('change', async (e)=>{
    const f = e.target.files && e.target.files[0]; e.target.value = '';
    if(!f) return;
    setPesan('Membaca berkas PDF…','info');
    try{
      const hasil = await bacaPdf(f);
      if(!hasil.items.length) throw new Error('Tidak ditemukan rincian belanja. Pastikan berkas adalah “Kertas Kerja RKAS” (Per Tahap atau Per Triwulan) dari aplikasi RKAS.');
      const npsn = state.userData.npsn;
      if(hasil.meta.npsn && String(hasil.meta.npsn)!==String(npsn)){
        if(!confirmFix(`NPSN pada PDF (${hasil.meta.npsn}) berbeda dari NPSN sekolah ini (${npsn}). Tetap impor?`)){ setPesan('',''); return; }
      }
      if(rapbsItems().length && !confirmFix('Data RAPBS yang sudah ada akan diganti dengan isi berkas ini. Lanjutkan?')){ setPesan('',''); return; }
      const total = hasil.items.reduce((a,x)=>a+x.jumlah,0);
      const items = hasil.items.map(x=>{ const o=Object.assign({},x); o.kategori = RekonFill.classify(o); return o; });
      const payload = JSON.parse(JSON.stringify({ meta:hasil.meta, items, namaBerkas:f.name, diimporPada:Date.now() }));
      await db.ref(pRapbs()).set(payload);
      logAudit('Rekon','impor',`[${labelJd()}] Impor RAPBS ${f.name} — ${items.length} rincian, total Rp ${fmt(total)}`);
      const cocok = !hasil.meta.total || hasil.meta.total[0]===total;
      setPesan(`Berhasil mengimpor ${items.length} rincian belanja, total Rp ${fmt(total)}.` + (cocok?'':` Perhatian: total pada PDF Rp ${fmt(hasil.meta.total[0])} — periksa hasil impor.`), cocok?'ok':'info');
    }catch(err){
      console.error(err); setPesan('Gagal mengimpor RAPBS: '+(err.message||err),'err');
    }
  });
  $('btn-rekon-hapus').addEventListener('click', async ()=>{
    if(!confirmFix('Hapus seluruh data RAPBS (data induk rekon) sekolah ini? Pengaturan data pelengkap tidak ikut terhapus.')) return;
    try{ await db.ref(pRapbs()).remove(); logAudit('Rekon','hapus','['+labelJd()+'] Hapus data induk RAPBS'); setPesan('Data RAPBS dihapus.','info'); }
    catch(err){ alertFix('Gagal menghapus: '+(err.message||err)); }
  });

  /* ---- Data pelengkap ---- */
  $('form-rekon').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const num = id => { const v=$(id).value; return v===''? null : (Number(v)||0); };
    const upd = { desaKec:$('rekon-desa').value.trim(), kabupaten:$('rekon-kab').value.trim(), provinsi:$('rekon-prov').value.trim(), saldoAwal:num('rekon-saldo')||0 };
    const a=num('rekon-t1'), b=num('rekon-t2');
    upd.penerimaanT1 = a; upd.penerimaanT2 = b;
    Object.keys(upd).forEach(k=>{ if(upd[k]===null) upd[k]=null; });
    try{
      await db.ref(pRekon()).update(upd);
      const i=$('rekon-simpan-info'); i.classList.remove('hidden'); setTimeout(()=>i.classList.add('hidden'),2500);
    }catch(err){ alertFix('Gagal menyimpan: '+(err.message||err)); }
  });

  /* ---- Unduh Excel ---- */
  function bangunData(){
    const s = state.schoolData || {}, c = rekonCfg(), items = semuaItems(), meta = (rapbsData()||{}).meta || {};
    const tot = items.reduce((a,x)=>({j:a.j+(x.jumlah||0),t1:a.t1+(x.t1||0),t2:a.t2+(x.t2||0)}),{j:0,t1:0,t2:0});
    const kp = s.kepsek || {}, bd = s.bendahara || {};
    return {
      profil:{ nama:s.namaSekolah||meta.nama||'', npsn:s.npsn||state.userData.npsn, alamat:s.alamat||meta.alamat||'',
        desa: c.desaKec!==undefined ? c.desaKec : (meta.alamat||''), kabupaten: c.kabupaten!==undefined ? c.kabupaten : stripPrefix(meta.kabupaten,/^Kab(upaten)?\.?\s*/i),
        provinsi: c.provinsi!==undefined ? c.provinsi : stripPrefix(meta.provinsi,/^Prov(insi)?\.?\s*/i),
        kepsek:kp.nama||'', nipKepsek:kp.nip||'', bendahara:bd.nama||'', nipBendahara:bd.nip||'', pagu:tot.j },
      saldoAwal: c.saldoAwal!==undefined ? c.saldoAwal : (jdRekon==='kinerja' ? 0 : (s.saldoAwal||0)),
      pagu: tot.j,
      peserta: c.peserta||{},
      penerimaanT1: (c.penerimaanT1===undefined||c.penerimaanT1===null) ? tot.t1 : c.penerimaanT1,
      penerimaanT2: (c.penerimaanT2===undefined||c.penerimaanT2===null) ? tot.t2 : c.penerimaanT2,
      items: items.map(x=>({rek:x.rek,prog:x.prog,kegiatan:x.kegiatan,uraian:x.uraian,vol:x.vol,sat:x.sat,tarif:x.tarif,jumlah:x.jumlah,t1:x.t1,t2:x.t2,kategori:x.kategori||RekonFill.classify(x)}))
    };
  }
  $('btn-rekon-unduh').addEventListener('click', async ()=>{
    const info = $('rekon-unduh-info'), btn = $('btn-rekon-unduh');
    try{
      if(!window.ExcelJS) throw new Error('Pustaka Excel belum termuat. Periksa koneksi internet lalu muat ulang halaman.');
      if(!rapbsItems().length) throw new Error('Impor data RAPBS terlebih dahulu.');
      btn.disabled = true; info.textContent = 'Menyusun berkas Excel…';
      const b64 = $('rekon-template-b64').textContent.trim();
      const bin = atob(b64), buf = new Uint8Array(bin.length); for(let i=0;i<bin.length;i++) buf[i]=bin.charCodeAt(i);
      const wb = new ExcelJS.Workbook(); await wb.xlsx.load(buf.buffer);
      const data = bangunData();
      const warn = RekonFill.fillRekon(wb, data);
      const out = await wb.xlsx.writeBuffer();
      const blob = new Blob([out],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
      const nm = String(data.profil.nama||'sekolah').replace(/[^A-Za-z0-9]+/g,'_');
      a.download = `REKON_${jdRekon==='kinerja'?'BOSP_KINERJA':'BOS'}_${data.profil.npsn||''}_${nm}_${todayStr()}.xlsx`;
      document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),4000);
      logAudit('Rekon','unduh',`[${labelJd()}] Unduh Excel Rekon BPK — total Rp ${fmt(data.pagu)}`);
      info.textContent = 'Berkas diunduh.';
      if(warn.length) alertFix('Catatan:\n- '+warn.join('\n- '));
    }catch(err){
      console.error(err); info.textContent = ''; alertFix('Gagal menyusun Excel Rekon: '+(err.message||err));
    }finally{ btn.disabled = false; }
  });
})();

</script>
