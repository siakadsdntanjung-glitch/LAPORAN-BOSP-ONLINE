/* =========================================================================
   ADMIN UTAMA: DATA + VERIFIKASI
   ========================================================================= */
function attachAdminUtamaListeners(){
  const usersRef = db.ref('users');
  const schoolsRef = db.ref('sekolah');
  const txRef = db.ref('transaksi_bku');

  const renderAllAdminUtamaViews = ()=>{
    renderVerifikasiTable();
    renderDashboardUtamaStats();
    renderManajemenSekolah();
    renderMonitoringLaporan();
    renderRekapitulasi();
  };

  // Error callback: kalau Firebase menolak izin baca (mis. Security Rules
  // belum mengizinkan admin_utama membaca node ini), tampilkan alasannya
  // secara eksplisit alih-alih membiarkan tabel terlihat "kosong" begitu saja.
  const onReadError = (label)=>(err)=>{
    console.error(`Gagal membaca /${label}:`, err);
    state.adminDataError = `Gagal memuat data "${label}": ${err.message || err.code || err}`;
    renderAllAdminUtamaViews();
  };

  const usersCb = usersRef.on('value', snap=>{
    state.allUsers = snap.val() || {};
    renderAllAdminUtamaViews();
  }, onReadError('users'));
  const schoolsCb = schoolsRef.on('value', snap=>{
    state.allSchools = snap.val() || {};
    renderAllAdminUtamaViews();
  }, onReadError('sekolah'));
  const txCb = txRef.on('value', snap=>{
    state.allTransactions = snap.val() || {};
    renderAllAdminUtamaViews();
  }, onReadError('transaksi_bku'));

  state.listeners.push([usersRef,'value',usersCb],[schoolsRef,'value',schoolsCb],[txRef,'value',txCb]);
}

/* ---- Ringkasan per sekolah (dipakai oleh Dashboard, Monitoring, & Rekapitulasi) ---- */
function hitungRingkasanSekolah(){
  const schools = state.allSchools || {};
  const users = state.allUsers || {};
  const allTx = state.allTransactions || {};

  return Object.values(schools).map(s=>{
    const npsn = s.npsn;
    const owner = Object.values(users).find(u=>u.npsn===npsn && u.role==='admin_sekolah');
    const status = owner ? owner.status : 'pending';
    const txMap = allTx[npsn] || {};
    const txList = Object.values(txMap);
    const totalPenerimaan = txList.filter(t=>t.jenis==='penerimaan').reduce((sum,t)=>sum+(Number(t.jumlah)||0),0);
    const totalPengeluaran = txList.filter(t=>t.jenis==='pengeluaran').reduce((sum,t)=>sum+(Number(t.jumlah)||0),0);
    const pengeluaranList = txList.filter(t=>t.jenis==='pengeluaran');
    const lengkapSpj = pengeluaranList.filter(t=>t.noBukti).length;
    const lastUpdated = txList.reduce((max,t)=>Math.max(max, t.updatedAt||t.createdAt||0), 0);
    return {
      npsn, namaSekolah: s.namaSekolah||'', jenjang: s.jenjang||'', alamat: s.alamat||'',
      status, jumlahTransaksi: txList.length,
      totalPenerimaan, totalPengeluaran, saldo: totalPenerimaan-totalPengeluaran,
      jumlahPengeluaran: pengeluaranList.length, lengkapSpj, lastUpdated
    };
  });
}

