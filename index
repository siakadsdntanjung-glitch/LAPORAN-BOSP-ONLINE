/* ---- Manajemen Sekolah: data master + filter ---- */
function renderManajemenSekolah(){
  const errRow = adminErrorRow(5);
  if(errRow){ document.getElementById('tbl-manajemen-sekolah').innerHTML = errRow; return; }
  const ringkasan = hitungRingkasanSekolah();
  const search = (document.getElementById('manajemen-search').value||'').toLowerCase();
  const filterStatus = document.getElementById('manajemen-filter-status').value;

  const filtered = ringkasan.filter(r=>{
    const matchSearch = !search || r.npsn.toLowerCase().includes(search) || r.namaSekolah.toLowerCase().includes(search);
    const matchStatus = !filterStatus || r.status === filterStatus;
    return matchSearch && matchStatus;
  });

  const badge = (status)=> status==='aktif'
    ? `<span class="text-forest bg-forest-100 text-xs font-semibold px-2 py-1 rounded">Aktif</span>`
    : status==='nonaktif'
