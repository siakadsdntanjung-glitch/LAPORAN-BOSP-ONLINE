/* ---- RKAS vs Realisasi: membandingkan Pagu RKAS per Kode Kegiatan dengan
   realisasi belanja (pengeluaran) pada Buku Kas Umum ---- */
function hitungRealisasiPerKegiatan(){
  const perKegiatan = {};
  state.transactions.filter(t=>t.jenis==='pengeluaran').forEach(t=>{
    const kode = t.kode || '(Tanpa Kode Kegiatan)';
    if(!perKegiatan[kode]) perKegiatan[kode] = { jumlahTransaksi:0, total:0 };
    perKegiatan[kode].jumlahTransaksi += 1;
    perKegiatan[kode].total += Number(t.jumlah)||0;
  });
  return perKegiatan;
}

function renderRkas(){
  const tblRkas = document.getElementById('tbl-rkas');
  if(!tblRkas) return; // halaman ini hanya ada pada nav Buku Pembantu (Admin Sekolah)

  const realisasiPerKegiatan = hitungRealisasiPerKegiatan();
  const kodeTerpakai = new Set();

  let totalPagu = 0, totalRealisasi = 0;
  const rows = state.rkas.map(r=>{
    kodeTerpakai.add(r.kodeKegiatan);
    const real = realisasiPerKegiatan[r.kodeKegiatan] || { jumlahTransaksi:0, total:0 };
    const pagu = Number(r.paguAnggaran)||0;
    const sisa = pagu - real.total;
    const persen = pagu>0 ? Math.round((real.total/pagu)*100) : 0;
    totalPagu += pagu; totalRealisasi += real.total;
    const warnaPersen = persen>100 ? 'text-rust' : (persen>=90 ? 'text-gold-600' : 'text-forest');
    return { pagu, real: real.total, sisa, persen, html: `<tr class="border-b border-navy-50 hover:bg-paper/60">
      <td class="py-2 px-3 font-sans">${escapeHtml(r.kodeKegiatan||'')}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(r.namaKegiatan||'')}</td>
      <td class="py-2 px-3 text-right">${fmtRupiah(pagu)}</td>
      <td class="py-2 px-3 text-right">${fmtRupiah(real.total)}</td>
      <td class="py-2 px-3 text-right ${sisa<0?'text-rust':''}">${fmtRupiah(sisa)}</td>
      <td class="py-2 px-3 font-semibold ${warnaPersen}">${persen}%${persen>100?' (Melebihi Pagu)':''}</td>
      <td class="py-2 px-3 font-sans no-print space-x-2 whitespace-nowrap">
        <button data-id="${r.id}" class="btn-edit-rkas text-navy-400 hover:text-navy text-xs font-semibold">Ubah</button>
        <button data-id="${r.id}" class="btn-hapus-rkas text-rust hover:underline text-xs font-semibold">Hapus</button>
      </td>
    </tr>` };
  });

  tblRkas.innerHTML = rows.map(r=>r.html).join('') || `<tr><td colspan="7" class="py-8 text-center text-navy-300 font-sans">Belum ada Kegiatan RKAS. Tambahkan sesuai dokumen RKAS/RKAS-P yang telah ditetapkan.</td></tr>`;

  const totalSisa = totalPagu - totalRealisasi;
  const totalPersen = totalPagu>0 ? Math.round((totalRealisasi/totalPagu)*100) : 0;
  document.getElementById('rkas-total-pagu').textContent = fmtRupiah(totalPagu);
  document.getElementById('rkas-total-realisasi').textContent = fmtRupiah(totalRealisasi);
  const sisaEl = document.getElementById('rkas-total-sisa');
  sisaEl.textContent = fmtRupiah(totalSisa);
  sisaEl.classList.toggle('text-rust', totalSisa<0);
  sisaEl.classList.toggle('text-navy', totalSisa>=0);
  document.getElementById('rkas-total-persen').textContent = totalPersen + '%';

  // Kode Kegiatan yang muncul pada realisasi tapi belum terdaftar di RKAS.
  const rowsTanpa = Object.entries(realisasiPerKegiatan)
    .filter(([kode])=> !kodeTerpakai.has(kode))
    .sort((a,b)=>b[1].total-a[1].total)
    .map(([kode,r])=>`<tr class="border-b border-navy-50">
      <td class="py-2 px-3 font-sans">${escapeHtml(kode)}</td>
      <td class="py-2 px-3 text-right">${r.jumlahTransaksi}</td>
      <td class="py-2 px-3 text-right">${fmtRupiah(r.total)}</td>
    </tr>`).join('');
  document.getElementById('tbl-rkas-tanpa').innerHTML = rowsTanpa || `<tr><td colspan="3" class="py-6 text-center text-navy-300 font-sans">Semua Kode Kegiatan pada realisasi sudah terdaftar di RKAS.</td></tr>`;

  document.querySelectorAll('.btn-edit-rkas').forEach(b=>b.addEventListener('click', ()=>openRkasModal(b.dataset.id)));
  document.querySelectorAll('.btn-hapus-rkas').forEach(b=>b.addEventListener('click', async ()=>{
    if(confirmFix('Hapus Kegiatan RKAS ini? Data realisasi pada Buku Kas Umum tidak akan terhapus.')){
      try{
        const rkHapus = state.rkas.find(x=>x.id===b.dataset.id);
        await db.ref('rkas/'+state.userData.npsn+'/'+b.dataset.id).remove();
        logAudit('RKAS', 'hapus', `Hapus Kegiatan RKAS ${(rkHapus&&rkHapus.kodeKegiatan)||''} — ${(rkHapus&&rkHapus.namaKegiatan)||''}`);
      }catch(err){
        alertFix('Gagal menghapus Kegiatan RKAS: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
      }
    }
  }));
}

