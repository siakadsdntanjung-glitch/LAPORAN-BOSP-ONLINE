  const list = getSkList().filter(r=>r.jenis === jenis);
  box.innerHTML = `
    <div class="bg-white rounded-lg border border-navy-100 p-4 space-y-2">
      <p class="text-xs font-semibold text-navy-400 uppercase tracking-wide">Daftar ${escapeHtml(SK_LABEL[jenis])} Tersimpan (${list.length})</p>
      ${list.length ? `<ul class="divide-y divide-navy-100">${list.map(r=>`
        <li class="py-2.5 flex flex-wrap items-center justify-between gap-2">
          <div class="min-w-0">
            <p class="text-sm font-semibold text-navy truncate">${escapeHtml(r.nomor||'-')}</p>
