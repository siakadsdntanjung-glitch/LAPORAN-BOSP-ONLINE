      <table style="width:100%; border-collapse:collapse; font-size:11px;">
        <thead><tr>
          <th style="border:1px solid #16324F; padding:4px 5px; background:#EAF0F5;">Tanggal</th>
          <th style="border:1px solid #16324F; padding:4px 5px; background:#EAF0F5;">Kode</th>
          <th style="border:1px solid #16324F; padding:4px 5px; background:#EAF0F5;">Uraian</th>
          <th style="border:1px solid #16324F; padding:4px 5px; background:#EAF0F5;">Penerimaan</th>
