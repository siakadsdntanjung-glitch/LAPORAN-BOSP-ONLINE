function addLampiranRow(data){
  data = data || {};
  const wrap = document.getElementById('tx-lampiran-rows');
  const row = document.createElement('div');
  row.className = 'lampiran-row grid grid-cols-12 gap-1.5 items-center';
  row.innerHTML = `
    <input class="lp-nama col-span-4 rounded border border-navy-100 px-2 py-1.5 text-xs" placeholder="Nama">
    <input class="lp-nip col-span-3 rounded border border-navy-100 px-2 py-1.5 text-xs font-mono" placeholder="NIP">
    <input class="lp-jabatan col-span-2 rounded border border-navy-100 px-2 py-1.5 text-xs" placeholder="Jabatan">
    <input type="number" min="0" class="lp-jumlah col-span-2 rounded border border-navy-100 px-2 py-1.5 text-xs font-mono" placeholder="Jumlah">
    <button type="button" class="btn-hapus-lp col-span-1 text-rust hover:text-rust-600 text-base font-bold leading-none" title="Hapus baris ini">&times;</button>
  `;
  wrap.appendChild(row);
  row.querySelector('.lp-nama').value = data.nama||'';
  row.querySelector('.lp-nip').value = data.nip||'';
  row.querySelector('.lp-jabatan').value = data.jabatan||'';
  row.querySelector('.lp-jumlah').value = data.jumlah||'';
  row.querySelector('.btn-hapus-lp').addEventListener('click', ()=>{ row.remove(); updateLampiranTotal(); });
  row.querySelector('.lp-jumlah').addEventListener('input', updateLampiranTotal);
  updateLampiranTotal();
}
function clearLampiranRows(){
  document.getElementById('tx-lampiran-rows').innerHTML = '';
  updateLampiranTotal();
}
function collectLampiranRows(){
  return Array.from(document.querySelectorAll('#tx-lampiran-rows .lampiran-row')).map(row=>({
    nama: row.querySelector('.lp-nama').value.trim(),
    nip: row.querySelector('.lp-nip').value.trim(),
    jabatan: row.querySelector('.lp-jabatan').value.trim(),
    jumlah: Number(row.querySelector('.lp-jumlah').value)||0
  })).filter(r=>r.nama || r.nip || r.jumlah);
}
function updateLampiranTotal(){
  const el = document.getElementById('tx-lampiran-total');
  const rows = collectLampiranRows();
  if(!rows.length){ el.textContent=''; return; }
  const total = rows.reduce((s,r)=>s+(Number(r.jumlah)||0),0);
  const txJumlah = Number(document.getElementById('tx-jumlah').value)||0;
  const beda = txJumlah && total !== txJumlah;
  el.textContent = `Total ${rows.length} penerima: ${fmtRupiah(total)}` + (beda ? ` — berbeda dengan Jumlah (Rp) transaksi (${fmtRupiah(txJumlah)})` : '');
  el.className = 'text-[11px] pt-1 ' + (beda ? 'text-rust font-semibold' : 'text-navy-400');
}
