  // Kartu total penerimaan/pengeluaran & grafik penyerapan per sekolah
  const totalPenerimaan = ringkasan.reduce((sum,r)=>sum+r.totalPenerimaan, 0);
  const totalPengeluaran = ringkasan.reduce((sum,r)=>sum+r.totalPengeluaran, 0);
  document.getElementById('stat-total-penerimaan').textContent = fmtRupiah(totalPenerimaan);
  document.getElementById('stat-total-pengeluaran').textContent = fmtRupiah(totalPengeluaran);

  const topSekolah = ringkasan.filter(r=>r.totalPenerimaan>0 || r.totalPengeluaran>0)
    .sort((a,b)=>b.totalPengeluaran-a.totalPengeluaran).slice(0,8);
  const chartHtml = topSekolah.map(r=>{
    const persen = r.totalPenerimaan>0 ? Math.min(100, Math.round((r.totalPengeluaran/r.totalPenerimaan)*100)) : 0;
    return `
      <div>
        <div class="flex justify-between text-xs mb-1">
          <span class="font-medium text-navy truncate pr-2">${escapeHtml(r.namaSekolah)}</span>
          <span class="text-navy-400 shrink-0">${persen}% terserap</span>
        </div>
