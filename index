   FORMAT DATA TRANSAKSI BKU — satu sumber kebenaran untuk field, label,
   dan kolom import/export, disamakan persis dengan form "+ Transaksi".
   ========================================================================= */
const FIELD_LABELS = {
  tanggal: 'Tanggal',
  kode: 'Kode Kegiatan',
  noBukti: 'No. Bukti/BKU',
  kodeProgram: 'Kode Program',
  kodeRekening: 'Kode Rekening',
  uraian: 'Uraian',
  kualitas: 'Kualitas',
  satuan: 'Satuan',
  jenis: 'Jenis Transaksi',
  kelompokBelanja: 'Kategori Belanja (ATK/Jasa/Modal/Honor/Kebersihan/Alat RT)',
  jumlah: 'Jumlah (Rp)',
  penerima: 'Nama Penerima',
  nipPenerima: 'NIP Penerima',
  jabatan: 'Jabatan Penerima',
  lampiran: 'Lampiran (Cetak Lampiran)'
};
// Field wajib mengikuti atribut required pada form manual (tx-tanggal, tx-uraian, tx-jumlah).
// "Kategori Belanja" TIDAK dijadikan wajib agar file/template lama (tanpa kolom ini)
// tetap bisa diimpor tanpa error — baris tanpa kategori cukup dianggap "Tidak Termasuk".
const REQUIRED_FIELDS = ['tanggal','uraian','jumlah'];

// Beberapa alias nama kolom (huruf besar/kecil & tanda baca diabaikan) agar
// file lama maupun template baru tetap bisa diimpor.
const FIELD_ALIASES = {
  tanggal: ['tanggal','date'],
  kode: ['kode','kodekegiatan'],
  noBukti: ['nobuktibku','nobukti','nomorbukti'],
  kodeProgram: ['kodeprogram'],
  kodeRekening: ['koderekening'],
  uraian: ['uraian'],
  kualitas: ['kualitas'],
  satuan: ['satuan'],
  jenis: ['jenistransaksi','jenis'],
  kelompokBelanja: ['kategoribelanjaatkjasamodalhonorkebersihanalatrt','kategoribelanjaatkjasamodalhonor','kategoribelanja','kelompokbelanja'],
  jumlah: ['jumlahrp','jumlah'],
  penerima: ['namapenerima','penerima'],
  nipPenerima: ['nippenerima','nip'],
  jabatan: ['jabatan','jabatanpenerima'],
  lampiran: ['lampiran','sertakanlampiran','cetaklampiran']
};

function normalizeHeader(h){
  return String(h==null?'':h).toLowerCase().replace(/[^a-z0-9]/g,'');
}
// Label kategori belanja (kode -> teks) dipakai bersama oleh export/template/
// import serta Kertas Kerja 2.2.1, agar teks di file impor & tampilan selalu sama.
const KELOMPOK_BELANJA_LABELS = { atk:'Belanja ATK', jasa:'Belanja Jasa', modal:'Belanja Modal', honor:'Belanja Honor', kebersihan:'Belanja Kebersihan', rumahtangga:'Belanja Alat Rumah Tangga' };
function kelompokBelanjaKeFromLabel(val){
  const norm = normalizeHeader(val);
  if(!norm) return '';
  const found = Object.keys(KELOMPOK_BELANJA_LABELS).find(key=>
    norm===key || norm===normalizeHeader(KELOMPOK_BELANJA_LABELS[key])
  );
  return found || '';
}
function buildHeaderKeyMap(){
  const map = {};
  Object.keys(FIELD_ALIASES).forEach(key=>{
    FIELD_ALIASES[key].forEach(alias=>{ map[alias] = key; });
  });
  return map;
}
function mapRowToFields(row, headerKeyMap){
  const out = {};
  Object.keys(row).forEach(h=>{
    const key = headerKeyMap[normalizeHeader(h)];
    if(key) out[key] = row[h];
  });
  return out;
}
function parseTanggalFleksibel(val){
  if(val==null || val==='') return '';
  if(val instanceof Date && !isNaN(val)){
    const y=val.getFullYear(), m=String(val.getMonth()+1).padStart(2,'0'), d=String(val.getDate()).padStart(2,'0');
    return `${y}-${m}-${d}`;
  }
  const s = String(val).trim();
  if(/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0,10);
  const m1 = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if(m1) return `${m1[3]}-${m1[2].padStart(2,'0')}-${m1[1].padStart(2,'0')}`;
  if(/^\d+(\.\d+)?$/.test(s)){
    const num = Number(s);
    if(num>20000 && num<80000 && window.XLSX && XLSX.SSF){
      const d = XLSX.SSF.parse_date_code(num);
      if(d) return `${d.y}-${String(d.m).padStart(2,'0')}-${String(d.d).padStart(2,'0')}`;
    }
  }
  return s;
}
function transaksiToRow(t){
  return {
    'Jenis Dana BOSP': JENIS_DANA[jenisDanaTransaksi(t)].label,
    [FIELD_LABELS.tanggal]: t.tanggal || '',
    [FIELD_LABELS.kode]: t.kode || '',
    [FIELD_LABELS.noBukti]: t.noBukti || '',
    [FIELD_LABELS.kodeProgram]: t.kodeProgram || '',
    [FIELD_LABELS.kodeRekening]: t.kodeRekening || '',
    [FIELD_LABELS.uraian]: t.uraian || '',
    [FIELD_LABELS.kualitas]: t.kualitas || '',
    [FIELD_LABELS.satuan]: t.satuan || '',
    [FIELD_LABELS.jenis]: t.jenis==='pengeluaran' ? 'Pengeluaran' : 'Penerimaan',
    [FIELD_LABELS.kelompokBelanja]: KELOMPOK_BELANJA_LABELS[t.kelompokBelanja] || '',
    [FIELD_LABELS.jumlah]: t.jumlah || 0,
    [FIELD_LABELS.penerima]: t.penerima || '',
    [FIELD_LABELS.nipPenerima]: t.nipPenerima || '',
    [FIELD_LABELS.jabatan]: t.jabatan || '',
    [FIELD_LABELS.lampiran]: t.lampiran ? 'Ya' : 'Tidak'
  };
}
function showImportFeedback(success, text){
  const feedback = document.getElementById('import-feedback');
  feedback.className = 'text-sm rounded px-3 py-2 no-print ' + (success ? 'bg-forest-100 text-forest' : 'bg-rust-100 text-rust');
  feedback.textContent = text;
  feedback.classList.remove('hidden');
}

/* =========================================================================
   IMPORT DATA (CSV / Excel — bebas tipe file, kolom sama seperti form
   Tambah Transaksi; scoped ke npsn sendiri; tidak menyentuh saldo langsung)
   ========================================================================= */
document.getElementById('input-import-csv').addEventListener('change', (e)=>{
  const file = e.target.files[0];
  if(!file) return;
  const ext = (file.name.split('.').pop()||'').toLowerCase();

  const finishImport = async (rawRows)=>{
    const tahapImport = state.tahapAktif || getDefaultTahap();
    const jenisDanaImport = state.jenisDanaAktif || getDefaultJenisDana();
    if(isTahapTerkunci(tahapImport)){
      showImportFeedback(false, `${TAHAP_PERIODE[tahapImport].label} sedang terkunci. Buka kunci tahap terlebih dahulu untuk mengimpor data.`);
      e.target.value = '';
      return;
    }
    if(!rawRows || !rawRows.length){
      showImportFeedback(false, 'File kosong atau tidak dapat dibaca.');
      e.target.value = '';
      return;
    }

    const headerKeyMap = buildHeaderKeyMap();
    const foundKeys = new Set();
    Object.keys(rawRows[0]).forEach(h=>{
      const k = headerKeyMap[normalizeHeader(h)];
      if(k) foundKeys.add(k);
    });
    const missing = REQUIRED_FIELDS.filter(f=>!foundKeys.has(f));
    if(missing.length){
      showImportFeedback(false, 'Kolom wajib tidak ditemukan: ' + missing.map(f=>FIELD_LABELS[f]).join(', ') + '. Gunakan tombol "Unduh Template" agar format kolom sama seperti form "+ Transaksi".');
      e.target.value = '';
      return;
    }

    const npsn = state.userData.npsn;
    const updates = {};
    let validCount = 0, skipped = 0, skippedBedaTahap = 0;
    rawRows.forEach(row=>{
      const f = mapRowToFields(row, headerKeyMap);
      const tanggal = parseTanggalFleksibel(f.tanggal);
      const uraian = String(f.uraian||'').trim();
      const jumlah = Number(String(f.jumlah==null?'':f.jumlah).replace(/[^\d.-]/g,'')) || 0;
      if(!tanggal || !uraian){ skipped++; return; }
      // Lewati baris yang tanggalnya di luar periode tahap aktif, agar tidak
      // tercampur dengan data tahap lain saat impor.
      if(!bulanDalamTahap(tanggal, tahapImport)){ skippedBedaTahap++; return; }
      const jenis = String(f.jenis||'').toLowerCase().includes('peng') ? 'pengeluaran' : 'penerimaan';
      const newId = db.ref('transaksi_bku/'+npsn).push().key;
      updates[newId] = {
        tanggal,
        kode: String(f.kode||'').trim(),
        noBukti: String(f.noBukti||'').trim(),
        kodeProgram: String(f.kodeProgram||'').trim(),
        kodeRekening: String(f.kodeRekening||'').trim(),
        uraian,
        kualitas: String(f.kualitas||'').trim(),
        satuan: String(f.satuan||'').trim(),
        jenis,
        kelompokBelanja: kelompokBelanjaKeFromLabel(f.kelompokBelanja),
        jumlah,
        penerima: String(f.penerima||'').trim(),
        nipPenerima: String(f.nipPenerima||'').trim(),
        jabatan: String(f.jabatan||'').trim(),
        lampiran: /^(ya|yes|true|1)$/i.test(String(f.lampiran||'').trim()),
        jenisDana: jenisDanaImport,
        createdAt: Date.now()
      };
      validCount++;
    });

    if(validCount===0){
      const alasanTahap = skippedBedaTahap ? ` ${skippedBedaTahap} baris berada di luar periode ${TAHAP_PERIODE[tahapImport].label} sehingga dilewati. Jika tanggal pada file Anda memang termasuk periode lain, klik tab tahap yang sesuai (${TAHAP_PERIODE['1'].label} / ${TAHAP_PERIODE['2'].label}) lalu import ulang file yang sama.` : '';
      showImportFeedback(false, 'Tidak ada baris valid untuk diimpor. Pastikan kolom Tanggal, Uraian, dan Jumlah (Rp) terisi, dan tanggal berada pada periode tahap aktif.' + alasanTahap);
      e.target.value = '';
      return;
    }

    try{
      await db.ref('transaksi_bku/'+npsn).update(updates);
      logAudit('Buku Kas Umum', 'import', `Import ${validCount} transaksi ke ${JENIS_DANA[jenisDanaImport].label} — ${TAHAP_PERIODE[tahapImport].label} dari berkas ${file.name}`);
      const catatan = [];
      if(skipped) catatan.push(skipped+' baris dilewati karena data tidak lengkap');
      if(skippedBedaTahap) catatan.push(skippedBedaTahap+' baris dilewati karena di luar periode '+TAHAP_PERIODE[tahapImport].label);
      showImportFeedback(true, `${validCount} transaksi berhasil diimpor ke bagian ${JENIS_DANA[jenisDanaImport].label} — ${TAHAP_PERIODE[tahapImport].label}${catatan.length? ' ('+catatan.join('; ')+')':''}. Saldo dihitung ulang otomatis.`);
    }catch(err){
      showImportFeedback(false, 'Gagal mengimpor transaksi: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
    }
    e.target.value = '';
  };

  if(ext==='csv'){
    Papa.parse(file, { header:true, skipEmptyLines:true, complete: (results)=>finishImport(results.data) });
  } else if(ext==='xlsx' || ext==='xls'){
    const reader = new FileReader();
    reader.onload = (evt)=>{
      try{
        const wb = XLSX.read(evt.target.result, { type:'array', cellDates:true });
        const sheet = wb.Sheets[wb.SheetNames[0]];
        const rows = XLSX.utils.sheet_to_json(sheet, { defval:'' });
        finishImport(rows);
      }catch(err){
        showImportFeedback(false, 'Gagal membaca file Excel: ' + (err.message || 'format tidak dikenali.'));
        e.target.value = '';
      }
    };
    reader.onerror = ()=>{
      showImportFeedback(false, 'Gagal membaca file.');
      e.target.value = '';
    };
    reader.readAsArrayBuffer(file);
  } else {
    showImportFeedback(false, 'Tipe file tidak didukung. Gunakan file .csv, .xlsx, atau .xls.');
    e.target.value = '';
  }
});

