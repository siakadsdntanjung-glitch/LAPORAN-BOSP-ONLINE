/* =========================================================================
   BUKU KAS UMUM — CRUD
   ========================================================================= */
function renderBKU(){
  syncTahapUI();
  syncJenisDanaUI();

  const readOnlyKepsek = state.userData.role === 'kepala_sekolah';
  const tahap = state.tahapAktif || getDefaultTahap();
  const jenisDana = state.jenisDanaAktif || getDefaultJenisDana();
  const terkunci = isTahapTerkunci(tahap);
  const bisaUbah = !readOnlyKepsek && !terkunci;

  // Hanya tampilkan transaksi pada periode tahap DAN jenis dana yang sedang
  // aktif, supaya data Tahap 1/2 dan data BOSP Reguler/BOS Kinerja/BOS
  // Afirmasi tidak tercampur pada satu tampilan BKU — dan supaya membuat
  // atau mereset SPJ salah satu jenis dana tidak menghapus data jenis dana lain.
  const txTahapIni = state.transactions.filter(t=>bulanDalamTahap(t.tanggal, tahap) && jenisDanaTransaksi(t)===jenisDana);

  const rows = txTahapIni.map(t=>{
    const isPenerimaan = t.jenis==='penerimaan';
    return `<tr class="align-top border-b border-black divide-x divide-black hover:bg-paper/60">
      <td class="py-2 px-3 whitespace-nowrap">${formatTanggal(t.tanggal)}</td>
      <td class="py-2 px-3">${escapeHtml(t.kode||'')}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(t.uraian||'')}</td>
      <td class="py-2 px-3">${escapeHtml(t.kualitas||'')}</td>
      <td class="py-2 px-3">${escapeHtml(t.satuan||'')}</td>
      <td class="py-2 px-3 text-right text-forest">${isPenerimaan? fmtRupiah(t.jumlah):''}</td>
      <td class="py-2 px-3 text-right text-rust">${!isPenerimaan? fmtRupiah(t.jumlah):''}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(t.penerima||'')}</td>
      <td class="py-2 px-3">${escapeHtml(t.nipPenerima||'')}</td>
      <td class="py-2 px-3 text-right font-semibold">${fmtRupiah(t._saldo)}</td>
      <td class="py-2 px-3 no-print space-x-2">
        ${bisaUbah ? `
        <button data-id="${t.id}" class="btn-edit-tx text-navy-400 hover:text-navy text-xs font-semibold font-sans">Ubah</button>
        <button data-id="${t.id}" class="btn-hapus-tx text-rust hover:underline text-xs font-semibold font-sans">Hapus</button>
        ` : `<span class="text-navy-300 text-xs font-sans">—</span>`}
      </td>
    </tr>`;
  }).join('');

  document.getElementById('tbl-bku').innerHTML = rows || `<tr><td colspan="11" class="py-8 text-center text-navy-300 font-sans">Belum ada transaksi ${escapeHtml(JENIS_DANA[jenisDana].label)} pada ${escapeHtml(TAHAP_PERIODE[tahap].label)}. ${bisaUbah ? 'Klik "+ Transaksi" untuk menambahkan.' : ''}</td></tr>`;

  document.querySelectorAll('.btn-edit-tx').forEach(b=>b.addEventListener('click', ()=>openTransaksiModal(b.dataset.id)));
  document.querySelectorAll('.btn-hapus-tx').forEach(b=>b.addEventListener('click', async ()=>{
    if(isTahapTerkunci(state.tahapAktif)){
      alertFix(`${TAHAP_PERIODE[state.tahapAktif].label} sedang terkunci. Buka kunci tahap terlebih dahulu untuk menghapus transaksi.`);
      return;
    }
    if(confirmFix('Hapus transaksi ini?')){
      try{
        const txHapus = state.transactions.find(x=>x.id===b.dataset.id);
        await db.ref('transaksi_bku/'+state.userData.npsn+'/'+b.dataset.id).remove();
        logAudit('Buku Kas Umum', 'hapus', `Hapus transaksi ${formatTanggal(txHapus&&txHapus.tanggal)} — ${(txHapus&&txHapus.uraian)||''} (${fmtRupiah(txHapus&&txHapus.jumlah)})`);
      }catch(err){
        alertFix('Gagal menghapus transaksi: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
      }
    }
  }));

  // Tombol "+ Transaksi" & "Import Data" nonaktif bila tahap aktif sedang terkunci
  const btnTambah = document.getElementById('btn-tambah-transaksi');
  const btnImportLabel = document.getElementById('input-import-csv').closest('label');
  if(btnTambah){
    btnTambah.disabled = !bisaUbah;
    btnTambah.classList.toggle('opacity-40', !bisaUbah);
    btnTambah.classList.toggle('cursor-not-allowed', !bisaUbah);
  }
  if(btnImportLabel){
    btnImportLabel.classList.toggle('opacity-40', !bisaUbah);
    btnImportLabel.classList.toggle('cursor-not-allowed', !bisaUbah);
