function recomputeSaldo(){
  let saldo = 0;
  state.transactions.forEach(t=>{
    if(t.jenis==='penerimaan') saldo += Number(t.jumlah)||0;
    else saldo -= Number(t.jumlah)||0;
    t._saldo = saldo;
  });
}

/* =========================================================================
   DASHBOARD SEKOLAH
   ========================================================================= */
function renderDashboardSekolah(){
  const s = state.schoolData || {};
  const saldoAwal = Number(s.saldoAwal)||0;
  const totalPenerimaan = state.transactions.filter(t=>t.jenis==='penerimaan').reduce((sum,t)=>sum+(Number(t.jumlah)||0),0);
  const totalPengeluaran = state.transactions.filter(t=>t.jenis==='pengeluaran').reduce((sum,t)=>sum+(Number(t.jumlah)||0),0);
  const saldo = saldoAwal + totalPenerimaan - totalPengeluaran;

  document.getElementById('stat-saldo').textContent = fmtRupiah(saldo);
  document.getElementById('stat-penerimaan').textContent = fmtRupiah(totalPenerimaan);
  document.getElementById('stat-pengeluaran').textContent = fmtRupiah(totalPengeluaran);
  document.getElementById('stat-saldo-awal-note').textContent = saldoAwal>0 ? `Termasuk Saldo Awal/SILPA ${fmtRupiah(saldoAwal)}` : '';

  // ---- Realisasi terhadap Pagu/Alokasi BOSP resmi (Tahap Aktif) ----
  const tahapAktif = state.tahapAktif || getDefaultTahap();
  const pagu = Number(tahapAktif==='2' ? s.paguTahap2 : s.paguTahap1)||0;
  const pengeluaranTahap = state.transactions
    .filter(t=>t.jenis==='pengeluaran' && bulanDalamTahap(t.tanggal, tahapAktif))
    .reduce((sum,t)=>sum+(Number(t.jumlah)||0),0);
  const persenPagu = pagu>0 ? Math.min(100, Math.round((pengeluaranTahap/pagu)*100)) : 0;
  document.getElementById('stat-pagu-tahap-label').textContent = `— ${TAHAP_PERIODE[tahapAktif].short}`;
  document.getElementById('stat-pagu-nominal').textContent = fmtRupiah(pagu);
  document.getElementById('stat-pagu-bar').style.width = persenPagu+'%';
  document.getElementById('stat-pagu-persen').textContent = pagu>0
    ? `${persenPagu}% terealisasi (${fmtRupiah(pengeluaranTahap)})`
    : `Realisasi tahap ini: ${fmtRupiah(pengeluaranTahap)}`;
  document.getElementById('stat-pagu-sisa').textContent = `Sisa pagu: ${fmtRupiah(Math.max(0, pagu-pengeluaranTahap))}`;
  document.getElementById('stat-pagu-kosong').classList.toggle('hidden', pagu>0);
  document.getElementById('stat-pagu-bar').classList.toggle('bg-rust', pagu>0 && pengeluaranTahap>pagu);
  document.getElementById('stat-pagu-bar').classList.toggle('bg-gold-400', !(pagu>0 && pengeluaranTahap>pagu));

  renderStatusPaguJenisDana(tahapAktif);
  renderProgresJenisDana(tahapAktif);
  renderChartKelompokBelanja();

  document.getElementById('dashboard-profil').innerHTML = `
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Nama Sekolah</dt><dd class="mt-0.5">${escapeHtml(s.namaSekolah||'—')}</dd></div>
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">NPSN</dt><dd class="mt-0.5 font-mono">${escapeHtml(s.npsn||'—')}</dd></div>
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Alamat</dt><dd class="mt-0.5">${escapeHtml(s.alamat||'—')}</dd></div>
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Tahun Anggaran</dt><dd class="mt-0.5">${escapeHtml(s.tahunAnggaran||'—')}</dd></div>
  `;

  const extra = document.getElementById('kepsek-monitoring-extra');
  const isKepsek = state.userData && state.userData.role === 'kepala_sekolah';
  extra.classList.toggle('hidden', !isKepsek);
  if(!isKepsek) return;

  const bulanIni = todayStr().slice(0,7); // 'YYYY-MM'
  const txBulanIni = state.transactions.filter(t=>(t.tanggal||'').slice(0,7)===bulanIni);
  document.getElementById('stat-kepsek-jml-bulan').textContent = txBulanIni.length;

  const pengeluaranBulanIni = txBulanIni.filter(t=>t.jenis==='pengeluaran');
  const lengkapSpj = pengeluaranBulanIni.filter(t=>t.noBukti).length;
  const persenSpj = pengeluaranBulanIni.length>0 ? Math.round((lengkapSpj/pengeluaranBulanIni.length)*100) : null;
  document.getElementById('stat-kepsek-spj').textContent = persenSpj===null ? '—' : `${persenSpj}% (${lengkapSpj}/${pengeluaranBulanIni.length})`;

  const rec = state.persetujuan[bulanIni];
  const statusEl = document.getElementById('stat-kepsek-status-persetujuan');
  statusEl.innerHTML = (rec && rec.status==='disetujui')
    ? `<span class="text-forest bg-forest-100 text-xs font-semibold px-2 py-1 rounded">Sudah Disetujui</span>`
    : `<span class="text-gold-600 bg-gold-50 text-xs font-semibold px-2 py-1 rounded">Menunggu Persetujuan</span>`;

  const perKegiatan = {};
  state.transactions.filter(t=>t.jenis==='pengeluaran').forEach(t=>{
    const kode = t.kode || '(Tanpa Kode Kegiatan)';
    perKegiatan[kode] = (perKegiatan[kode]||0) + (Number(t.jumlah)||0);
  });
  const totalBelanja = Object.values(perKegiatan).reduce((s,v)=>s+v,0);
  const chartHtml = Object.entries(perKegiatan).sort((a,b)=>b[1]-a[1]).map(([kode,jumlah])=>{
    const persen = totalBelanja>0 ? Math.round((jumlah/totalBelanja)*100) : 0;
    return `
      <div>
        <div class="flex justify-between text-xs mb-1">
          <span class="font-medium text-navy truncate pr-2 font-mono">${escapeHtml(kode)}</span>
          <span class="text-navy-400 shrink-0">${fmtRupiah(jumlah)} (${persen}%)</span>
        </div>
        <div class="w-full h-2.5 bg-navy-50 rounded-full overflow-hidden">
          <div class="h-full bg-gold-400 rounded-full" style="width:${persen}%"></div>
        </div>
      </div>`;
  }).join('');
  document.getElementById('kepsek-chart-penyerapan').innerHTML = chartHtml || `<p class="text-sm text-navy-300 text-center py-4">Belum ada transaksi pengeluaran.</p>`;
}

/* ---- Data status realisasi per Jenis Dana BOSP (dipakai bareng oleh kartu
   "Realisasi Terhadap Pagu BOSP" — badge ringkas — dan kartu "Progres
   Realisasi per Jenis Dana BOSP" — progress bar detail). Satu sumber logika
   supaya kriteria "jenis dana yang ada" & perhitungan persentase selalu
   konsisten di kedua tempat. ---- */
function hitungStatusJenisDana(tahapAktif){
  const s = state.schoolData || {};
  const paguJd = s.paguJenisDana || {};
  const tahapKey = tahapAktif==='2' ? 'tahap2' : 'tahap1';

  return Object.keys(JENIS_DANA).filter(jd=>{
    const pagu = Number((paguJd[jd]||{})[tahapKey])||0;
    const punyaTransaksi = state.transactions.some(t=>jenisDanaTransaksi(t)===jd);
    return pagu>0 || punyaTransaksi;
  }).map(jd=>{
    const pagu = Number((paguJd[jd]||{})[tahapKey])||0;
    const realisasi = state.transactions
      .filter(t=>t.jenis==='pengeluaran' && bulanDalamTahap(t.tanggal, tahapAktif) && jenisDanaTransaksi(t)===jd)
      .reduce((sum,t)=>sum+(Number(t.jumlah)||0), 0);
    const persen = pagu>0 ? Math.min(100, Math.round((realisasi/pagu)*100)) : 0;
    const overBudget = pagu>0 && realisasi>pagu;
    return { jd, label: JENIS_DANA[jd].label, pagu, realisasi, persen, overBudget };
  });
}

/* ---- Status ringkas per Jenis Dana BOSP — badge kecil pada kartu
   "Realisasi Terhadap Pagu BOSP" ---- */
function renderStatusPaguJenisDana(tahapAktif){
  const wrap = document.getElementById('stat-pagu-status-jenisdana');
  if(!wrap) return;
  const data = hitungStatusJenisDana(tahapAktif);
  if(data.length===0){ wrap.innerHTML = ''; return; }

  wrap.innerHTML = data.map(d=>{
    let cls, teks;
    if(d.pagu<=0){
      cls = 'bg-navy-50 text-navy-400';
      teks = `${d.label}: pagu belum diisi`;
    } else if(d.overBudget){
      cls = 'bg-rust-100 text-rust';
      teks = `${d.label}: melebihi pagu`;
    } else if(d.persen>=100){
      cls = 'bg-forest-100 text-forest';
      teks = `${d.label}: 100% terealisasi`;
    } else {
      cls = 'bg-gold-50 text-gold-600';
      teks = `${d.label}: ${d.persen}% terealisasi`;
    }
    return `<span class="text-xs font-semibold px-2 py-1 rounded ${cls}">${escapeHtml(teks)}</span>`;
  }).join('');
}

/* ---- Progres Realisasi per Jenis Dana BOSP (Dashboard Sekolah) ----
   Menampilkan satu progress bar untuk tiap jenis dana BOSP (Reguler/Kinerja/
   Afirmasi) yang memang "ada" pada sekolah ini — yaitu yang pagu-nya sudah
   diisi (lihat Pagu per Jenis Dana BOSP di Profil Sekolah) DAN/ATAU sudah
   pernah dicatat transaksinya di BKU. Jenis dana yang pagunya kosong dan
   belum pernah ada transaksinya dianggap tidak diterima sekolah ini sehingga
   tidak ditampilkan, supaya kartu ini tidak dipenuhi baris kosong untuk
   BOS Kinerja/Afirmasi pada sekolah yang memang tidak menerimanya. ---- */
function renderProgresJenisDana(tahapAktif){
  const listEl = document.getElementById('progres-jenisdana-list');
  const labelEl = document.getElementById('progres-jenisdana-tahap-label');
  if(!listEl) return;
  if(labelEl) labelEl.textContent = `— ${TAHAP_PERIODE[tahapAktif].short}`;

  const data = hitungStatusJenisDana(tahapAktif);

  if(data.length===0){
    listEl.innerHTML = `<p class="text-sm text-navy-300 text-center py-4">Belum ada data jenis dana BOSP. Catat transaksi di Buku Kas Umum dan/atau isi Pagu per Jenis Dana BOSP di Profil Sekolah.</p>`;
    return;
  }

  listEl.innerHTML = data.map(d=>{
    const barColor = d.overBudget ? 'bg-rust' : 'bg-gold-400';
    const keteranganKanan = d.pagu>0
      ? `${d.persen}% dari pagu ${fmtRupiah(d.pagu)}`
      : `Pagu belum diisi`;
    return `
      <div>
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-sm mb-1">
          <span class="font-semibold text-navy">${escapeHtml(d.label)}</span>
          <span class="font-mono text-xs text-navy-400">${fmtRupiah(d.realisasi)}</span>
        </div>
        <div class="w-full h-2.5 bg-navy-50 rounded-full overflow-hidden">
          <div class="h-full ${barColor} rounded-full transition-all" style="width:${d.pagu>0 ? d.persen : 0}%"></div>
        </div>
        <div class="text-xs text-navy-400 mt-1">${escapeHtml(keteranganKanan)}</div>
      </div>`;
  }).join('');
}

/* ---- Grafik donat "Pengelompokan Belanja" (Dashboard Sekolah) ----
   Mengelompokkan seluruh transaksi pengeluaran berdasarkan field
   "kelompokBelanja" (sama seperti yang dipakai Kertas Kerja 2.2.1),
   lalu digambar sebagai donut chart SVG murni (tanpa library eksternal)
   plus legenda rincian nominal & persentase per kategori. ---- */
const KELOMPOK_BELANJA_COLORS = {
  atk: '#C8963E',
  jasa: '#3F759C',
  modal: '#2F6F4E',
  honor: '#B23A2E',
  kebersihan: '#9DB9CE',
  rumahtangga: '#EACB89',
  lainnya: '#B7BDC6'
};
function renderChartKelompokBelanja(){
  const svg = document.getElementById('svg-donut-kelompok');
  const legendEl = document.getElementById('legend-kelompok-belanja');
  const totalEl = document.getElementById('donut-total-belanja');
  if(!svg || !legendEl) return;

  // Mengikuti Tahap Laporan BOSP & Jenis Dana BOSP yang sedang aktif, sama
  // seperti Buku Kas Umum & Kertas Kerja 2.2.1, agar grafik tidak mencampur
  // realisasi antar tahap maupun antar jenis dana.
  const tahapAktifChart = state.tahapAktif || getDefaultTahap();
  const jenisDanaChart = state.jenisDanaAktif || getDefaultJenisDana();
  const labelTahapEl = document.getElementById('donut-tahap-label');
  if(labelTahapEl) labelTahapEl.textContent = `— ${JENIS_DANA[jenisDanaChart].short} — ${TAHAP_PERIODE[tahapAktifChart].short}`;

  const totals = {};
  state.transactions
    .filter(t=>t.jenis==='pengeluaran' && bulanDalamTahap(t.tanggal, tahapAktifChart) && jenisDanaTransaksi(t)===jenisDanaChart)
    .forEach(t=>{
      const key = (t.kelompokBelanja && KELOMPOK_BELANJA_LABELS[t.kelompokBelanja]) ? t.kelompokBelanja : 'lainnya';
      totals[key] = (totals[key]||0) + (Number(t.jumlah)||0);
    });
  const totalBelanja = Object.values(totals).reduce((s,v)=>s+v,0);
  if(totalEl) totalEl.textContent = fmtRupiah(totalBelanja);

  const urutan = ['atk','jasa','modal','honor','kebersihan','rumahtangga','lainnya'];
  const entries = urutan
    .filter(k=>totals[k]>0)
    .map(k=>({
      label: k==='lainnya' ? 'Belum Dikelompokkan' : KELOMPOK_BELANJA_LABELS[k],
      value: totals[k],
      color: KELOMPOK_BELANJA_COLORS[k]
    }))
    .sort((a,b)=>b.value-a.value);

  const R = 80, CIRC = 2*Math.PI*R;
  if(!entries.length){
    svg.innerHTML = `<circle cx="100" cy="100" r="${R}" fill="none" stroke="#EAF0F5" stroke-width="28"></circle>`;
    legendEl.innerHTML = `<p class="text-sm text-navy-300 text-center py-4">Belum ada transaksi pengeluaran yang dikelompokkan.</p>`;
    return;
  }

  let offset = 0;
  svg.innerHTML = entries.map(e=>{
    const frac = e.value/totalBelanja;
    const len = frac*CIRC;
    const seg = `<circle cx="100" cy="100" r="${R}" fill="none" stroke="${e.color}" stroke-width="28"
      stroke-dasharray="${len.toFixed(2)} ${(CIRC-len).toFixed(2)}" stroke-dashoffset="${(-offset).toFixed(2)}"></circle>`;
    offset += len;
    return seg;
  }).join('');

  legendEl.innerHTML = entries.map(e=>{
    const persen = totalBelanja>0 ? Math.round((e.value/totalBelanja)*100) : 0;
    return `
      <div class="flex items-center justify-between gap-3 text-sm">
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-3 h-3 rounded-full shrink-0" style="background:${e.color}"></span>
          <span class="text-navy truncate">${escapeHtml(e.label)}</span>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <span class="font-mono text-xs text-navy-400">${fmtRupiah(e.value)}</span>
          <span class="font-mono text-xs font-semibold text-navy w-10 text-right">${persen}%</span>
        </div>
      </div>`;
  }).join('');
}

