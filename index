  const baris = document.getElementById('pg-bulk').value.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
  const data = baris.map(l=>{
    const k = l.split(/\t|\||;/).map(x=>x.trim());
    return { nama:k[0]||'', nip:(k[1]||'').replace(/\s+/g,''), jabatan:k[2]||'', tugas:k[3]||'' };
  }).filter(r=>r.nama);
  if(!data.length){ alertFix('Tidak ada baris yang bisa dibaca. Format: Nama | NIP | Jabatan | Tugas'); return; }
  const sudah = new Set(getPegawaiList().map(p=>(p.nama||'').toLowerCase()+'|'+(p.nip||'')));
  const baru = data.filter(r=>!sudah.has(r.nama.toLowerCase()+'|'+r.nip));
  if(!baru.length){ alertFix('Semua nama pada daftar tersebut sudah ada di Data Pegawai.'); return; }
  const npsn = state.userData.npsn;
  const updates = {};
  baru.forEach(r=>{
    const key = db.ref('sekolah/'+npsn+'/pegawai').push().key;
    updates[key] = { ...r, createdAt: Date.now(), updatedAt: Date.now() };
  });
  try{
    await db.ref('sekolah/'+npsn+'/pegawai').update(updates);
    logAudit('Data Pegawai', 'tambah', `Tambah ${baru.length} pegawai sekaligus`);
    document.getElementById('pg-bulk').value = '';
    alertFix(`${baru.length} pegawai ditambahkan` + (data.length>baru.length ? ` (${data.length-baru.length} dilewati karena sudah ada).` : '.'));
