/* =========================================================================
   AUTH STATE ROUTER
   ========================================================================= */
auth.onAuthStateChanged(async (user)=>{
  if(justRegistered) return; // registration handler is driving the UI right now; don't race it
  // Tunggu hasil pengecekan versi minimum dulu. Jika versi di perangkat ini
  // sudah usang, runVersionCheck() sudah menampilkan view-update-required —
  // hentikan di sini agar layar login/app tidak menimpanya.
  const versionOk = await versionCheckDone;
  if(!versionOk) return;
  // Tetap di layar loading (bukan form login) selama status belum dipastikan,
  // supaya form login/daftar tidak sempat tampil bersamaan dengan layar lain.
  showView('view-loading');
  detachAllListeners();
  if(!user){
    state.user = null; state.userData = null; state.schoolData = null; state.transactions = []; state.cetakSelection.clear(); state.notifikasiAkun = {};
    // Reset ke tab "Masuk" & bersihkan pesan setiap kembali ke layar auth,
    // supaya form login/daftar sebelumnya tidak nyangkut di tab yang salah.
    resetAuthForm();
    showView('view-auth');
    return;
  }
  state.user = user;

  let userSnap;
  try{
    userSnap = await db.ref('users/'+user.uid).get();
  }catch(err){
    resetAuthForm();
    showView('view-auth');
    showAuthError('Gagal memuat data akun. Coba lagi.');
    await auth.signOut();
    return;
  }
  if(!userSnap.exists()){
    resetAuthForm();
    showView('view-auth');
    showAuthError('Akun tidak ditemukan pada basis data. Hubungi Admin Utama.');
    await auth.signOut();
    return;
  }
  const userData = userSnap.val();
  state.userData = userData;

  if(userData.role === 'admin_sekolah' && userData.status !== 'aktif'){
    const schoolSnap = await db.ref('sekolah/'+userData.npsn).get();
    const school = schoolSnap.val() || {};
    document.getElementById('pending-npsn').textContent = userData.npsn || '—';
    document.getElementById('pending-nama').textContent = school.namaSekolah || '—';
    showView('view-pending');
    return;
  }

  initAppForRole(userData);
});

