document.getElementById('btn-cetak-print').addEventListener('click', async ()=>{
  const ids = Array.from(state.cetakSelection);
  if(ids.length===0){ alertFix('Pilih minimal satu transaksi untuk dicetak.'); return; }
  const items = state.transactions.filter(t=>ids.includes(t.id));

  const docHeader = {
    nomor: document.getElementById('cetak-nomor').value.trim(),
    tanggal: document.getElementById('cetak-tanggal').value,
    namaPenyedia: document.getElementById('cetak-nama-penyedia').value.trim(),
    sebutanPenyedia: document.getElementById('cetak-sebutan-penyedia').value.trim(),
    alamatPenyedia: document.getElementById('cetak-alamat-penyedia').value.trim(),
    perihal: document.getElementById('cetak-perihal').value.trim()
  };

  if(state.cetakDoc === 'nota' || state.cetakDoc === 'bast'){
    if(!docHeader.nomor || !docHeader.tanggal || !docHeader.namaPenyedia){
      alertFix('Mohon lengkapi minimal Nomor Dokumen, Tanggal Dokumen, dan Nama Penyedia pada bagian "Detail Dokumen" di atas.');
      return;
    }
  }

  // Alternatif: jika tab Kwitansi dan opsi "gabungkan No. Bukti sama" dicentang,
  // transaksi-transaksi dengan No. Bukti yang sama dicetak sebagai satu kwitansi.
  // Untuk tiap grup, pengguna diminta mengonfirmasi/mengisi uraian umum (kop besar,
  // mis. "Belanja ATK") yang akan dimuat di kwitansi — rincian barang per baris
  // transaksi tidak akan dicetak, hanya uraian umum dan total uangnya.
  //
  // PENTING: penggabungan TIDAK dibatasi oleh checklist. Jika salah satu transaksi
  // yang dicentang punya No. Bukti "X", maka SEMUA transaksi pengeluaran dengan
  // No. Bukti "X" ikut digabung — walau sebagian besar dari transaksi itu tidak
  // dicentang di daftar. Ini juga yang tadinya menyebabkan kwitansi tercetak jadi
  // 2 dokumen terpisah: transaksi ber-No. Bukti sama yang tidak ikut tercentang
  // dulunya diperlakukan sebagai transaksi lepas (bukan bagian dari gabungan).
  let itemsCetak = items;
  const chkGabung = document.getElementById('chk-gabung-kwitansi');
  if(state.cetakDoc === 'kwitansi' && chkGabung && chkGabung.checked){
    const noBuktiTerpilih = new Set(items.map(t=>normalisasiNoBukti(t.noBukti)).filter(Boolean));
    const semuaPengeluaran = state.transactions.filter(t=>t.jenis==='pengeluaran');
    const anggotaGabungan = semuaPengeluaran.filter(t=>noBuktiTerpilih.has(normalisasiNoBukti(t.noBukti)));
    // Transaksi tercentang yang tidak punya No. Bukti tetap disertakan apa adanya
    // (tidak mungkin ikut digabung karena tidak ada kunci No. Bukti untuk dicocokkan).
    const tanpaNoBukti = items.filter(t=>!(t.noBukti||'').trim());
    const seen = new Set();
    const sumberGabungan = [...anggotaGabungan, ...tanpaNoBukti].filter(t=>{
      if(seen.has(t.id)) return false;
      seen.add(t.id); return true;
    });
    itemsCetak = await gabungkanTransaksiByNoBukti(sumberGabungan, async (noBukti, uraianOtomatis)=>{
      const masukan = await showPromptModal(
        `Uraian umum untuk kwitansi gabungan (No. Bukti "${noBukti||'-'}"):\n(Rincian barang tidak akan dicetak, hanya uraian ini dan totalnya.)`,
        uraianOtomatis
      );
      if(masukan === null) return uraianOtomatis; // dibatalkan -> pakai usulan otomatis
      return masukan.trim() || uraianOtomatis;
    });
  }

  buildPrintDocument(state.cetakDoc, itemsCetak, docHeader);
  window.print();
});

