function renderCetakList(){
  // Tab "Daftar Lampiran" hanya memuat transaksi BKU yang dicentang "Sertakan
  // pada menu Cetak Lampiran" di form Tambah Transaksi — bukan seluruh pengeluaran.
  //
  // Sama seperti tabel BKU, daftar cetak (Kwitansi/Nota/BAST/Lampiran) HARUS
  // dibatasi pada transaksi periode Tahap Laporan & Jenis Dana BOSP yang
  // sedang aktif saja. Tanpa filter ini, transaksi tahap/jenis dana lain
  // tercampur di satu daftar centang sehingga admin bisa salah pilih &
  // mencetak kwitansi dari tahap/jenis dana yang tidak sedang dikerjakan.
  const tahapAktifCetak = state.tahapAktif || getDefaultTahap();
  const jenisDanaAktifCetak = state.jenisDanaAktif || getDefaultJenisDana();
  const isLampiran = state.cetakDoc === 'lampiran';
  const list = (isLampiran
    ? state.transactions.filter(t=>t.lampiran)
    : state.transactions.filter(t=>t.jenis==='pengeluaran')
  ).filter(t=>bulanDalamTahap(t.tanggal, tahapAktifCetak) && jenisDanaTransaksi(t)===jenisDanaAktifCetak);

  // Buang id yang sudah dicentang tapi transaksinya sudah tidak ada lagi di
  // daftar ini (mis. terhapus/berubah jenis), supaya cetakSelection tidak
  // menumpuk id basi selamanya.
  const idsTersedia = new Set(list.map(t=>t.id));
  Array.from(state.cetakSelection).forEach(id=>{ if(!idsTersedia.has(id)) state.cetakSelection.delete(id); });

  const rows = list.map(t=>{
    const jmlPenerima = Array.isArray(t.lampiranPenerima) ? t.lampiranPenerima.length : 0;
    const labelPenerima = (isLampiran && jmlPenerima > 1) ? `${jmlPenerima} penerima` : (t.penerima||'');
    const checkedAttr = state.cetakSelection.has(t.id) ? 'checked' : '';
    return `
    <tr class="border-b border-navy-50">
      <td class="py-2 px-3"><input type="checkbox" class="chk-cetak" data-id="${t.id}" ${checkedAttr}></td>
      <td class="py-2 px-3 whitespace-nowrap">${formatTanggal(t.tanggal)}</td>
      <td class="py-2 px-3 font-sans whitespace-nowrap">${escapeHtml(t.noBukti||'-')}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(t.uraian||'')}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(labelPenerima)}</td>
      <td class="py-2 px-3 text-right">${fmtRupiah(t.jumlah)}</td>
    </tr>`;
  }).join('');
  const emptyMsg = isLampiran
    ? 'Belum ada transaksi yang ditandai untuk Lampiran. Centang "Sertakan pada menu Cetak Lampiran" pada form Tambah/Ubah Transaksi.'
    : 'Tidak ada transaksi pengeluaran.';
  document.getElementById('tbl-cetak-pilih').innerHTML = rows || `<tr><td colspan="6" class="py-6 text-center text-navy-300 font-sans">${emptyMsg}</td></tr>`;
}

