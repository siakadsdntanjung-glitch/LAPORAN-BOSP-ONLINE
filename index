/* ---- Pemeriksaan Kas (Berita Acara Opname Kas) ----
   Kontrol internal berkala: mencocokkan saldo Buku Kas Umum (dihitung otomatis
   dari Saldo Awal/SILPA + Penerimaan − Pengeluaran sampai tanggal pemeriksaan)
   dengan kas tunai fisik & saldo bank riil. Selisih dihitung otomatis dan
   ditonjolkan bila tidak nihil, sebagai bahan tindak lanjut sebelum laporan
   BOSP diserahkan ke Dinas Pendidikan. ---- */
function hitungSaldoBkuPadaTanggal(tanggalBatas){
  const s = state.schoolData || {};
  const saldoAwal = Number(s.saldoAwal)||0;
  if(!tanggalBatas) return saldoAwal;
  return state.transactions
    .filter(t=>(t.tanggal||'') <= tanggalBatas)
    .reduce((sum,t)=> sum + (t.jenis==='penerimaan' ? (Number(t.jumlah)||0) : -(Number(t.jumlah)||0)), saldoAwal);
}

function renderOpnameKas(){
  const rows = state.opnameKas.map(t=>{
    const totalRiil = (Number(t.kasTunai)||0) + (Number(t.kasBank)||0);
    const selisih = totalRiil - (Number(t.saldoBku)||0);
    const selisihCls = selisih===0 ? 'text-forest' : 'text-rust font-semibold';
    return `<tr class="border-b border-navy-50 hover:bg-paper/60">
      <td class="py-2 px-3 whitespace-nowrap">${formatTanggal(t.tanggal)}</td>
      <td class="py-2 px-3 text-right">${fmtRupiah(t.saldoBku)}</td>
      <td class="py-2 px-3 text-right">${fmtRupiah(t.kasTunai)}</td>
      <td class="py-2 px-3 text-right">${fmtRupiah(t.kasBank)}</td>
      <td class="py-2 px-3 text-right ${selisihCls}">${selisih===0?'Nihil':fmtRupiah(selisih)}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(t.keterangan||'—')}</td>
      <td class="py-2 px-3 no-print space-x-2 whitespace-nowrap">
        <button data-id="${t.id}" class="btn-cetak-opname text-gold-600 hover:underline text-xs font-semibold font-sans">Cetak BA</button>
        <button data-id="${t.id}" class="btn-edit-opname text-navy-400 hover:text-navy text-xs font-semibold font-sans">Ubah</button>
        <button data-id="${t.id}" class="btn-hapus-opname text-rust hover:underline text-xs font-semibold font-sans">Hapus</button>
      </td>
    </tr>`;
  }).join('');
  document.getElementById('tbl-opname').innerHTML = rows || `<tr><td colspan="7" class="py-8 text-center text-navy-300 font-sans">Belum ada catatan pemeriksaan kas.</td></tr>`;
  document.querySelectorAll('.btn-edit-opname').forEach(b=>b.addEventListener('click', ()=>openOpnameModal(b.dataset.id)));
  document.querySelectorAll('.btn-cetak-opname').forEach(b=>b.addEventListener('click', ()=>{
    const t = state.opnameKas.find(x=>x.id===b.dataset.id);
    if(t){ buildOpnameKasDocument(t); window.print(); }
  }));
  document.querySelectorAll('.btn-hapus-opname').forEach(b=>b.addEventListener('click', async ()=>{
    if(confirmFix('Hapus catatan pemeriksaan kas ini?')){
      try{
        const oHapus = state.opnameKas.find(x=>x.id===b.dataset.id);
        await db.ref('opname_kas/'+state.userData.npsn+'/'+b.dataset.id).remove();
        logAudit('Pemeriksaan Kas', 'hapus', `Hapus pemeriksaan kas ${formatTanggal(oHapus&&oHapus.tanggal)}`);
      }catch(err){
        alertFix('Gagal menghapus catatan pemeriksaan kas: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
      }
    }
  }));
}

