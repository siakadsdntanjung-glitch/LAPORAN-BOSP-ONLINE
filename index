  const jumlahBank = state.bukuBank.length;
  const jumlahPajak = state.bukuPajak.length;
  const jumlahOpname = state.opnameKas.length;
  const jumlahRkas = state.rkas.length;
  const waktu = new Date().toLocaleString('id-ID');
  el.textContent = `Data saat ini: ${jumlahTx} transaksi Buku Kas Umum, ${jumlahBank} catatan Buku Pembantu Bank, ${jumlahPajak} catatan Buku Pembantu Pajak, ${jumlahOpname} catatan Pemeriksaan Kas, ${jumlahRkas} Kegiatan RKAS. Diperiksa pada ${waktu}.`;
}

function unduhBlob(blob, namaFile){
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = namaFile;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}

async function susunBackupJson(){
  const npsn = state.userData.npsn;
  // Ambil data sekolah terbaru langsung dari database agar backup selalu akurat.
  const schoolSnap = await db.ref('sekolah/'+npsn).get();
  const bersihkanMeta = (arr)=> arr.reduce((acc,t)=>{
    const { _saldo, _saldoBank, _saldoKoran, _cocok, id, ...rest } = t;
    acc[id] = rest;
    return acc;
  }, {});
  return {
    _keterangan: 'Backup Database SIKEBOS (Sistem Keuangan BOSP)',
    _npsn: npsn,
    _namaSekolah: (schoolSnap.val()||{}).namaSekolah || '',
    _dibuatPada: new Date().toISOString(),
    sekolah: schoolSnap.val() || state.schoolData || {},
    transaksi_bku: bersihkanMeta(state.transactions),
    buku_bank: bersihkanMeta(state.bukuBank),
    buku_pajak: bersihkanMeta(state.bukuPajak),
    opname_kas: bersihkanMeta(state.opnameKas),
    rekening_koran: bersihkanMeta(state.rekeningKoran),
    rkas: bersihkanMeta(state.rkas),
    persetujuan: state.persetujuan || {}
  };
}

document.getElementById('btn-backup-json').addEventListener('click', async ()=>{
  const btn = document.getElementById('btn-backup-json');
  const teksAsli = btn.textContent;
  try{
    btn.disabled = true;
    const npsn = state.userData.npsn;
    // Ambil data sekolah terbaru langsung dari database agar backup selalu akurat.
    const backup = await susunBackupJson();
    const blob = new Blob([JSON.stringify(backup, null, 2)], { type:'application/json' });
    unduhBlob(blob, `backup-sikebos-${npsn}-${todayStr()}.json`);
