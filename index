          </button>
        </div>
      </div>
      <div class="p-4 sm:p-6" id="app-content">

        <!-- DASHBOARD ADMIN UTAMA -->
        <section id="page-dashboard-utama" class="page hidden space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <div class="bg-white rounded-lg border border-navy-100 p-5">
              <div class="text-xs font-semibold text-navy-400 uppercase tracking-wide">Sekolah Terdaftar</div>
              <div class="font-serif text-3xl font-semibold text-navy mt-2" id="stat-total-sekolah">0</div>
