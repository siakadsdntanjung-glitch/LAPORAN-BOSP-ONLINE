  const open = await isAdminUtamaSlotOpen();
  document.getElementById('reg-first-admin-banner').classList.toggle('hidden', !open);
  document.getElementById('reg-school-fields').classList.toggle('hidden', open);
  document.getElementById('btn-submit-register').textContent = open ? 'Daftar sebagai Admin Utama' : 'Daftar';
}

