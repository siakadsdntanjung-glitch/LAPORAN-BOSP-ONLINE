function addTimRow(p, data){
  data = data || {};
  const wrap = document.getElementById(p+'-rows');
  let row = null;
  if(data._fill){
    // isi baris kosong pertama (jabatan tim bawaan tetap terpakai)
    row = Array.from(wrap.querySelectorAll('.tm-row')).find(r=>!r.querySelector('.tm-nama').value.trim()) || null;
  }
  if(row){
    row.querySelector('.tm-nama').value = data.nama||'';
    row.querySelector('.tm-nip').value = data.nip||'';
    if(!row.querySelector('.tm-dinas').value.trim() && data.dinas) row.querySelector('.tm-dinas').value = data.dinas;
    return;
  }
  row = document.createElement('div');
  row.className = 'tm-row grid grid-cols-12 gap-1.5 items-center';
  row.innerHTML = `
    <input class="tm-nama col-span-3 rounded border border-navy-100 px-2 py-1.5 text-xs" placeholder="Nama">
    <input class="tm-nip col-span-2 rounded border border-navy-100 px-2 py-1.5 text-xs font-mono" placeholder="NIP">
    <input class="tm-hp col-span-2 rounded border border-navy-100 px-2 py-1.5 text-xs font-mono" placeholder="No. HP">
    <input class="tm-dinas col-span-2 rounded border border-navy-100 px-2 py-1.5 text-xs" placeholder="Guru">
    <input class="tm-tim col-span-2 rounded border border-navy-100 px-2 py-1.5 text-xs" list="${p}-tim-opsi" placeholder="Anggota">
    <button type="button" class="btn-hapus-tm col-span-1 text-rust hover:text-rust-600 text-base font-bold leading-none" title="Hapus baris ini">&times;</button>
  `;
  wrap.appendChild(row);
  row.querySelector('.tm-nama').value = data.nama||'';
  row.querySelector('.tm-nip').value = data.nip||'';
  row.querySelector('.tm-hp').value = data.hp||'';
  row.querySelector('.tm-dinas').value = data.dinas||'';
  row.querySelector('.tm-tim').value = data.tim||'';
  row.querySelector('.btn-hapus-tm').addEventListener('click', ()=>{ row.remove(); });
}
