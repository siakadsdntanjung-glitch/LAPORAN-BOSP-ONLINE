  const bkuRows = state.transactions.map(t=>{
    const isPenerimaan = t.jenis==='penerimaan';
    return `<tr>
      <td style="border:1px solid #16324F; padding:4px 5px; white-space:nowrap;">${formatTanggal(t.tanggal)}</td>
