/* =========================================================================
   TAHAP LAPORAN BOSP: Tahap 1 (Jan–Jun) & Tahap 2 (Jul–Des)
   Dipisah agar admin sekolah tidak salah mencampur data BKU antar tahap
   saat menyusun laporan bertahap. Disimpan pada /sekolah/{npsn}/tahapAktif
   & /sekolah/{npsn}/tahapKunci sehingga tersinkron di semua sesi/perangkat.
   ========================================================================= */
const TAHAP_PERIODE = {
  '1': { label:'Tahap 1 (Januari–Juni)', short:'Tahap 1', mulaiBulan:1, selesaiBulan:6 },
  '2': { label:'Tahap 2 (Juli–Desember)', short:'Tahap 2', mulaiBulan:7, selesaiBulan:12 }
};
function getDefaultTahap(){
  const bulanSekarang = new Date().getMonth()+1;
  return bulanSekarang <= 6 ? '1' : '2';
}
function bulanDalamTahap(tanggalIso, tahap){
  if(!tanggalIso) return false;
  const bln = Number(String(tanggalIso).slice(5,7));
  const p = TAHAP_PERIODE[tahap];
  if(!p || !bln) return false;
  return bln >= p.mulaiBulan && bln <= p.selesaiBulan;
}
function tahunAnggaranAktif(){
  const th = state.schoolData && Number(state.schoolData.tahunAnggaran);
  return th && th > 2000 ? th : new Date().getFullYear();
}
function rentangTanggalTahap(tahap){
  const tahun = tahunAnggaranAktif();
  const p = TAHAP_PERIODE[tahap];
  const min = `${tahun}-${String(p.mulaiBulan).padStart(2,'0')}-01`;
  const akhirTgl = new Date(tahun, p.selesaiBulan, 0).getDate();
  const max = `${tahun}-${String(p.selesaiBulan).padStart(2,'0')}-${String(akhirTgl).padStart(2,'0')}`;
  return { min, max };
}
