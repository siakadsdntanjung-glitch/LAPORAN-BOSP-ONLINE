async function isAdminUtamaSlotOpen(){
  // /meta/adminUtamaExists is publicly readable (see database.rules.json) so this
  // works even before the person is signed in. Absent or false = slot still open.
  try{
    const snap = await db.ref('meta/adminUtamaExists').get();
    return snap.val() !== true;
  }catch(err){
    return false; // if we can't confirm, don't offer the shortcut — fall back to normal flow
  }
}

