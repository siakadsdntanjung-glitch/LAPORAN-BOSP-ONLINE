/* ---- Modal Detail Sekolah (Admin Utama): ringkasan lengkap satu sekolah,
   mirip dashboard yang dilihat Admin Sekolah, dirender dari data yang sudah
   dimuat attachAdminUtamaListeners() (state.allSchools/allUsers/allTransactions)
   — tidak melakukan pembacaan Firebase tambahan. ---- */
function openDetailSekolah(npsn){
  if(!npsn) return;
  const s = (state.allSchools && state.allSchools[npsn]) || {};
  const users = state.allUsers || {};
  const owner = Object.values(users).find(u=>u.npsn===npsn && u.role==='admin_sekolah');
  const status = owner ? owner.status : 'pending';
  const txMap = (state.allTransactions && state.allTransactions[npsn]) || {};
  const txList = Object.values(txMap).sort((a,b)=>(b.updatedAt||b.createdAt||0)-(a.updatedAt||a.createdAt||0));

  const totalPenerimaan = txList.filter(t=>t.jenis==='penerimaan').reduce((sum,t)=>sum+(Number(t.jumlah)||0),0);
  const totalPengeluaran = txList.filter(t=>t.jenis==='pengeluaran').reduce((sum,t)=>sum+(Number(t.jumlah)||0),0);
  const saldoAwal = Number(s.saldoAwal)||0;
  const saldo = saldoAwal + totalPenerimaan - totalPengeluaran;
  const pengeluaranList = txList.filter(t=>t.jenis==='pengeluaran');
  const lengkapSpj = pengeluaranList.filter(t=>t.noBukti).length;
  const persenSpj = pengeluaranList.length>0 ? Math.round((lengkapSpj/pengeluaranList.length)*100) : null;
  const kepsek = s.kepsek || {};
  const bendahara = s.bendahara || {};

  const statusBadge = status==='aktif'
    ? `<span class="text-forest bg-forest-100 text-xs font-semibold px-2 py-1 rounded">Aktif</span>`
    : status==='nonaktif'
      ? `<span class="text-rust bg-rust-100 text-xs font-semibold px-2 py-1 rounded">Non-Aktif</span>`
      : `<span class="text-gold-600 bg-gold-50 text-xs font-semibold px-2 py-1 rounded">Menunggu</span>`;
  const aksesBadge = s.aksesDikunci===true
    ? `<span class="text-rust bg-rust-100 text-xs font-semibold px-2 py-1 rounded ml-1">🔒 Menu Terkunci</span>` : '';

  document.getElementById('modal-detail-sekolah-title').textContent = s.namaSekolah || npsn;
  document.getElementById('modal-detail-sekolah-sub').innerHTML =
    `NPSN <span class="font-mono">${escapeHtml(npsn)}</span> &nbsp; ${statusBadge}${aksesBadge}`;

  document.getElementById('detail-sekolah-stat-saldo').textContent = fmtRupiah(saldo);
  document.getElementById('detail-sekolah-stat-penerimaan').textContent = fmtRupiah(totalPenerimaan);
  document.getElementById('detail-sekolah-stat-pengeluaran').textContent = fmtRupiah(totalPengeluaran);
  document.getElementById('detail-sekolah-stat-transaksi').textContent = txList.length;

  document.getElementById('detail-sekolah-profil').innerHTML = `
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Nama Sekolah</dt><dd class="mt-0.5">${escapeHtml(s.namaSekolah||'—')}</dd></div>
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">NPSN</dt><dd class="mt-0.5 font-mono">${escapeHtml(npsn||'—')}</dd></div>
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Jenjang</dt><dd class="mt-0.5">${escapeHtml(s.jenjang||'—')}</dd></div>
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Alamat</dt><dd class="mt-0.5">${escapeHtml(s.alamat||'—')}</dd></div>
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Tahun Anggaran</dt><dd class="mt-0.5">${escapeHtml(s.tahunAnggaran||'—')}</dd></div>
  `;

  document.getElementById('detail-sekolah-pejabat').innerHTML = `
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Kepala Sekolah</dt><dd class="mt-0.5">${escapeHtml(kepsek.nama||'—')}${kepsek.nip?` <span class="text-navy-400 font-mono">(NIP ${escapeHtml(kepsek.nip)})</span>`:''}</dd></div>
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Bendahara BOSP</dt><dd class="mt-0.5">${escapeHtml(bendahara.nama||'—')}${bendahara.nip?` <span class="text-navy-400 font-mono">(NIP ${escapeHtml(bendahara.nip)})</span>`:''}</dd></div>
  `;

  document.getElementById('detail-sekolah-stat-spj').innerHTML = persenSpj===null
    ? '<span class="text-navy-300">—</span>'
    : `<span class="${persenSpj===100?'text-forest':'text-gold-600'} font-semibold">${persenSpj}%</span> <span class="text-navy-400">(${lengkapSpj}/${pengeluaranList.length})</span>`;

  const pagu1 = Number(s.paguTahap1)||0, pagu2 = Number(s.paguTahap2)||0;
  document.getElementById('detail-sekolah-pagu').innerHTML = (pagu1||pagu2) ? `
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Pagu Tahap 1</dt><dd class="mt-0.5 font-mono">${fmtRupiah(pagu1)}</dd></div>
    <div><dt class="text-xs text-navy-400 uppercase font-semibold">Pagu Tahap 2</dt><dd class="mt-0.5 font-mono">${fmtRupiah(pagu2)}</dd></div>
  ` : `<p class="text-sm text-navy-300 col-span-2">Pagu BOSP belum diisi.</p>`;

  const recentTx = txList.slice(0,10);
  const txRows = recentTx.map(t=>{
    const jenisLabel = t.jenis==='penerimaan'
      ? `<span class="text-forest font-semibold">Penerimaan</span>` : `<span class="text-rust font-semibold">Pengeluaran</span>`;
    return `<tr class="border-b border-navy-50">
      <td class="py-2 pr-4 font-mono">${escapeHtml(t.tanggal||'—')}</td>
      <td class="py-2 pr-4">${escapeHtml(t.uraian||'—')}</td>
      <td class="py-2 pr-4">${jenisLabel}</td>
      <td class="py-2 pr-4 text-right font-mono">${fmtRupiah(t.jumlah)}</td>
    </tr>`;
  }).join('');
  document.getElementById('detail-sekolah-tbl-transaksi').innerHTML = txRows || `<tr><td colspan="4" class="py-4 text-center text-navy-300">Belum ada transaksi tercatat.</td></tr>`;
  document.getElementById('detail-sekolah-tx-note').textContent = txList.length>10
    ? `Menampilkan 10 transaksi terbaru dari total ${txList.length} transaksi.` : '';

  document.getElementById('modal-detail-sekolah').classList.remove('hidden');
}
