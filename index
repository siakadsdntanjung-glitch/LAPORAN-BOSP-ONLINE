/* =========================================================================
   DATA PEGAWAI — master nama/NIP/jabatan per sekolah. Disimpan di
   sekolah/{npsn}/pegawai (ikut tersinkron lewat listener schoolRef dan
   otomatis tercakup aturan akses data sekolah yang sudah ada). Dipakai sebagai
   daftar centang pada "Daftar Penerima Lampiran" di form transaksi.
   ========================================================================= */
function getPegawaiList(){
  const raw = (state.schoolData && state.schoolData.pegawai) || {};
  return Object.entries(raw)
    .map(([id,p])=>({id, ...p}))
    .sort((a,b)=> (a.nama||'').localeCompare(b.nama||'', 'id', {sensitivity:'base'}));
}
function resetFormPegawai(){
  document.getElementById('form-pegawai').reset();
  document.getElementById('pg-id').value = '';
  document.getElementById('pg-form-title').textContent = 'Tambah Pegawai';
  document.getElementById('btn-batal-pegawai').classList.add('hidden');
}
function renderPegawai(){
  const tbody = document.getElementById('tbl-pegawai');
  if(!tbody) return;
  const semua = getPegawaiList();
  const q = (document.getElementById('pg-cari').value||'').trim().toLowerCase();
  const list = q ? semua.filter(p=>(p.nama||'').toLowerCase().includes(q) || (p.nip||'').toLowerCase().includes(q)) : semua;
  document.getElementById('pg-count').textContent = semua.length ? `(${semua.length} orang)` : '';
  if(!list.length){
    tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-xs text-navy-300">${semua.length ? 'Tidak ada pegawai yang cocok.' : 'Belum ada data pegawai. Tambahkan lewat form di samping.'}</td></tr>`;
    return;
  }
  tbody.innerHTML = list.map((p,i)=>`
    <tr class="border-b border-navy-50 hover:bg-paper/60">
      <td class="py-2 px-2 text-navy-300">${i+1}</td>
      <td class="py-2 px-2 font-semibold text-navy">${escapeHtml(p.nama)}</td>
      <td class="py-2 px-2 font-mono text-xs">${escapeHtml(p.nip||'-')}</td>
      <td class="py-2 px-2 text-xs">${escapeHtml(p.jabatan||'-')}</td>
      <td class="py-2 px-2 text-xs">${escapeHtml(p.tugas||'-')}</td>
      <td class="py-2 px-2 whitespace-nowrap">
        <button type="button" class="btn-edit-pg text-xs font-semibold text-navy hover:underline mr-3" data-id="${p.id}">Ubah</button>
        <button type="button" class="btn-hapus-pg text-xs font-semibold text-rust hover:underline" data-id="${p.id}">Hapus</button>
      </td>
    </tr>`).join('');
  tbody.querySelectorAll('.btn-edit-pg').forEach(b=>b.addEventListener('click', ()=>{
    const p = getPegawaiList().find(x=>x.id===b.dataset.id);
    if(!p) return;
    document.getElementById('pg-id').value = p.id;
    document.getElementById('pg-nama').value = p.nama||'';
    document.getElementById('pg-nip').value = p.nip||'';
    document.getElementById('pg-jabatan').value = p.jabatan||'';
    document.getElementById('pg-tugas').value = p.tugas||'';
    document.getElementById('pg-form-title').textContent = 'Ubah Pegawai';
    document.getElementById('btn-batal-pegawai').classList.remove('hidden');
    document.getElementById('pg-nama').focus();
  }));
  tbody.querySelectorAll('.btn-hapus-pg').forEach(b=>b.addEventListener('click', async ()=>{
    const p = getPegawaiList().find(x=>x.id===b.dataset.id);
    if(!p) return;
    if(!confirmFix(`Hapus ${p.nama} dari Data Pegawai?\n\n(Transaksi lama yang sudah memakai nama ini tidak ikut berubah.)`)) return;
    try{
      await db.ref('sekolah/'+state.userData.npsn+'/pegawai/'+p.id).remove();
      logAudit('Data Pegawai', 'hapus', `Hapus pegawai ${p.nama}`);
      if(document.getElementById('pg-id').value === p.id) resetFormPegawai();
    }catch(err){
      alertFix('Gagal menghapus pegawai: ' + (err.message || 'Periksa koneksi internet Anda dan coba lagi.'));
    }
  }));
}
