const AUDIT_AKSI_LABEL = {
  tambah: 'Tambah', ubah: 'Ubah', hapus: 'Hapus', import: 'Import', reset: 'Reset',
  kunci: 'Kunci Tahap', 'buka-kunci': 'Buka Kunci', cocok: 'Cocokkan', 'cocok-otomatis': 'Cocokkan Otomatis',
  setujui: 'Setujui'
};
const AUDIT_AKSI_WARNA = {
  tambah: 'text-forest bg-forest-100', ubah: 'text-gold-600 bg-gold-50', hapus: 'text-rust bg-rust-100',
  import: 'text-navy bg-paper', reset: 'text-rust bg-rust-100', kunci: 'text-rust bg-rust-100',
  'buka-kunci': 'text-forest bg-forest-100', cocok: 'text-navy bg-paper', 'cocok-otomatis': 'text-navy bg-paper',
  setujui: 'text-forest bg-forest-100'
};

function isiFilterEntitasAudit(){
  const sel = document.getElementById('audit-filter-entitas');
  if(!sel) return;
  const nilaiTerpilih = sel.value;
  const entitasUnik = Array.from(new Set(state.auditTrail.map(a=>a.entitas).filter(Boolean))).sort();
  const opsiLama = Array.from(sel.options).map(o=>o.value);
  // Hanya bangun ulang daftar opsi bila memang berubah, supaya pilihan filter
  // pengguna tidak ter-reset setiap kali listener realtime lain memicu render ulang.
  const perluBangunUlang = entitasUnik.length !== (opsiLama.length-1) || entitasUnik.some(e=>!opsiLama.includes(e));
  if(perluBangunUlang){
    sel.innerHTML = '<option value="">Semua Menu</option>' + entitasUnik.map(e=>`<option value="${escapeHtml(e)}">${escapeHtml(e)}</option>`).join('');
    sel.value = opsiLama.includes(nilaiTerpilih) ? nilaiTerpilih : '';
  }
}

function ambilAuditTerfilter(){
  const dari = document.getElementById('audit-filter-dari').value;
  const sampai = document.getElementById('audit-filter-sampai').value;
  const entitas = document.getElementById('audit-filter-entitas').value;
  const kataKunci = document.getElementById('audit-filter-cari').value.trim().toLowerCase();
  return state.auditTrail.filter(a=>{
    const tanggalEntri = a.waktu ? new Date(a.waktu).toISOString().slice(0,10) : '';
    if(dari && tanggalEntri < dari) return false;
    if(sampai && tanggalEntri > sampai) return false;
    if(entitas && a.entitas !== entitas) return false;
    if(kataKunci){
      const gabung = `${a.user||''} ${a.keterangan||''}`.toLowerCase();
      if(!gabung.includes(kataKunci)) return false;
    }
    return true;
  });
}

function formatWaktuAudit(ms){
  if(!ms) return '-';
  return new Date(ms).toLocaleString('id-ID', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
}

function renderAuditTrail(){
  const tbl = document.getElementById('tbl-audit-trail');
  if(!tbl) return; // hanya ada pada nav Audit Trail (Admin Sekolah & Kepala Sekolah)
  isiFilterEntitasAudit();
  const data = ambilAuditTerfilter();
  const rows = data.map(a=>{
    const labelAksi = AUDIT_AKSI_LABEL[a.aksi] || a.aksi || '-';
    const warnaAksi = AUDIT_AKSI_WARNA[a.aksi] || 'text-navy bg-paper';
    return `<tr class="border-b border-navy-50 hover:bg-paper/60 align-top">
      <td class="py-2 px-3 whitespace-nowrap font-mono text-[12px]">${formatWaktuAudit(a.waktu)}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(a.user||'-')}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(a.peran||'-')}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(a.entitas||'-')}</td>
      <td class="py-2 px-3 font-sans"><span class="text-xs font-semibold px-2 py-1 rounded ${warnaAksi}">${escapeHtml(labelAksi)}</span></td>
      <td class="py-2 px-3 font-sans">${escapeHtml(a.keterangan||'')}</td>
    </tr>`;
  }).join('');
  tbl.innerHTML = rows || `<tr><td colspan="6" class="py-8 text-center text-navy-300 font-sans">${state.auditTrail.length===0 ? 'Belum ada aktivitas tercatat.' : 'Tidak ada aktivitas yang cocok dengan filter saat ini.'}</td></tr>`;
  const infoEl = document.getElementById('audit-jumlah-info');
  if(infoEl) infoEl.textContent = `Menampilkan ${data.length} dari ${state.auditTrail.length} aktivitas tercatat (maks. 500 terbaru).`;
}

