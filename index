    const tampil = q ? semua.filter(p=>(p.nama||'').toLowerCase().includes(q)) : semua;
    wrap.innerHTML = tampil.map(p=>{
      const sudah = ada.has((p.nama||'').toLowerCase());
      return `<label class="flex items-start gap-2 px-2.5 py-1.5 text-xs ${sudah?'opacity-50':'hover:bg-paper/60 cursor-pointer'}">
        <input type="checkbox" class="pg-cb mt-0.5 rounded border-navy-200" data-id="${p.id}" ${sudah?'disabled':''} ${terpilih.has(p.id)&&!sudah?'checked':''}>
