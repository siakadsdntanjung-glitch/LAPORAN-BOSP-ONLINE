  }
});

/* =========================================================================
   IMPOR DATABASE (dari berkas Backup Lengkap .json)
   - Hanya berkas dengan NPSN yang sama yang diterima.
   - Mode "Gabungkan": semua data berkas ditulis per ID; data lama yang tidak ada
     di berkas tetap utuh. Mode "Ganti seluruhnya": data disamakan dengan berkas.
   - Setelan yang dikelola Admin Utama (kunci akses, akun) tidak pernah ditimpa.
   - Seluruh penulisan memakai satu multi-path update (atomik: semua masuk atau
     tidak sama sekali), dan salinan backup data saat ini diunduh lebih dulu.
   ========================================================================= */
const IMPOR_KOLEKSI = [
  { node:'transaksi_bku', label:'Transaksi Buku Kas Umum', state:'transactions' },
  { node:'buku_bank', label:'Buku Pembantu Bank', state:'bukuBank' },
  { node:'buku_pajak', label:'Buku Pembantu Pajak', state:'bukuPajak' },
  { node:'opname_kas', label:'Pemeriksaan Kas', state:'opnameKas' },
  { node:'rekening_koran', label:'Rekening Koran', state:'rekeningKoran' },
  { node:'rkas', label:'Kegiatan RKAS', state:'rkas' }
];
const IMPOR_SEKOLAH_DILINDUNGI = ['npsn','adminUid','createdAt','aksesDikunci','aksesDikunciPesan','aksesDikunciOleh','aksesDikunciPada'];
let imporBerkas = null;

function imporIsObj(x){ return !!x && typeof x === 'object' && !Array.isArray(x); }
function imporJumlah(x){ return imporIsObj(x) ? Object.keys(x).length : 0; }

function imporTampilHasil(pesan, tipe){
  const el = document.getElementById('impor-hasil');
  el.textContent = pesan;
  el.className = 'text-sm rounded px-3 py-2 whitespace-pre-line ' +
    (tipe === 'ok' ? 'bg-forest-100 text-forest' : 'bg-rust-100 text-rust');
}
function imporReset(){
  imporBerkas = null;
  document.getElementById('impor-ringkasan').classList.add('hidden');
  document.getElementById('impor-opsi').classList.add('hidden');
  const b = document.getElementById('btn-impor-mulai');
  b.classList.add('hidden'); b.disabled = true;
}

function imporBangunUpdate(data, mode){
  const npsn = state.userData.npsn;
  const up = {};
  IMPOR_KOLEKSI.forEach(k=>{
    if(!(k.node in data)) return;
    const inc = imporIsObj(data[k.node]) ? data[k.node] : {};
    if(mode === 'ganti'){
      up[`${k.node}/${npsn}`] = imporJumlah(inc) ? inc : null;
    }else{
      Object.entries(inc).forEach(([id, rec])=>{ if(imporIsObj(rec)) up[`${k.node}/${npsn}/${id}`] = rec; });
    }
  });
  if('persetujuan' in data){
    const inc = imporIsObj(data.persetujuan) ? data.persetujuan : {};
    if(mode === 'ganti') up[`persetujuan/${npsn}`] = imporJumlah(inc) ? inc : null;
    else Object.entries(inc).forEach(([k, v])=>{ if(v != null) up[`persetujuan/${npsn}/${k}`] = v; });
  }
  if(imporIsObj(data.sekolah)){
    const sk = data.sekolah;
    Object.entries(sk).forEach(([k, v])=>{
      if(IMPOR_SEKOLAH_DILINDUNGI.includes(k) || v == null) return;
      if(mode === 'gabung' && imporIsObj(v)){
        Object.entries(v).forEach(([c, cv])=>{ if(cv != null) up[`sekolah/${npsn}/${k}/${c}`] = cv; });
      }else{
        up[`sekolah/${npsn}/${k}`] = v;
      }
    });
    if(mode === 'ganti'){
      Object.keys(state.schoolData || {}).forEach(k=>{
        if(IMPOR_SEKOLAH_DILINDUNGI.includes(k) || k in sk) return;
        up[`sekolah/${npsn}/${k}`] = null;
      });
    }
  }
  return up;
}

function imporRender(data){
  const sk = imporIsObj(data.sekolah) ? data.sekolah : {};
  const baris = [];
  IMPOR_KOLEKSI.forEach(k=>{
    baris.push([k.label, imporJumlah(data[k.node]), (state[k.state]||[]).length]);
  });
  baris.push(['Data Pegawai', imporJumlah(sk.pegawai), getPegawaiList().length]);
  baris.push(['SK Tersimpan', imporJumlah(sk.dokumenSK), getSkList().length]);
  baris.push(['Riwayat Persetujuan', imporJumlah(data.persetujuan), imporJumlah(state.persetujuan)]);
  const dibuat = data._dibuatPada ? new Date(data._dibuatPada).toLocaleString('id-ID') : '-';
  document.getElementById('impor-ringkasan').innerHTML = `
    <div class="border border-navy-100 rounded overflow-hidden">
      <div class="bg-paper px-3 py-2 text-xs text-navy-400">
        Berkas backup <b class="text-navy">${escapeHtml(data._namaSekolah || '-')}</b> (NPSN ${escapeHtml(data._npsn || '-')}) &middot; dibuat ${escapeHtml(dibuat)}
      </div>
      <table class="w-full text-sm">
        <thead><tr class="text-left text-xs uppercase text-navy-400 border-b border-navy-100">
          <th class="py-2 px-3">Data</th><th class="py-2 px-3 text-right">Di berkas</th><th class="py-2 px-3 text-right">Saat ini</th>
        </tr></thead>
        <tbody>${baris.map(r=>`<tr class="border-b border-navy-100 last:border-0">
          <td class="py-2 px-3">${r[0]}</td><td class="py-2 px-3 text-right font-mono">${r[1]}</td><td class="py-2 px-3 text-right font-mono text-navy-400">${r[2]}</td></tr>`).join('')}</tbody>
      </table>
    </div>`;
  document.getElementById('impor-ringkasan').classList.remove('hidden');
  document.getElementById('impor-opsi').classList.remove('hidden');
  const b = document.getElementById('btn-impor-mulai');
  b.classList.remove('hidden'); b.disabled = false;
}

document.getElementById('impor-file').addEventListener('change', async (ev)=>{
  const f = ev.target.files && ev.target.files[0];
  document.getElementById('impor-hasil').classList.add('hidden');
  imporReset();
  if(!f) return;
  let data;
  try{
    data = JSON.parse(await f.text());
  }catch(err){
    imporTampilHasil('Berkas tidak dapat dibaca. Pastikan yang dipilih adalah berkas Backup Lengkap (.json) dari SIKEBOS.', 'err');
    document.getElementById('impor-hasil').classList.remove('hidden');
    return;
  }
  const valid = imporIsObj(data) && (imporIsObj(data.sekolah) || IMPOR_KOLEKSI.some(k=>imporIsObj(data[k.node])));
  if(!valid){
    imporTampilHasil('Isi berkas bukan format Backup Lengkap SIKEBOS, sehingga tidak diimpor.', 'err');
    document.getElementById('impor-hasil').classList.remove('hidden');
    return;
  }
  if(String(data._npsn || '') !== String(state.userData.npsn)){
    imporTampilHasil(`Berkas ini berasal dari NPSN ${data._npsn || '(tidak diketahui)'}, sedangkan akun Anda NPSN ${state.userData.npsn}. Impor dibatalkan agar data sekolah tidak tercampur.`, 'err');
    document.getElementById('impor-hasil').classList.remove('hidden');
    return;
  }
  imporBerkas = { data, nama: f.name };
  imporRender(data);
});

document.getElementById('btn-impor-mulai').addEventListener('click', async ()=>{
  if(!imporBerkas) return;
  const mode = (document.querySelector('input[name="impor-mode"]:checked') || {}).value || 'gabung';
  const pesan = mode === 'ganti'
    ? 'Mode GANTI SELURUHNYA: data sekolah saat ini akan diganti persis sama dengan isi berkas, dan data yang tidak ada di berkas akan TERHAPUS.\n\nSalinan backup data saat ini akan diunduh lebih dulu. Lanjutkan?'
    : 'Mode GABUNGKAN: semua data dari berkas akan dimasukkan, data yang sudah ada tetap dipertahankan.\n\nSalinan backup data saat ini akan diunduh lebih dulu. Lanjutkan?';
  if(!confirmFix(pesan)) return;
  const btn = document.getElementById('btn-impor-mulai');
  btn.disabled = true;
  document.getElementById('impor-hasil').classList.add('hidden');
  try{
    const npsn = state.userData.npsn;
    // 1) Pengaman: unduh backup kondisi sekarang
    const sebelum = await susunBackupJson();
    unduhBlob(new Blob([JSON.stringify(sebelum, null, 2)], { type:'application/json' }),
      `backup-sebelum-impor-sikebos-${npsn}-${todayStr()}.json`);
    // 2) Tulis semua data dalam satu update atomik
    const up = imporBangunUpdate(imporBerkas.data, mode);
    const jumlahPath = Object.keys(up).length;
    if(!jumlahPath) throw new Error('Tidak ada data yang dapat diimpor dari berkas ini.');
    await db.ref().update(up);
    logAudit('Backup Database', 'impor', `Impor database dari ${imporBerkas.nama} (mode ${mode === 'ganti' ? 'ganti seluruhnya' : 'gabungkan'}, ${jumlahPath} entri)`);
    imporTampilHasil(`Impor berhasil (${mode === 'ganti' ? 'ganti seluruhnya' : 'gabungkan'}): ${jumlahPath} entri data dimasukkan. Salinan backup sebelum impor sudah terunduh di komputer Anda.`, 'ok');
    document.getElementById('impor-hasil').classList.remove('hidden');
    document.getElementById('impor-file').value = '';
    imporReset();
    renderBackupInfo();
  }catch(err){
    imporTampilHasil('Impor gagal, tidak ada data yang diubah: ' + (err.message || 'Periksa koneksi internet Anda dan coba lagi.'), 'err');
    document.getElementById('impor-hasil').classList.remove('hidden');
    btn.disabled = false;
  }
});

