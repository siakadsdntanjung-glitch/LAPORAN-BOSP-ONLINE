/* ---- Rekonsiliasi Bank: mencocokkan Buku Pembantu Bank dengan mutasi rekening koran ---- */
function renderRekonsiliasi(){
  const s = state.schoolData || {};

  // Hitung saldo berjalan rekening koran dari Saldo Awal + mutasi.
  let saldoKoran = Number(s.saldoAwalRekeningKoran)||0;
  state.rekeningKoran.forEach(t=>{
    if(t.jenis==='masuk') saldoKoran += Number(t.jumlah)||0; else saldoKoran -= Number(t.jumlah)||0;
    t._saldoKoran = saldoKoran;
  });

  // Tandai status cocok pada tiap catatan Buku Bank berdasarkan pencocokan
  // yang tersimpan di sisi Rekening Koran (field cocokBankId).
  state.bukuBank.forEach(b=> b._cocok = state.rekeningKoran.some(t=>t.cocokBankId===b.id));

  const rows = state.rekeningKoran.map(t=>{
    const isMasuk = t.jenis==='masuk';
    const cocok = !!t.cocokBankId;
    const statusBadge = cocok
      ? `<span class="text-forest bg-forest-100 text-xs font-semibold px-2 py-1 rounded">Cocok</span>`
      : `<span class="text-rust bg-rust-100 text-xs font-semibold px-2 py-1 rounded">Belum</span>`;
    const opsiBank = state.bukuBank
      .filter(b=> b.jenis===t.jenis && (!b._cocok || b.id===t.cocokBankId))
      .map(b=>`<option value="${b.id}" ${b.id===t.cocokBankId?'selected':''}>${formatTanggal(b.tanggal)} — ${escapeHtml(b.uraian||'')} (${fmtRupiah(b.jumlah)})</option>`).join('');
    return `<tr class="border-b border-navy-50 hover:bg-paper/60">
      <td class="py-2 px-3 whitespace-nowrap">${formatTanggal(t.tanggal)}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(t.uraian||'')}</td>
      <td class="py-2 px-3 text-right text-forest">${isMasuk? fmtRupiah(t.jumlah):''}</td>
      <td class="py-2 px-3 text-right text-rust">${!isMasuk? fmtRupiah(t.jumlah):''}</td>
      <td class="py-2 px-3 text-right font-semibold">${fmtRupiah(t._saldoKoran)}</td>
      <td class="py-2 px-3">${statusBadge}</td>
      <td class="py-2 px-3 font-sans no-print">
        <select data-id="${t.id}" class="sel-cocok-rekon text-xs rounded border border-navy-100 px-2 py-1 w-full bg-white">
          <option value="">— Pilih catatan Buku Bank —</option>
          ${opsiBank}
        </select>
      </td>
      <td class="py-2 px-3 no-print space-x-2 whitespace-nowrap">
        <button data-id="${t.id}" class="btn-edit-rekon text-navy-400 hover:text-navy text-xs font-semibold font-sans">Ubah</button>
        <button data-id="${t.id}" class="btn-hapus-rekon text-rust hover:underline text-xs font-semibold font-sans">Hapus</button>
      </td>
    </tr>`;
  }).join('');
  document.getElementById('tbl-rekon').innerHTML = rows || `<tr><td colspan="8" class="py-8 text-center text-navy-300 font-sans">Belum ada mutasi rekening koran. Tambahkan sesuai data mutasi/rekening koran dari bank.</td></tr>`;

  const belumBank = state.bukuBank.filter(b=>!b._cocok);
  const rowsBelum = belumBank.map(b=>{
    const isMasuk = b.jenis==='masuk';
    return `<tr class="border-b border-navy-50">
      <td class="py-2 px-3 whitespace-nowrap">${formatTanggal(b.tanggal)}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(b.uraian||'')}</td>
      <td class="py-2 px-3 text-right text-forest">${isMasuk? fmtRupiah(b.jumlah):''}</td>
      <td class="py-2 px-3 text-right text-rust">${!isMasuk? fmtRupiah(b.jumlah):''}</td>
    </tr>`;
  }).join('');
  document.getElementById('tbl-rekon-bank-belum').innerHTML = rowsBelum || `<tr><td colspan="4" class="py-6 text-center text-navy-300 font-sans">Semua catatan Buku Pembantu Bank sudah cocok.</td></tr>`;

  // Ringkasan kartu di atas.
  const saldoBukuAkhir = state.bukuBank.length ? state.bukuBank[state.bukuBank.length-1]._saldoBank : 0;
  const saldoKoranAkhir = state.rekeningKoran.length ? state.rekeningKoran[state.rekeningKoran.length-1]._saldoKoran : (Number(s.saldoAwalRekeningKoran)||0);
  const selisih = saldoBukuAkhir - saldoKoranAkhir;
  const belumCocokCount = belumBank.length + state.rekeningKoran.filter(t=>!t.cocokBankId).length;

  document.getElementById('rekon-saldo-buku').textContent = fmtRupiah(saldoBukuAkhir);
  document.getElementById('rekon-saldo-koran').textContent = fmtRupiah(saldoKoranAkhir);
  document.getElementById('rekon-belum-cocok').textContent = `${belumCocokCount} item`;
  const selisihEl = document.getElementById('rekon-selisih');
  selisihEl.textContent = fmtRupiah(selisih);
  selisihEl.classList.toggle('text-forest', selisih===0);
  selisihEl.classList.toggle('text-rust', selisih!==0);

  if(document.activeElement !== document.getElementById('rekon-saldo-awal')){
    document.getElementById('rekon-saldo-awal').value = s.saldoAwalRekeningKoran || 0;
  }

