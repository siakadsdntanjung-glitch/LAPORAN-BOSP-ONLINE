/* ---- Tombol "Buku Panduan" (sidebar desktop & menu mobile) ----
   Diisi dari config/panduanUrl di Firebase, supaya link-nya bisa diganti
   kapan saja (mis. saat rilis versi baru dengan panduan baru) tanpa perlu
   build ulang aplikasi. Tombol otomatis disembunyikan bila field ini
   kosong/belum diisi. ---- */
function updatePanduanLink(cfg){
  const url = (cfg.panduanUrl || '').trim();
  [document.getElementById('sidebar-panduan-link'), document.getElementById('mobile-panduan-link')].forEach(el=>{
    if(!el) return;
    if(url){
      el.href = url;
      el.classList.remove('hidden');
      el.classList.add('flex');
    } else {
      el.classList.add('hidden');
      el.classList.remove('flex');
    }
  });
}

function attachMaintenanceListener(){
  const ref = db.ref('config');
  const cb = snap=>{
    const cfg = snap.val() || {};

    // Tombol "Buku Panduan" di sidebar & menu mobile — dibaca dari
    // config/panduanUrl (sama seperti config/downloadUrl untuk update
    // banner), berlaku untuk semua role, realtime tanpa perlu reload.
    updatePanduanLink(cfg);

    if(state.userData && state.userData.role === 'admin_utama'){
      renderMaintenancePanel(cfg);
      return;
    }

    const aktif = cfg.maintenanceMode === true;
    if(aktif){
      document.getElementById('maintenance-pesan').textContent = (cfg.maintenanceMessage || '').trim()
        || 'SIKEBOS sedang dalam perbaikan/pemeliharaan sementara. Mohon coba kembali beberapa saat lagi.';
      showView('view-maintenance');
    } else if(document.getElementById('view-maintenance').classList.contains('active')){
      // Mode Perbaikan baru saja dinonaktifkan sementara pengguna masih di layar ini —
      // kembalikan otomatis ke dashboard masing-masing role.
      showView('view-app');
      navigateTo('dashboard-sekolah');
    }
  };
  ref.on('value', cb);
  state.listeners.push([ref,'value',cb]);
}

function renderMaintenancePanel(cfg){
  const badge = document.getElementById('maintenance-status-badge');
  const label = document.getElementById('maintenance-status-label');
  const btn = document.getElementById('btn-toggle-maintenance');
  if(!badge || !label || !btn) return; // panel belum ada di DOM (mis. belum login sebagai admin_utama)

  const aktif = cfg.maintenanceMode === true;
  badge.textContent = aktif ? 'AKTIF' : 'NONAKTIF';
  badge.className = 'text-xs font-semibold px-3 py-1 rounded-full whitespace-nowrap ' + (aktif ? 'bg-rust-100 text-rust' : 'bg-forest-100 text-forest');
  label.textContent = aktif
    ? 'Semua Admin Sekolah & Kepala Sekolah saat ini TIDAK BISA mengakses SIKEBOS.'
    : 'Semua pengguna dapat mengakses SIKEBOS seperti biasa.';
  btn.textContent = aktif ? 'Nonaktifkan Mode Perbaikan Server' : 'Aktifkan Mode Perbaikan Server';
  btn.classList.toggle('bg-rust', !aktif);
  btn.classList.toggle('bg-forest', aktif);

  // Jangan timpa draft pesan yang sedang diketik Admin Utama.
  const pesanInput = document.getElementById('maintenance-pesan-input');
  if(pesanInput && document.activeElement !== pesanInput){
    pesanInput.value = cfg.maintenanceMessage || '';
  }
}

