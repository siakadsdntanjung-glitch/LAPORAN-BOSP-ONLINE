function renderVerifikasiTable(){
  const users = state.allUsers || {};
  const schools = state.allSchools || {};
  const entries = Object.entries(users).filter(([uid,u])=>u.role==='admin_sekolah');

  const rows = entries.map(([uid,u])=>{
    const school = schools[u.npsn] || {};
    const statusBadge = u.status==='aktif'
      ? `<span class="text-forest bg-forest-100 text-xs font-semibold px-2 py-1 rounded">Aktif</span>`
      : u.status==='nonaktif'
        ? `<span class="text-rust bg-rust-100 text-xs font-semibold px-2 py-1 rounded">Non-Aktif</span>`
        : `<span class="text-gold-600 bg-gold-50 text-xs font-semibold px-2 py-1 rounded">Menunggu</span>`;

    const aksesTerkunci = school.aksesDikunci === true;
    const aksesBadge = aksesTerkunci
      ? `<span class="text-rust bg-rust-100 text-xs font-semibold px-2 py-1 rounded ml-1">🔒 Menu Terkunci</span>`
      : '';

    const actions = [];
    if(u.status !== 'aktif'){
      actions.push(`<button data-uid="${uid}" class="btn-aktifkan text-forest hover:underline text-xs font-semibold">Aktifkan</button>`);
    }
    if(u.status === 'aktif'){
      actions.push(`<button data-uid="${uid}" class="btn-nonaktifkan text-rust hover:underline text-xs font-semibold">Non-Aktifkan</button>`);
    }
    actions.push(`<button data-email="${u.email}" class="btn-reset-pass text-navy-400 hover:underline text-xs font-semibold">Reset Password</button>`);
    actions.push(`<button data-npsn="${escapeHtml(u.npsn||'')}" data-nama="${escapeHtml(school.namaSekolah||u.npsn||'')}" class="btn-notif-demo text-gold-600 hover:underline text-xs font-semibold">Notif Demo Selesai</button>`);
    if(aksesTerkunci){
      actions.push(`<button data-npsn="${escapeHtml(u.npsn||'')}" class="btn-buka-akses text-forest hover:underline text-xs font-semibold">Buka Kunci Akses</button>`);
    } else {
      actions.push(`<button data-npsn="${escapeHtml(u.npsn||'')}" class="btn-kunci-akses text-rust hover:underline text-xs font-semibold">Kunci Akses</button>`);
    }

    return `<tr class="border-b border-navy-50">
      <td class="py-3 px-4 font-mono">${u.npsn}</td>
      <td class="py-3 px-4">${school.namaSekolah ? btnNamaSekolah(u.npsn, school.namaSekolah) : escapeHtml('—')}</td>
      <td class="py-3 px-4">${escapeHtml(u.email||'')}</td>
      <td class="py-3 px-4">${statusBadge}${aksesBadge}</td>
      <td class="py-3 px-4 space-x-3 whitespace-nowrap">${actions.join('')}</td>
    </tr>`;
  }).join('');

  document.getElementById('tbl-verifikasi').innerHTML = rows || `<tr><td colspan="5" class="py-6 text-center text-navy-300">Belum ada pendaftaran.</td></tr>`;

  document.querySelectorAll('.btn-kunci-akses').forEach(b=>b.addEventListener('click', async ()=>{
    if(!confirmFix('Kunci akses menu untuk Admin Sekolah ini? Ia tidak akan bisa mengakses menu apa pun sampai Anda membuka kuncinya kembali. Kepala Sekolah (jika ada) tidak terpengaruh.')) return;
    try{
      await db.ref('sekolah/'+b.dataset.npsn).update({
        aksesDikunci: true,
        aksesDikunciOleh: (state.user && state.user.email) || 'admin_utama',
        aksesDikunciPada: Date.now()
      });
    }catch(err){
      alertFix('Gagal mengunci akses: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
    }
  }));
  document.querySelectorAll('.btn-buka-akses').forEach(b=>b.addEventListener('click', async ()=>{
    try{
      const npsn = b.dataset.npsn;
      await db.ref('sekolah/'+npsn).update({ aksesDikunci: false });
      // Sekaligus tandai semua notifikasi akun sekolah ini sebagai sudah dibaca,
      // supaya banner pemberitahuan (mis. "akun demo selesai") yang sebelumnya
      // dikirim otomatis hilang begitu akses dibuka kembali — Admin Sekolah tidak
      // perlu menutupnya manual lagi. Riwayat pesan tetap tersimpan di Firebase,
      // hanya statusnya yang diubah jadi dibaca:true (bukan dihapus).
      const notifSnap = await db.ref('notifikasi/'+npsn).get();
      const notifs = notifSnap.val() || {};
      const updates = {};
      Object.keys(notifs).forEach(id=>{ updates[id+'/dibaca'] = true; });
      if(Object.keys(updates).length){
        await db.ref('notifikasi/'+npsn).update(updates);
      }
    }catch(err){
      alertFix('Gagal membuka kunci akses: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
    }
  }));

  document.querySelectorAll('.btn-aktifkan').forEach(b=>b.addEventListener('click', async ()=>{
    try{
      await db.ref('users/'+b.dataset.uid+'/status').set('aktif');
    }catch(err){
      alertFix('Gagal mengaktifkan akun: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
    }
  }));
  document.querySelectorAll('.btn-nonaktifkan').forEach(b=>b.addEventListener('click', async ()=>{
    if(confirmFix('Non-aktifkan akun ini? Admin Sekolah tidak akan bisa mengakses sistem.')){
      try{
        await db.ref('users/'+b.dataset.uid+'/status').set('nonaktif');
      }catch(err){
        alertFix('Gagal menonaktifkan akun: ' + (err.message || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'));
      }
    }
  }));
  document.querySelectorAll('.btn-reset-pass').forEach(b=>b.addEventListener('click', async ()=>{
    try{
      await auth.sendPasswordResetEmail(b.dataset.email);
      alertFix('Email reset kata sandi telah dikirim ke ' + b.dataset.email);
    }catch(err){
      alertFix('Gagal mengirim email reset: ' + err.message);
    }
  }));
  document.querySelectorAll('.btn-notif-demo').forEach(b=>b.addEventListener('click', ()=>{
    openNotifDemoModal(b.dataset.npsn, b.dataset.nama);
  }));
}

