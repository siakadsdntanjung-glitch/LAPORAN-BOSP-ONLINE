          <tr><td style="padding:4px 0; vertical-align:top;">Untuk pembayaran</td><td style="vertical-align:top;">: ${escapeHtml(t.uraian||'')}</td></tr>
        </table>
        <table style="width:100%; border-collapse:collapse; font-size:14px; margin:14px 0;">
          <tr><td style="width:170px; padding:4px 0;">Terbilang</td><td>: <b>${fmtRupiah(t.jumlah)}</b></td></tr>
