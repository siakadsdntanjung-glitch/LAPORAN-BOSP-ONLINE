    // transaksi tersebut agar data lama tetap tercetak dengan benar.
    let total = 0;
    let rows = '';
    let no = 0;
    items.forEach(t=>{
      const daftar = (Array.isArray(t.lampiranPenerima) && t.lampiranPenerima.length)
        ? t.lampiranPenerima
        : [{ nama: t.penerima, nip: t.nipPenerima, jabatan: t.jabatan, jumlah: t.jumlah }];
      daftar.forEach(p=>{
        no++;
        total += Number(p.jumlah)||0;
        rows += `
        <tr style="page-break-inside:avoid;">
          <td style="border:1px solid #16324F; padding:5px 6px; height:40px; vertical-align:middle; text-align:center;">${no}</td>
          <td style="border:1px solid #16324F; padding:5px 6px; height:40px; vertical-align:middle;">${escapeHtml(p.nama||'-')}</td>
          <td style="border:1px solid #16324F; padding:5px 6px; height:40px; vertical-align:middle; text-align:center;">${escapeHtml(p.nip||'-')}</td>
          <td style="border:1px solid #16324F; padding:5px 6px; height:40px; vertical-align:middle;">${escapeHtml(p.jabatan||'-')}</td>
          <td style="border:1px solid #16324F; padding:5px 6px; height:40px; vertical-align:middle; text-align:right;">${fmtRupiah(p.jumlah)}</td>
          <td style="border:1px solid #16324F; padding:5px 6px; height:40px; vertical-align:middle;"></td>
        </tr>`;
      });
    });

    // Keterangan "LAMPIRAN KWITANSI BPU..." — memakai No. Bukti transaksi yang dicetak
    // (mis. BPU48). Bila ada beberapa No. Bukti berbeda, semuanya ditulis dipisah koma.
    // Bila tidak ada No. Bukti sama sekali, tetap tercetak "LAMPIRAN KWITANSI BPU".
    const daftarNoBukti = [];
    items.forEach(t=>{
      const nb = String(t.noBukti||'').trim();
      if(nb && !daftarNoBukti.includes(nb)) daftarNoBukti.push(nb);
    });
    const labelBpu = daftarNoBukti.length ? daftarNoBukti.join(', ') : 'BPU';

    bodyHtml = `
      <div style="${box.replace('page-break-inside:avoid;','')}">
        <div style="text-align:center; font-family:Lora,serif; font-weight:700; font-size:15px; letter-spacing:1px;">DAFTAR LAMPIRAN</div>
        <div style="text-align:center; font-family:Lora,serif; font-weight:700; font-size:13px; letter-spacing:0.5px; margin-top:2px; text-transform:uppercase;">LAMPIRAN KWITANSI ${escapeHtml(labelBpu)}</div>
        <div style="margin-bottom:10px;"></div>
        <table style="width:100%; border-collapse:collapse; font-size:12px;">
          <thead><tr>
            <th style="border:1px solid #16324F; padding:5px 6px; background:#EAF0F5; width:36px;">No</th>
            <th style="border:1px solid #16324F; padding:5px 6px; background:#EAF0F5;">Nama</th>
            <th style="border:1px solid #16324F; padding:5px 6px; background:#EAF0F5;">NIP</th>
            <th style="border:1px solid #16324F; padding:5px 6px; background:#EAF0F5;">Jabatan</th>
            <th style="border:1px solid #16324F; padding:5px 6px; background:#EAF0F5;">Jumlah Uang</th>
            <th style="border:1px solid #16324F; padding:5px 6px; background:#EAF0F5; width:130px;">Paraf</th>
          </tr></thead>
          <tbody>${rows}</tbody>
          <tfoot><tr>
            <td colspan="4" style="border:1px solid #16324F; padding:5px 6px; text-align:right; font-weight:700;">TOTAL</td>
            <td style="border:1px solid #16324F; padding:5px 6px; text-align:right; font-weight:700;">${fmtRupiah(total)}</td>
            <td style="border:1px solid #16324F; padding:5px 6px;"></td>
          </tr></tfoot>
        </table>

        <div style="page-break-inside:avoid;">
        <table style="width:100%; margin-top:30px; font-size:13px;"><tr>
          <td style="width:45%; text-align:center;">Bendahara,</td>
          <td style="width:10%;"></td>
          <td style="width:45%; text-align:center;">Mengetahui,<br>Kepala Sekolah,</td>
        </tr></table>
        <table style="width:100%; margin-top:80px; font-size:13px;"><tr>
          <td style="width:45%; text-align:center; padding-top:6px;"><b>${escapeHtml(bendahara.nama||'( ..................... )')}</b><br>NIP. ${escapeHtml(bendahara.nip||'-')}</td>
          <td style="width:10%;"></td>
          <td style="width:45%; text-align:center; padding-top:6px;"><b>${escapeHtml(kepsek.nama||'( ..................... )')}</b><br>NIP. ${escapeHtml(kepsek.nip||'-')}</td>
        </tr></table>
        </div>
      </div>`;
  }

  root.innerHTML = `<div style="padding:24px;">${kopHtml}${bodyHtml}</div>`;
}

