async function kirimNotifDemoKeSatuSekolah(npsn, pesan, kunciAkses){
  await db.ref('notifikasi/'+npsn).push({
    pesan,
    waktu: firebase.database.ServerValue.TIMESTAMP,
    dibaca: false,
    dari: (state.user && state.user.email) || 'admin_utama'
  });
  if(kunciAkses){
    // Menonaktifkan semua menu Admin Sekolah untuk npsn ini secara real-time
    // (lihat pengecekan aksesDikunci pada attachSchoolListeners > schoolCb).
    // Kepala Sekolah tidak terkena kunci ini.
    await db.ref('sekolah/'+npsn).update({
      aksesDikunci: true,
      aksesDikunciPesan: pesan,
      aksesDikunciOleh: (state.user && state.user.email) || 'admin_utama',
      aksesDikunciPada: Date.now()
    });
  }
}

document.getElementById('modal-notif-demo-kirim').addEventListener('click', async ()=>{
  const modal = document.getElementById('modal-notif-demo');
  const npsn = modal.dataset.npsn;
  const massalRaw = modal.dataset.massal;
  const npsnMassal = massalRaw ? JSON.parse(massalRaw) : null;
  const pesan = document.getElementById('modal-notif-demo-pesan').value.trim();
  if(!npsnMassal && !npsn){ showNotifDemoFeedback('NPSN sekolah tidak ditemukan.', false); return; }
  if(!pesan){ showNotifDemoFeedback('Pesan tidak boleh kosong.', false); return; }
  const kirimBtn = document.getElementById('modal-notif-demo-kirim');
  const kunciAkses = document.getElementById('chk-kunci-akses-notif').checked;

  // ---- Mode massal: kirim ke setiap NPSN satu per satu, catat gagal jika ada ----
  if(npsnMassal){
    if(!confirmFix(`Kirim notifikasi ini ke SEMUA ${npsnMassal.length} sekolah?` + (kunciAkses ? '\nAkses menu Admin Sekolah akan DIKUNCI untuk semua sekolah tersebut.' : ''))) return;
    kirimBtn.disabled = true;
    let sukses = 0;
    const gagal = [];
    for(const n of npsnMassal){
      showNotifDemoFeedback(`Mengirim notifikasi… (${sukses+gagal.length+1}/${npsnMassal.length})`, true);
      try{
        await kirimNotifDemoKeSatuSekolah(n, pesan, kunciAkses);
        sukses++;
      }catch(err){
        console.error('Gagal mengirim notifikasi massal ke', n, err);
        gagal.push(n);
      }
    }
    if(gagal.length){
      showNotifDemoFeedback(`Terkirim ke ${sukses} sekolah. Gagal untuk ${gagal.length} sekolah (NPSN: ${gagal.join(', ')}).`, false);
    }else{
      showNotifDemoFeedback(`Notifikasi berhasil dikirim ke seluruh ${sukses} sekolah.` + (kunciAkses ? ' Akses menu Admin Sekolah telah dikunci untuk semuanya.' : ''), true);
      setTimeout(()=>{ modal.classList.add('hidden'); }, 1200);
    }
    kirimBtn.disabled = false;
    return;
  }

  // ---- Mode satu sekolah (perilaku semula) ----
  kirimBtn.disabled = true;
  showNotifDemoFeedback('Mengirim notifikasi…', true);
  try{
    await kirimNotifDemoKeSatuSekolah(npsn, pesan, kunciAkses);
    showNotifDemoFeedback('Notifikasi berhasil dikirim ke Admin Sekolah.' + (kunciAkses ? ' Akses menu Admin Sekolah telah dikunci.' : ''), true);
    setTimeout(()=>{ modal.classList.add('hidden'); }, 900);
  }catch(err){
    // console.error tetap dipanggil supaya penyebab aslinya (mis. Firebase Rules
    // menolak izin tulis ke /notifikasi/{npsn}) terlihat jelas di DevTools.
    console.error('Gagal mengirim notifikasi ke', npsn, err);
    showNotifDemoFeedback('Gagal mengirim notifikasi: ' + (err.message || err.code || 'Terjadi kesalahan. Periksa koneksi internet Anda dan coba lagi.'), false);
  }finally{
    kirimBtn.disabled = false;
  }
});

/* =========================================================================
   ADMIN SEKOLAH / KEPALA SEKOLAH: DATA (scoped strictly to own npsn)
   ========================================================================= */
function attachSchoolListeners(npsn){
  const schoolRef = db.ref('sekolah/'+npsn);
  const txRef = db.ref('transaksi_bku/'+npsn);
  const bankRef = db.ref('buku_bank/'+npsn);
  const pajakRef = db.ref('buku_pajak/'+npsn);
  const opnameRef = db.ref('opname_kas/'+npsn);
  const rekonRef = db.ref('rekening_koran/'+npsn);
  const rkasRef = db.ref('rkas/'+npsn);
  const auditRef = db.ref('audit_trail/'+npsn).limitToLast(500);
  const persetujuanRef = db.ref('persetujuan/'+npsn);
  const notifRef = db.ref('notifikasi/'+npsn);

  const schoolCb = schoolRef.on('value', snap=>{
    state.schoolData = snap.val() || { npsn };
    // Sinkronkan tahap laporan aktif dari database (agar konsisten lintas sesi);
    // kalau belum pernah diset, tentukan default berdasarkan bulan berjalan.
    state.tahapAktif = state.schoolData.tahapAktif || getDefaultTahap();
    // Sinkronkan juga bagian Jenis Dana BOSP aktif (Reguler/Kinerja/Afirmasi) dari database.
    state.jenisDanaAktif = state.schoolData.jenisDanaAktif || getDefaultJenisDana();
    document.getElementById('sidebar-school-name').textContent = state.schoolData.namaSekolah || npsn;

    // Kunci akses (khusus role admin_sekolah): kalau Admin Utama mengunci sekolah ini
    // (mis. akun demo/trial berakhir & belum dibayar), tampilkan layar terkunci
    // menggantikan seluruh App Shell — bersifat real-time, langsung berlaku tanpa
    // perlu logout/login ulang. Kepala Sekolah TIDAK terkena kunci ini.
    if(state.userData.role === 'admin_sekolah'){
      const terkunci = state.schoolData.aksesDikunci === true;
      if(terkunci){
        document.getElementById('akses-terkunci-npsn').textContent = npsn;
        document.getElementById('akses-terkunci-nama').textContent = state.schoolData.namaSekolah || npsn;
        document.getElementById('akses-terkunci-pesan').textContent = state.schoolData.aksesDikunciPesan
          || 'Akses ke seluruh menu SIKEBOS untuk sekolah Anda saat ini dinonaktifkan sementara oleh Admin Utama.';
        showView('view-akses-terkunci');
        return; // jangan render halaman App Shell di bawah selama masih terkunci
      } else if(document.getElementById('view-akses-terkunci').classList.contains('active')){
        // Kunci baru saja dibuka sementara pengguna masih berada di layar terkunci —
        // kembalikan ke App Shell secara otomatis.
        showView('view-app');
        navigateTo('dashboard-sekolah');
      }
    }

    if(state.currentView==='dashboard-sekolah') renderDashboardSekolah();
    if(state.currentView==='rekon' && typeof renderRekon === 'function') renderRekon();
    if(state.currentView==='profil') fillProfilForm();
    if(state.currentView==='pejabat') fillPejabatForm();
    if(state.currentView==='pegawai') renderPegawai();
    if(state.currentView==='cetak') renderSemuaDaftarSK();
    if(!document.getElementById('lp-pegawai-panel').classList.contains('hidden')) renderPilihPegawaiList();
    refreshPanelPegawaiCetak();
    if(state.currentView==='bku') renderBKU();
    if(state.currentView==='backup') renderBackupInfo();
    if(state.currentView==='buku-pembantu') renderBukuPembantu();
  });

  const txCb = txRef.on('value', snap=>{
    const val = snap.val() || {};
    state.transactions = Object.entries(val)
      .map(([id, t])=>({id, ...t}))
      .sort((a,b)=> (a.tanggal||'').localeCompare(b.tanggal||'') || (a.createdAt||0)-(b.createdAt||0));
    recomputeSaldo();
    updateSppdNavVisibility();
    if(state.currentView==='bku') renderBKU();
    if(state.currentView==='dashboard-sekolah') renderDashboardSekolah();
    if(state.currentView==='cetak') renderCetakList();
    if(state.currentView==='sppd') renderSppd();
    if(state.currentView==='persetujuan') renderPersetujuan();
    if(state.currentView==='realisasi') renderRealisasi();
    if(state.currentView==='kk221') renderKk221Table();
  });

  const bankCb = bankRef.on('value', snap=>{
    const val = snap.val() || {};
    state.bukuBank = Object.entries(val)
      .map(([id, t])=>({id, ...t}))
      .sort((a,b)=> (a.tanggal||'').localeCompare(b.tanggal||'') || (a.createdAt||0)-(b.createdAt||0));
    let saldoBank = 0;
    state.bukuBank.forEach(t=>{
      if(t.jenis==='masuk') saldoBank += Number(t.jumlah)||0; else saldoBank -= Number(t.jumlah)||0;
      t._saldoBank = saldoBank;
    });
    if(state.currentView==='buku-pembantu') renderBukuPembantu();
  });

  const pajakCb = pajakRef.on('value', snap=>{
    const val = snap.val() || {};
    state.bukuPajak = Object.entries(val)
      .map(([id, t])=>({id, ...t}))
      .sort((a,b)=> (a.tanggal||'').localeCompare(b.tanggal||'') || (a.createdAt||0)-(b.createdAt||0));
    if(state.currentView==='buku-pembantu') renderBukuPembantu();
  });

  const opnameCb = opnameRef.on('value', snap=>{
    const val = snap.val() || {};
    state.opnameKas = Object.entries(val)
      .map(([id, t])=>({id, ...t}))
      .sort((a,b)=> (a.tanggal||'').localeCompare(b.tanggal||'') || (a.createdAt||0)-(b.createdAt||0));
    if(state.currentView==='buku-pembantu') renderBukuPembantu();
  });

  const rekonCb = rekonRef.on('value', snap=>{
    const val = snap.val() || {};
    state.rekeningKoran = Object.entries(val)
      .map(([id, t])=>({id, ...t}))
      .sort((a,b)=> (a.tanggal||'').localeCompare(b.tanggal||'') || (a.createdAt||0)-(b.createdAt||0));
    if(state.currentView==='buku-pembantu') renderBukuPembantu();
  });

  const rkasCb = rkasRef.on('value', snap=>{
    const val = snap.val() || {};
    state.rkas = Object.entries(val)
      .map(([id, t])=>({id, ...t}))
      .sort((a,b)=> (a.kodeKegiatan||'').localeCompare(b.kodeKegiatan||''));
    if(state.currentView==='buku-pembantu') renderBukuPembantu();
    if(state.currentView==='realisasi') renderRealisasi();
  });

  const auditCb = auditRef.on('value', snap=>{
    const val = snap.val() || {};
    state.auditTrail = Object.entries(val)
      .map(([id, t])=>({id, ...t}))
      .sort((a,b)=> (b.waktu||0)-(a.waktu||0)); // terbaru dulu
    if(state.currentView==='audit-trail') renderAuditTrail();
  });

  const persetujuanCb = persetujuanRef.on('value', snap=>{
    state.persetujuan = snap.val() || {};
    if(state.currentView==='persetujuan') renderPersetujuan();
    if(state.currentView==='dashboard-sekolah') renderDashboardSekolah();
  });

  const notifCb = notifRef.on('value', snap=>{
    state.notifikasiAkun = snap.val() || {};
    renderAkunNotifBanner();
  });

  state.listeners.push(
    [schoolRef,'value',schoolCb],[txRef,'value',txCb],
    [bankRef,'value',bankCb],[pajakRef,'value',pajakCb],[opnameRef,'value',opnameCb],
    [rekonRef,'value',rekonCb],[rkasRef,'value',rkasCb],[auditRef,'value',auditCb],
    [persetujuanRef,'value',persetujuanCb],[notifRef,'value',notifCb]
  );
}

/* ---- Banner notifikasi akun (mis. "akun demo selesai") untuk Admin Sekolah ----
   Menampilkan notifikasi belum dibaca yang paling lama dari /notifikasi/{npsn}.
   Setelah ditutup, notifikasi ditandai dibaca:true; jika masih ada notifikasi
   belum dibaca lainnya, banner otomatis menampilkan yang berikutnya. ---- */
function renderAkunNotifBanner(){
  const banner = document.getElementById('akun-notif-banner');
  const textEl = document.getElementById('akun-notif-banner-text');
  if(!state.userData || state.userData.role !== 'admin_sekolah'){
    banner.classList.add('hidden');
    banner.dataset.notifId = '';
    return;
  }
  const notifs = state.notifikasiAkun || {};
  const belumDibaca = Object.entries(notifs)
    .filter(([id,n])=>n && !n.dibaca)
    .sort((a,b)=>(a[1].waktu||0)-(b[1].waktu||0));

  if(!belumDibaca.length){
    banner.classList.add('hidden');
    banner.dataset.notifId = '';
    return;
  }
  const [id, n] = belumDibaca[0];
  banner.dataset.notifId = id;
  textEl.textContent = n.pesan || '';
  banner.classList.remove('hidden');
}

document.getElementById('akun-notif-banner-dismiss').addEventListener('click', async ()=>{
  const banner = document.getElementById('akun-notif-banner');
  const id = banner.dataset.notifId;
  const npsn = state.userData && state.userData.npsn;
  if(!id || !npsn){ banner.classList.add('hidden'); return; }
  try{
    await db.ref('notifikasi/'+npsn+'/'+id+'/dibaca').set(true);
  }catch(err){
    // Kalau gagal menandai (mis. offline), sembunyikan saja untuk sesi ini —
    // notifikasi akan muncul lagi saat data berhasil disinkronkan ulang.
    banner.classList.add('hidden');
  }
});

function detachAllListeners(){
  state.listeners.forEach(([ref,evt,cb])=>ref.off(evt,cb));
  state.listeners = [];
}

/* =========================================================================
   AUDIT TRAIL — mencatat riwayat aktivitas (tambah/ubah/hapus) di seluruh
   menu Admin Sekolah ke /audit_trail/{npsn}. Gagal mencatat (mis. offline)
   TIDAK membatalkan aksi utamanya — hanya dicatat sebagai peringatan di
   console, supaya pengguna tidak terhambat oleh kegagalan pencatatan log.
   ========================================================================= */
async function logAudit(entitas, aksi, keterangan){
  try{
    const npsn = state.userData && state.userData.npsn;
    if(!npsn) return;
    await db.ref('audit_trail/'+npsn).push({
      waktu: Date.now(),
      user: (state.user && state.user.email) || '-',
      peran: (state.userData && state.userData.role) || '-',
      entitas,
      aksi,
      keterangan: keterangan || ''
    });
  }catch(err){
    console.warn('Gagal mencatat Audit Trail:', err);
  }
}

