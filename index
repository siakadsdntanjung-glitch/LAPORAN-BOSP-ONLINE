const NAMA_BULAN_PENUH = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
function labelBulan(yyyyMm){
  const [y,m] = yyyyMm.split('-').map(Number);
  return `${NAMA_BULAN_PENUH[m-1]||''} ${y}`;
}

