      : `<span class="text-gold-600 bg-gold-50 text-xs font-semibold px-2 py-1 rounded">Menunggu</span>`;

  const rows = filtered.map(r=>`
    <tr class="border-b border-navy-50">
      <td class="py-3 px-4 font-mono">${escapeHtml(r.npsn)}</td>
      <td class="py-3 px-4">${btnNamaSekolah(r.npsn, r.namaSekolah)}</td>
