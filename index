function buildNav(role){
  const items = NAV[role] || [];
  const navHtml = items.map(it=>`
    <button data-nav="${it.id}" data-title="${it.title}" data-conditional="${!!it.conditional}"
      class="nav-btn w-full text-left px-5 py-2.5 text-sm font-medium border-l-4 border-transparent hover:bg-white/5 transition-colors${it.conditional ? ' hidden' : ''}">
      ${it.label}
    </button>`).join('');
  document.getElementById('sidebar-nav').innerHTML = navHtml;
  document.getElementById('mobile-nav-list').innerHTML = navHtml;

  document.querySelectorAll('.nav-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      navigateTo(btn.dataset.nav);
      document.getElementById('mobile-nav').classList.add('hidden');
    });
  });
  if(role === 'admin_sekolah') updateSppdNavVisibility();
}

