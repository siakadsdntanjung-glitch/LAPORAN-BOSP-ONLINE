  const roleLabels = { admin_utama:'Admin Utama', admin_sekolah:'Admin Sekolah', kepala_sekolah:'Kepala Sekolah' };
  document.getElementById('sidebar-role-label').textContent = roleLabels[userData.role] || userData.role;

