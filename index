function showView(id){
  // Set inline display directly (not just via the .active class) so this can
  // never lose out to another stylesheet's specificity/order, and never leave
  // two views visible at once no matter what caused the previous state.
  document.querySelectorAll('.view').forEach(v=>{
    const isTarget = v.id === id;
    v.classList.toggle('active', isTarget);
    v.style.display = isTarget ? '' : 'none';
  });
}

