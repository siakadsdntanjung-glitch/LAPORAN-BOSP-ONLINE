      </label>`;
    }).join('') || `<p class="p-3 text-[11px] text-navy-300">Tidak ada nama yang cocok.</p>`;
    wrap.querySelectorAll('.pg-cb').forEach(cb=>cb.addEventListener('change', ()=>{
      if(cb.checked) terpilih.add(cb.dataset.id); else terpilih.delete(cb.dataset.id);
    }));
  }
  _panelPegawaiCetak.push(render);
  el('btn').addEventListener('click', ()=>{
    const panel = el('panel');
    panel.classList.toggle('hidden');
    if(!panel.classList.contains('hidden')){
      terpilih.clear();
      el('cari').value = '';
      el('semua').checked = false;
      render();
    }
  });
  el('tutup').addEventListener('click', ()=>el('panel').classList.add('hidden'));
  el('cari').addEventListener('input', render);
  el('semua').addEventListener('change', (e)=>{
    el('list').querySelectorAll('.pg-cb:not(:disabled)').forEach(cb=>{
      cb.checked = e.target.checked;
      if(cb.checked) terpilih.add(cb.dataset.id); else terpilih.delete(cb.dataset.id);
    });
  });
  el('ok').addEventListener('click', ()=>{
    const pilih = getPegawaiList().filter(p=>terpilih.has(p.id));
    if(!pilih.length){ alertFix('Centang minimal satu nama pegawai.'); return; }
    // buang baris kosong bawaan agar tidak menyisakan baris bolong di antara nama
    if(!cfg.keepEmptyRows){
      document.querySelectorAll(cfg.rowsSel).forEach(r=>{
        if(!r.querySelector(cfg.namaSel).value.trim()) r.remove();
      });
    }
    pilih.forEach(p=>cfg.addRow({ nama:p.nama, nip:p.nip, jabatan:p.jabatan, tugas:p.tugas }));
    terpilih.clear();
    el('panel').classList.add('hidden');
  });
}
