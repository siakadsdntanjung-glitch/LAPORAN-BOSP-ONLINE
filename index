/* =========================================================================
   KEPALA SEKOLAH: LAPORAN REALISASI (read-only, per kegiatan)
   ========================================================================= */
function renderRealisasi(){
  const pengeluaran = state.transactions.filter(t=>t.jenis==='pengeluaran');

  const perKegiatan = hitungRealisasiPerKegiatan();
  const rkasByKode = {};
  (state.rkas||[]).forEach(r=>{ rkasByKode[r.kodeKegiatan] = r; });

  // Gabungkan semua kode yang muncul di RKAS maupun di realisasi, supaya
  // kegiatan yang sudah dianggarkan tapi belum ada realisasi tetap terlihat.
  const semuaKode = new Set([...Object.keys(perKegiatan), ...Object.keys(rkasByKode)]);

  let totalPagu = 0, totalRealisasi = 0;
  const daftar = Array.from(semuaKode).map(kode=>{
    const r = perKegiatan[kode] || { jumlahTransaksi:0, total:0 };
    const rkasItem = rkasByKode[kode];
    const pagu = rkasItem ? (Number(rkasItem.paguAnggaran)||0) : 0;
    totalPagu += pagu; totalRealisasi += r.total;
    return { kode, nama: rkasItem ? rkasItem.namaKegiatan : '', jumlahTransaksi: r.jumlahTransaksi, total: r.total, pagu };
  }).sort((a,b)=>b.total-a.total);

  const rows = daftar.map(d=>{
    const sisa = d.pagu - d.total;
    const persen = d.pagu>0 ? Math.round((d.total/d.pagu)*100) : 0;
    const warnaPersen = !d.pagu ? 'text-navy-300' : (persen>100 ? 'text-rust' : (persen>=90 ? 'text-gold-600' : 'text-forest'));
    return `<tr class="border-b border-navy-50">
      <td class="py-3 px-3 font-sans">${escapeHtml(d.kode)}</td>
      <td class="py-3 px-3 font-sans">${escapeHtml(d.nama||'—')}</td>
      <td class="py-3 px-3 text-right">${d.jumlahTransaksi}</td>
      <td class="py-3 px-3 text-right">${d.pagu ? fmtRupiah(d.pagu) : '—'}</td>
      <td class="py-3 px-3 text-right">${fmtRupiah(d.total)}</td>
      <td class="py-3 px-3 text-right ${sisa<0?'text-rust':''}">${d.pagu ? fmtRupiah(sisa) : '—'}</td>
      <td class="py-3 px-3 font-semibold ${warnaPersen}">${d.pagu ? persen+'%' : 'Belum ada RKAS'}</td>
    </tr>`;
  }).join('');
  document.getElementById('tbl-realisasi').innerHTML = rows || `<tr><td colspan="7" class="py-6 text-center text-navy-300 font-sans">Belum ada transaksi pengeluaran maupun Kegiatan RKAS.</td></tr>`;

  const totalSisa = totalPagu - totalRealisasi;
  const totalPersen = totalPagu>0 ? Math.round((totalRealisasi/totalPagu)*100) : 0;
  document.getElementById('realisasi-total-pagu').textContent = fmtRupiah(totalPagu);
  document.getElementById('realisasi-total-real').textContent = fmtRupiah(totalRealisasi);
  const sisaEl = document.getElementById('realisasi-total-sisa');
  sisaEl.textContent = fmtRupiah(totalSisa);
  sisaEl.classList.toggle('text-rust', totalSisa<0);
  sisaEl.classList.toggle('text-navy', totalSisa>=0);
  document.getElementById('realisasi-total-persen').textContent = totalPersen + '%';

  const detailRows = pengeluaran.map(t=>`
    <tr class="border-b border-navy-50">
      <td class="py-2 px-3 whitespace-nowrap">${formatTanggal(t.tanggal)}</td>
      <td class="py-2 px-3">${escapeHtml(t.kode||'')}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(t.uraian||'')}</td>
      <td class="py-2 px-3 font-sans">${escapeHtml(t.penerima||'')}</td>
      <td class="py-2 px-3 text-right">${fmtRupiah(t.jumlah)}</td>
    </tr>`).join('');
  document.getElementById('tbl-realisasi-detail').innerHTML = detailRows || `<tr><td colspan="5" class="py-6 text-center text-navy-300 font-sans">Belum ada transaksi pengeluaran.</td></tr>`;
}

